+#[cfg(test)]
+mod authored_memo_tests {
+    use super::*;
+
+    fn blank() -> DocumentCore {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        core
+    }
+
+    #[test]
+    fn authored_memos_keep_one_instant_and_distinct_wall_times() {
+        let mut core = blank();
+        core.insert_text_native(0, 0, 0, "body").unwrap();
+        let table: Value =
+            serde_json::from_str(&core.create_table_native(0, 0, 4, 1, 1).unwrap()).unwrap();
+        let para = table["paraIdx"].as_u64().unwrap() as usize;
+        let control = table["controlIdx"].as_u64().unwrap() as usize;
+        core.insert_text_in_cell_native(0, para, control, 0, 0, 0, "cell").unwrap();
+        let path = format!(r#"[{{"controlIndex":{control},"cellIndex":0,"cellParaIndex":0}}]"#);
+        core.insert_memo_by_path_json_native(
+            0, para, &path, 0, 4,
+            r#"{"author":"West","text":"nested","authoredAt":{"unixMs":123,"offsetMinutesEast":-210}}"#,
+        ).unwrap();
+        core.insert_memo_json_native(
+            0, 0, 0, 4,
+            r#"{"author":"East","text":"body","authoredAt":{"unixMs":123,"offsetMinutesEast":540}}"#,
+        ).unwrap();
+
+        let hwpx = DocumentCore::from_bytes(&core.export_hwpx_native().unwrap()).unwrap();
+        for doc in [&core, &hwpx] {
+            let memos: Vec<Value> = serde_json::from_str(&doc.get_memo_list_json()).unwrap();
+            assert_eq!(memos.len(), 2);
+            for (author, date) in [
+                ("West", "1969-12-31T20:30:00Z"),
+                ("East", "1970-01-01T09:00:00Z"),
+            ] {
+                let memo = memos.iter().find(|m| m["author"] == author).unwrap();
+                assert_eq!(memo["date"], date);
+            }
+        }
+        let hwp = DocumentCore::from_bytes(&core.export_hwp_native().unwrap()).unwrap();
+        let fields = hwp.collect_all_fields();
+        let commands: Vec<_> = fields.iter().map(|f| &f.field.command)
+            .filter(|c| c.starts_with("MEMO/")).collect();
+        assert_eq!(commands.len(), 2);
+        for command in commands {
+            let mut ticks = command.split('/').skip(3);
+            let low: u32 = ticks.next().unwrap().parse().unwrap();
+            let high: u32 = ticks.next().unwrap().parse().unwrap();
+            assert_eq!((u64::from(high) << 32) | u64::from(low), 116_444_736_001_230_000);
+        }
+    }
+
+    #[test]
+    fn malformed_authored_time_never_falls_back_to_now() {
+        let mut core = blank();
+        for clock in [
+            "null", "[]", "{}", r#"{"unixMs":0}"#,
+            r#"{"unixMs":-1,"offsetMinutesEast":0}"#,
+            r#"{"unixMs":253402214400000,"offsetMinutesEast":0}"#,
+            r#"{"unixMs":0.5,"offsetMinutesEast":0}"#,
+            r#"{"unixMs":0,"offsetMinutesEast":1440}"#,
+            r#"{"unixMs":0,"offsetMinutesEast":-1440}"#,
+            r#"{"unixMs":0,"offsetMinutesEast":"60"}"#,
+        ] {
+            let json = format!(r#"{{"authoredAt":{clock}}}"#);
+            let error = core.insert_memo_json_native(0, 0, 0, 0, &json).unwrap_err();
+            assert_eq!(error.code, MemoErrorCode::InsertFailed);
+        }
+        assert_eq!(core.get_memo_list_json(), "[]");
+        core.insert_memo_json_native(0, 0, 0, 0, r#"{"text":"unshared"}"#).unwrap();
+        let memos: Vec<Value> = serde_json::from_str(&core.get_memo_list_json()).unwrap();
+        assert_eq!(memos[0]["text"], "unshared");
+        assert!(memos[0]["date"].as_str().is_some());
+    }
+}
