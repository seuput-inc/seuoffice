+  auto* request = root_ftn()->navigation_request();
+  EXPECT_EQ(1, receipt->bindings);
+  EXPECT_EQ(request->GetNavigationId(), receipt->navigation_id);
+  EXPECT_NE(nullptr, request->GetNavigationUIData());
+  EXPECT_EQ("POST", request->GetRequestMethod());
+  ASSERT_TRUE(request->GetPostData());
+  EXPECT_EQ(731, request->GetPostData()->identifier());
+  ASSERT_EQ(1u, request->GetPostData()->elements()->size());
+  EXPECT_EQ(std::string_view(kPostBody, sizeof(kPostBody) - 1),
+            request->GetPostData()->elements()->front()
+                .As<network::DataElementBytes>().AsStringView());
+  EXPECT_EQ(ReloadType::BYPASSING_CACHE, request->GetReloadType());
+  auto reload = NavigationSimulator::CreateFromPending(controller_impl());
+  reload->Commit();
+  EXPECT_EQ((std::vector<Outcome>{Outcome::kStartedCrossDocument}),
+            receipt->outcomes);
+}
