+++ b/tests/cases/collab_fingerprint.rs
@@ -0,0 +1,158 @@
+//! Co-editing peers compare a digest of what the authors made, not of what this engine measured
+//! or cached, so two editors of the same edits agree and any authored difference shows.
+
+use std::sync::Arc;
+
+use rhwp::model::bin_data::{BinDataBytes, BinDataContent, BinDataResolver};
+use rhwp::model::control::{Control, Field, FormObject};
+use rhwp::model::document::{Document, Section};
+use rhwp::model::image::Picture;
+use rhwp::model::paragraph::{LineSeg, Paragraph};
+use rhwp::model::shape::ShapeObject;
+use rhwp::model::table::Table;
+
+fn document(control: Control) -> Document {
+    Document {
+        sections: vec![Section {
+            paragraphs: vec![Paragraph {
+                controls: vec![control],
+                ..Default::default()
+            }],
+            ..Default::default()
+        }],
+        ..Default::default()
+    }
+}
+
+fn printed(doc: &Document) -> String {
+    doc.collab_fingerprint().unwrap()
+}
+
+fn table(doc: &mut Document) -> &mut Table {
+    let Control::Table(t) = &mut doc.sections[0].paragraphs[0].controls[0] else {
+        panic!()
+    };
+    t
+}
+
+#[test]
+fn collab_fingerprint_ignores_local_measurement_but_distinguishes_both_height_owners() {
+    let mut t = Table {
+        raw_ctrl_data: vec![0; 24],
+        ..Default::default()
+    };
+    // The file stores 1250 in the raw record while the model's height is 1200.
+    t.set_authored_height(1250);
+    t.common.height = 1200;
+    let mut doc = document(Control::Table(Box::new(t)));
+    let before = printed(&doc);
+    for measured in [3000, 4000, 1200] {
+        table(&mut doc).project_layout_height(measured);
+        doc.sections[0].paragraphs[0].line_segs.push(LineSeg {
+            vertical_pos: measured as i32,
+            ..Default::default()
+        });
+        doc.doc_properties.caret_char_pos += 1;
+        doc.sections[0].raw_stream = Some(vec![measured as u8]);
+        assert_eq!(printed(&doc), before);
+    }
+    let mut other = doc.clone();
+    table(&mut other).set_authored_height(1200);
+    assert_ne!(printed(&other), before, "the original raw height was not 1200");
+    table(&mut doc).set_authored_height(1900);
+    assert_ne!(printed(&doc), printed(&other));
+    let width = printed(&doc);
+    table(&mut doc).common.width += 1;
+    assert_ne!(printed(&doc), width);
+}
+
+#[test]
+fn collab_fingerprint_sees_nested_skipped_bytes_and_xml_and_typed_parameters() {
+    fn field(d: &mut Document) -> &mut Field {
+        let Control::Field(f) = &mut d.sections[0].paragraphs[0].controls[0] else {
+            panic!()
+        };
+        f
+    }
+    let mut picture = Picture::default();
+    picture.shape_attr.ctrl_data = Some(vec![0xab]);
+    let mut nested = Paragraph::default();
+    nested
+        .controls
+        .push(Control::Shape(Box::new(ShapeObject::Picture(Box::new(picture)))));
+    let mut doc = document(Control::Field(Field {
+        memo_paragraphs: vec![nested],
+        raw_parameters_xml: Some("<hp:parameters/>".into()),
+        ..Default::default()
+    }));
+    let a = printed(&doc);
+    let f = field(&mut doc);
+    let Control::Shape(s) = &mut f.memo_paragraphs[0].controls[0] else {
+        panic!()
+    };
+    let ShapeObject::Picture(p) = &mut **s else {
+        panic!()
+    };
+    p.shape_attr.ctrl_data.as_mut().unwrap()[0] ^= 1;
+    let b = printed(&doc);
+    assert_ne!(a, b);
+    field(&mut doc).raw_parameters_xml = Some("<hp:parameters foo='x'/>".into());
+    let c = printed(&doc);
+    assert_ne!(b, c);
+    field(&mut doc).parameters.name = Some("named".into());
+    assert_ne!(c, printed(&doc), "raw XML must not shadow the editable parameter tree");
+}
+
+#[test]
+fn collab_fingerprint_hashes_resource_contents_not_map_order_or_resolver_identity() {
+    fn sample(reverse: bool) -> Document {
+        let mut f = FormObject::default();
+        let mut keys = ["alpha", "beta"];
+        if reverse {
+            keys.reverse();
+        }
+        for k in keys {
+            f.properties.insert(k.into(), k.into());
+        }
+        let mut d = document(Control::Form(Box::new(f)));
+        for k in keys {
+            d.extra_streams.push((k.into(), k.as_bytes().to_vec()));
+        }
+        d.bin_data_content.push(BinDataContent {
+            id: 1,
+            extension: "png".into(),
+            data: if reverse {
+                BinDataBytes::from_shared(vec![1, 2, 3])
+            } else {
+                vec![1, 2, 3].into()
+            },
+        });
+        d
+    }
+    let mut d = sample(false);
+    let original = printed(&d);
+    assert_eq!(original, printed(&sample(true)));
+    d.bin_data_content[0].data = vec![3, 2, 1].into();
+    assert_ne!(original, printed(&d));
+}
+
+#[test]
+fn collab_fingerprint_denies_unreadable_binary_instead_of_hashing_an_empty_placeholder() {
+    #[derive(Debug)]
+    struct Unreadable;
+    impl BinDataResolver for Unreadable {
+        fn resolve(&self, _: &str) -> Vec<u8> {
+            panic!("unbounded materialization")
+        }
+    }
+    let mut doc = Document::default();
+    doc.bin_data_content.push(BinDataContent {
+        id: 1,
+        extension: "ole".into(),
+        data: BinDataBytes::Lazy {
+            resolver: Arc::new(Unreadable),
+            key: "object".into(),
+        },
+    });
+    assert!(doc.collab_fingerprint().is_err());
+}
