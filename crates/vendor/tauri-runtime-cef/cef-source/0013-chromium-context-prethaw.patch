+bool RenderFrameHostImpl::MatchesApprovedBackForwardRestoreForCef(
+    const blink::DocumentToken& document_token) const {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (GetParent() || IsPendingDeletion() || !IsRenderFrameLive() ||
+      !frame_tree_node() || GetDocumentToken() != document_token ||
+      !frame_tree_node()->MatchesCefReadyDocument(GetGlobalFrameToken(), document_token)) {
+    return false;
+  }
+  const auto matches = [&](const NavigationRequest& request) {
+    return request.IsServedFromBackForwardCache() &&
+           request.state() == NavigationRequest::READY_TO_COMMIT &&
+           request.GetRenderFrameHost() == this &&
+           frame_tree_node()->IsLatestNavigationForCef(request.GetNavigationId());
+  };
+  if (const auto* request = frame_tree_node()->navigation_request()) return matches(*request);
+  if (navigation_requests_.size() != 1) return false;
+  return matches(*navigation_requests_.begin()->second);
+}
