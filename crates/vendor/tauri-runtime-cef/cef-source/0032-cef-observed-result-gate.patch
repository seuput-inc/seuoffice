   bool ObserveLoss
diff --git a/libcef/browser/native_observed_document.h b/libcef/browser/native_observed_document.h
--- a/libcef/browser/native_observed_document.h
+++ b/libcef/browser/native_observed_document.h
@@ -1,2 +1,21 @@
 };
+
+class CefNativeObservedResultImpl final : public CefNativeObservedResult {
+ public:
+  explicit CefNativeObservedResultImpl(CefRefPtr<CefNativeObservedDocumentImpl> document)
+      : document_(std::move(document)) {}
+  bool TryAccept() override {
+    bool expected = false;
+    if (!attempted_.compare_exchange_strong(expected, true)) return false;
+    return document_->ClaimResult();
+  }
+ private:
+  CefRefPtr<CefNativeObservedDocumentImpl> document_;
+  std::atomic<bool> attempted_{false};
+  IMPLEMENT_REFCOUNTING(CefNativeObservedResultImpl);
+};
+
+inline CefRefPtr<CefNativeObservedResult> CefNativeObservedDocumentImpl::CreateResultGate() {
+  return new CefNativeObservedResultImpl(this);
+}
