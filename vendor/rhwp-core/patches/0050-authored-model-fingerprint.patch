+//! The live editing model, not the editor's measured lines or its source-stream caches.
+//! The session admits original file bytes separately. Never substitute them for live state.
+
+use super::digest_encoding::DigestWriter;
+use crate::model::{
+    bin_data::{BinDataBytes, BinDataContent, MAX_BIN_DATA_BYTES},
+    control::{CharOverlap, Control, Field, HiddenComment, UnknownControl},
+    document::{DocInfo, DocProperties, Document, FileHeader, HwpVersion, Preview, PreviewImage,
+        RawRecord, Section, SectionDef},
+    footnote::{Endnote, Footnote},
+    header_footer::{Footer, Header, MasterPage},
+    image::Picture,
+    page::PageDef,
+    paragraph::{Paragraph, UnknownRecord},
+    provenance::SourceProvenance,
+    section_tail::SectionTail,
+    shape::*,
+    style::{Bullet, Font},
+    table::{Cell, Table},
+};
+use serde::{Serialize, Serializer};
+
+impl DigestWriter {
+    fn value(&mut self, value: &(impl Serialize + ?Sized)) {
+        value.serialize(self).expect("typed model field has an infallible binary encoding");
+    }
+
+    fn blob(&mut self, bytes: &[u8]) {
+        self.serialize_bytes(bytes).expect("byte slice encoding is infallible");
+    }
+}
+
+trait Authored {
+    fn authored(&self, out: &mut DigestWriter);
+}
+
+impl<T: Authored> Authored for Vec<T> {
+    fn authored(&self, out: &mut DigestWriter) {
+        out.value(&(self.len() as u64));
+        for item in self { item.authored(out); }
+    }
+}
+
+impl<T: Authored> Authored for Option<T> {
+    fn authored(&self, out: &mut DigestWriter) {
+        out.value(&self.is_some());
+        if let Some(item) = self { item.authored(out); }
+    }
+}
+
+// Exhaustive destructuring forces new fields on these owners to be classified.
+macro_rules! record {
+    ($name:ident { $($value:ident),* } $(bytes { $($bytes:ident),* })?
+        $(nested { $($nested:ident),* })? $(omit { $($omit:ident),* })?
+        $(via $func:ident { $($more:ident),* })?) => {
+        impl Authored for $name {
+            fn authored(&self, out: &mut DigestWriter) {
+                let Self { $($value,)* $($($bytes,)*)? $($($nested,)*)?
+                    $($($omit: _,)*)? $($($more,)*)? } = self;
+                $(out.value($value);)*
+                $($(out.blob($bytes);)*)?
+                $($($nested.authored(out);)*)?
+                $($func(out, self, $($more),*);)?
+            }
+        }
+    };
+}
+
+// Enum tags and sequence lengths frame nested values independently of their contents.
+macro_rules! variants {
+    ($name:ident { $($leaf:ident),* } nested { $($child:ident),* }) => {
+        impl Authored for $name {
+            fn authored(&self, out: &mut DigestWriter) {
+                match self {
+                    $(Self::$leaf(v) => { out.value(stringify!($leaf)); out.value(v); },)*
+                    $(Self::$child(v) => { out.value(stringify!($child)); v.authored(out); },)*
+                }
+            }
+        }
+    };
+}
