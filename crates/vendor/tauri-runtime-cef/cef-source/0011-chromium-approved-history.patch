+  const GURL last("https://approved.example/last");
+  NavigationSimulator::NavigateAndCommitFromBrowser(contents(), first);
+  NavigationSimulator::NavigateAndCommitFromBrowser(contents(), middle);
+  NavigationSimulator::NavigateAndCommitFromBrowser(contents(), last);
+  controller_impl().GetEntryAtIndex(1)->set_should_skip_on_back_forward_ui(true);
+  auto backwards = std::make_shared<Receipt>();
+  controller_impl().GoBackWithCefHistoryCommand(Command(backwards));
+  ASSERT_TRUE(controller_impl().GetPendingEntry());
+  EXPECT_EQ(first, controller_impl().GetPendingEntry()->GetURL());
+  NavigationSimulator::CreateFromPending(controller_impl())->Commit();
+  controller_impl().GetEntryAtIndex(1)->set_should_skip_on_back_forward_ui(true);
+  auto forwards = std::make_shared<Receipt>();
+  controller_impl().GoForwardWithCefHistoryCommand(Command(forwards));
+  ASSERT_TRUE(controller_impl().GetPendingEntry());
+  EXPECT_EQ(last, controller_impl().GetPendingEntry()->GetURL());
+  NavigationSimulator::CreateFromPending(controller_impl())->Commit();
+  EXPECT_EQ((std::vector<Outcome>{Outcome::kStartedCrossDocument}),
+            backwards->outcomes);
+  EXPECT_EQ(backwards->outcomes, forwards->outcomes);
+}
