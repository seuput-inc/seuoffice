+TEST_F(RenderFrameHostImplTest, CefPopupScopeRestoresNestedRequest) {
+  auto outer = mojom::CreateNewWindowParams::New();
+  outer->cef_opener_document_token = blink::DocumentToken();
+  outer->cef_opener_context_token = blink::V8ContextToken();
+  auto inner = mojom::CreateNewWindowParams::New();
+  inner->cef_opener_document_token = blink::DocumentToken();
+  inner->cef_opener_context_token = blink::V8ContextToken();
+  auto* host = main_test_rfh();
+  EXPECT_EQ(nullptr, host->GetScopedCreateNewWindowParamsForCef());
+  {
+    RenderFrameHostImpl::ScopedCefPopupParams outer_scope(*host, *outer);
+    EXPECT_EQ(outer.get(), host->GetScopedCreateNewWindowParamsForCef());
+    {
+      RenderFrameHostImpl::ScopedCefPopupParams inner_scope(*host, *inner);
+      EXPECT_EQ(inner.get(), host->GetScopedCreateNewWindowParamsForCef());
+      EXPECT_NE(outer->cef_opener_context_token, inner->cef_opener_context_token);
+    }
+    EXPECT_EQ(outer.get(), host->GetScopedCreateNewWindowParamsForCef());
+    EXPECT_EQ(outer->cef_opener_document_token,
+              host->GetScopedCreateNewWindowParamsForCef()->cef_opener_document_token);
+  }
+  EXPECT_EQ(nullptr, host->GetScopedCreateNewWindowParamsForCef());
+}
+
+TEST_F(RenderFrameHostImplTest, CefPopupScopeRejectsForeignFrame) {
+  auto* host = main_test_rfh();
+  auto* child = static_cast<RenderFrameHostImpl*>(
+      RenderFrameHostTester::For(host)->AppendChild("foreign"));
+  auto request = mojom::CreateNewWindowParams::New();
+  RenderFrameHostImpl::ScopedCefPopupParams scope(*host, *request);
+  EXPECT_EQ(request.get(), host->GetScopedCreateNewWindowParamsForCef());
+  EXPECT_EQ(nullptr, child->GetScopedCreateNewWindowParamsForCef());
+}
+
+TEST_F(RenderFrameHostImplTest, CefPopupScopeClearsOnEarlyFailure) {
+  auto* host = main_test_rfh();
+  auto request = mojom::CreateNewWindowParams::New();
+  const auto rejected = [&] {
+    RenderFrameHostImpl::ScopedCefPopupParams scope(*host, *request);
+    return false;
+  };
+  EXPECT_FALSE(rejected());
+  EXPECT_EQ(nullptr, host->GetScopedCreateNewWindowParamsForCef());
+  // A later request cannot inherit even an empty prior popup payload.
+  auto next = mojom::CreateNewWindowParams::New();
+  {
+    RenderFrameHostImpl::ScopedCefPopupParams scope(*host, *next);
+    EXPECT_EQ(next.get(), host->GetScopedCreateNewWindowParamsForCef());
+  }
+  EXPECT_EQ(nullptr, host->GetScopedCreateNewWindowParamsForCef());
+}
