diff --git a/libcef/browser/approved_navigation.h b/libcef/browser/approved_navigation.h
--- /dev/null
+++ b/libcef/browser/approved_navigation.h
@@ -0,0 +1,163 @@
+// Private browser-process-only navigation provenance for the CEF host.
+#ifndef CEF_LIBCEF_BROWSER_APPROVED_NAVIGATION_H_
+#define CEF_LIBCEF_BROWSER_APPROVED_NAVIGATION_H_
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/supports_user_data.h"
+#include "base/synchronization/lock.h"
+#include "cef/libcef/browser/thread_util.h"
+#include "content/browser/renderer_host/frame_tree_node.h"
+#include "content/browser/renderer_host/render_frame_host_impl.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/navigation_ui_data.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+
+class CefApprovedNavigation final : public base::SupportsUserData::Data,
+                                    public content::WebContentsObserver {
+ public:
+  static CefApprovedNavigation* GetOrCreate(content::WebContents* contents) {
+    auto* result = Get(contents);
+    if (!result) {
+      auto instance = std::make_unique<CefApprovedNavigation>(contents);
+      result = instance.get();
+      contents->SetUserData(Key(), std::move(instance));
+    }
+    return result;
+  }
+
+  static CefApprovedNavigation* Get(content::WebContents* contents) {
+    return static_cast<CefApprovedNavigation*>(contents->GetUserData(Key()));
+  }
+
+  explicit CefApprovedNavigation(content::WebContents* contents)
+      : content::WebContentsObserver(contents), state_(std::make_shared<State>()) {}
+
+  bool Reserve(uint64_t issuance, const std::string& intent) {
+    CEF_REQUIRE_UIT_RETURN(false);
+    if (intent.empty() || !web_contents() || issuance <= state_->last_issued) return false;
+    auto* node = content::FrameTreeNode::From(web_contents()->GetPrimaryMainFrame());
+    if (!node) return false;
+    auto cef_revoke = node->RevokeCefAdmission();
+    state_->navigation_id.reset();
+    state_->intent = intent;
+    state_->last_issued = issuance;
+    state_->started = false;
+    return true;
+  }
+
+  bool Load(const GURL& url, uint64_t issuance, const std::string& intent) {
+    CEF_REQUIRE_UIT_RETURN(false);
+    if (!web_contents() || state_->last_issued != issuance ||
+        state_->intent != intent || state_->started) return false;
+    auto state = state_;
+    content::NavigationController::LoadURLParams params(url);
+    params.transition_type = static_cast<ui::PageTransition>(
+        ui::PAGE_TRANSITION_TYPED | ui::PAGE_TRANSITION_FROM_API);
+    params.navigation_ui_data = std::make_unique<NavigationData>(state, issuance, intent);
+    auto handle = web_contents()->GetController().LoadURLWithParams(params);
+    if (!handle) {
+      if (state->last_issued == issuance) state->started = true;
+      if (state->last_issued == issuance && state->intent == intent) {
+        state->navigation_id.reset();
+        state->intent.clear();
+      }
+      return false;
+    }
+    return state->last_issued == issuance && state->intent == intent &&
+           (!state->navigation_id || *state->navigation_id == handle->GetNavigationId());
+  }
+
+  std::optional<std::pair<uint64_t, std::string>> Consume(
+      content::RenderFrameHostImpl* host, const blink::DocumentToken& document) {
+    CEF_REQUIRE_UIT_RETURN(std::nullopt);
+    if (state_->redeemed || !state_->navigation_id || state_->intent.empty() || !host ||
+        host->GetParent() || !host->MatchesLatestDocumentForCef(document) ||
+        !host->frame_tree_node() ||
+        !host->frame_tree_node()->IsLatestNavigationForCef(
+            *state_->navigation_id)) {
+      return std::nullopt;
+    }
+    state_->redeemed = true;
+    return std::make_pair(state_->last_issued, state_->intent);
+  }
+
+  void DidStartNavigation(content::NavigationHandle* navigation) override {
+    if (!navigation->IsInPrimaryMainFrame() || navigation->IsSameDocument())
+      return;
+    state_->navigation_id.reset();
+    state_->redeemed = false;
+    state_->intent.clear();
+    std::optional<std::pair<uint64_t, std::string>> identity;
+    {
+      base::AutoLock lock(state_->data_lock);
+      const auto it = state_->data.find(navigation->GetNavigationUIData());
+      if (it != state_->data.end()) identity = it->second;
+    }
+    if (!identity || identity->first != state_->last_issued ||
+        navigation->IsRendererInitiated() ||
+        navigation->IsPrerenderedPageActivation() || state_->started) return;
+    state_->started = true;
+    state_->navigation_id = navigation->GetNavigationId();
+    state_->intent = identity->second;
+  }
+
+  void DidFinishNavigation(content::NavigationHandle* navigation) override {
+    if (state_->navigation_id &&
+        *state_->navigation_id == navigation->GetNavigationId() &&
+        (!navigation->HasCommitted() || navigation->IsErrorPage())) {
+      state_->navigation_id.reset();
+      state_->intent.clear();
+    }
+  }
+
+  void WebContentsDestroyed() override {
+    state_->navigation_id.reset();
+    state_->intent.clear();
+  }
+
+ private:
+  struct State {
+    base::Lock data_lock;
+    std::map<const content::NavigationUIData*, std::pair<uint64_t, std::string>> data;
+    uint64_t last_issued = 0;
+    std::optional<int64_t> navigation_id;
+    bool redeemed = false;
+    bool started = false;
+    std::string intent;
+  };
+
+  class NavigationData final : public content::NavigationUIData {
+   public:
+    NavigationData(std::shared_ptr<State> state, uint64_t issuance, std::string intent)
+        : state_(std::move(state)), issuance_(issuance), intent_(std::move(intent)) {
+      base::AutoLock lock(state_->data_lock);
+      state_->data.emplace(this, std::make_pair(issuance_, intent_));
+    }
+    ~NavigationData() override {
+      base::AutoLock lock(state_->data_lock);
+      state_->data.erase(this);
+    }
+    std::unique_ptr<content::NavigationUIData> Clone() override {
+      return std::make_unique<NavigationData>(state_, issuance_, intent_);
+    }
+   private:
+    std::shared_ptr<State> state_;
+    uint64_t issuance_;
+    std::string intent_;
+  };
+
+  static const void* Key() {
+    static int key;
+    return &key;
+  }
+  std::shared_ptr<State> state_;
+};
+
+#endif  // CEF_LIBCEF_BROWSER_APPROVED_NAVIGATION_H_
