+    CefHistoryCommand(
+        std::unique_ptr<NavigationUIData> data,
+        base::RepeatingCallback<bool()> is_current,
+        base::OnceCallback<bool(int64_t)> bind_request,
+        base::OnceCallback<void(CefHistoryOutcome)> completion)
+        : data_(std::move(data)),
+          is_current_(std::move(is_current)),
+          bind_request_(std::move(bind_request)),
+          completion_(std::move(completion)) {}
+    CefHistoryCommand(const CefHistoryCommand&) = delete;
+    CefHistoryCommand& operator=(const CefHistoryCommand&) = delete;
+    ~CefHistoryCommand() { Finish(CefHistoryOutcome::kCancelled); }
+
+    bool IsCurrent() const {
+      DCHECK_CURRENTLY_ON(BrowserThread::UI);
+      return is_current_ && is_current_.Run();
+    }
+    bool BindToRequest(int64_t navigation_id) {
+      DCHECK_CURRENTLY_ON(BrowserThread::UI);
+      return IsCurrent() && bind_request_ &&
+             std::move(bind_request_).Run(navigation_id);
+    }
+    std::unique_ptr<NavigationUIData> TakeData() {
+      DCHECK_CURRENTLY_ON(BrowserThread::UI);
+      return std::move(data_);
+    }
+    void Finish(CefHistoryOutcome outcome) {
+      DCHECK_CURRENTLY_ON(BrowserThread::UI);
+      auto completion = std::move(completion_);
+      if (completion) {
+        std::move(completion).Run(outcome);
+      }
+    }
+
+   private:
