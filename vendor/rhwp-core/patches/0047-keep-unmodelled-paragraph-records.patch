+//! HWPX markup in a paragraph that belongs to no namespace the HWPX writer declares
+//! (another tool's extension): kept verbatim in [`ForeignXml`] so a save writes it back.
+//!
+//! An element is foreign when its name resolves, in the namespace scope where it stands, to a
+//! namespace outside the writer's section template. The scope holds the section root's
+//! declarations and those of every `<hp:p>` and element the paragraph parser has read into,
+//! enclosing paragraphs (of a table cell or a text box) included, and the default namespace.
+//! The whole element is taken, so text in it never becomes paragraph text. A foreign element
+//! holding a name whose prefix does not resolve, or that names a writer namespace under
+//! another prefix, cannot be written verbatim into a document that declares only the
+//! template's prefixes: it is read past and dropped, as the canonical-prefix rule for copied
+//! spans does.
+
+use std::cell::RefCell;
+use std::sync::LazyLock;
+
+use quick_xml::events::{BytesStart, Event};
+use quick_xml::Reader;
+
+use super::HwpxError;
+use crate::model::paragraph::{ForeignXml, Paragraph};
+
+thread_local! {
+    /// Namespace bindings in scope at the parser's position, outermost first; `""` is the
+    /// default namespace.
+    static SCOPE: RefCell<Vec<(String, String)>> = const { RefCell::new(Vec::new()) };
+}
+
+/// Adds bindings to the scope and returns its length before them.
+fn push(bindings: Vec<(String, String)>) -> usize {
+    SCOPE.with(|scope| {
+        let mut scope = scope.borrow_mut();
+        let len = scope.len();
+        scope.extend(bindings);
+        len
+    })
+}
+
+fn truncate(len: usize) {
+    SCOPE.with(|scope| scope.borrow_mut().truncate(len));
+}
+
+/// The section root's namespace declarations while that section is parsed.
+pub(super) struct RootNamespacesScope(usize);
+
+impl RootNamespacesScope {
+    pub(super) fn enter(xml: &str) -> Self {
+        Self(push(super::utils::root_namespaces(xml)))
+    }
+}
+
+impl Drop for RootNamespacesScope {
+    fn drop(&mut self) {
+        truncate(self.0);
+    }
+}
+
+/// `(prefix, uri)` pairs every written section declares on its root.
+static WRITTEN: LazyLock<Vec<(String, String)>> = LazyLock::new(|| {
+    super::utils::root_namespaces(crate::serializer::hwpx::section::EMPTY_SECTION_XML)
+});
+
+fn written() -> &'static [(String, String)] {
+    &WRITTEN
+}
+
+fn is_written_uri(uri: &str) -> bool {
+    written().iter().any(|(_, u)| u == uri)
+}
+
+enum Name {
+    /// No namespace, or a namespace the writer declares under the same prefix.
+    Written,
+    Foreign(String, String),
+    /// Cannot be written verbatim.
+    Unwritable,
+}
+
+fn prefix(qname: &str) -> Option<&str> {
+    qname.split_once(':').map(|(prefix, _)| prefix)
+}
+
+/// Hands `f` the namespace `prefix` (`""`: the default namespace) is bound to in `local`
+/// (innermost last) or else in the scope.
+fn resolve<R>(prefix: &str, local: &[(String, String)], f: impl FnOnce(Option<&str>) -> R) -> R {
+    if let Some((_, uri)) = local.iter().rev().find(|(p, _)| p == prefix) {
+        return f(Some(uri.as_str()));
+    }
+    SCOPE.with(|scope| {
+        let scope = scope.borrow();
+        f(scope
+            .iter()
+            .rev()
+            .find(|(p, _)| p == prefix)
+            .map(|(_, uri)| uri.as_str()))
+    })
+}
+
+/// Classifies an element name (`element`) or an attribute name. An unprefixed element is in
+/// the default namespace in scope; an unprefixed attribute is in none.
+fn classify(qname: &str, local: &[(String, String)], element: bool) -> Name {
+    let prefix = match prefix(qname) {
+        Some(prefix) => prefix,
+        None if element => "",
+        None => return Name::Written,
+    };
+    resolve(prefix, local, |uri| match uri {
+        None if prefix.is_empty() => Name::Written,
+        None => Name::Unwritable,
+        // the writer declares no default namespace; an unprefixed OWPML element is read by
+        // its local name as before
+        Some(uri) if prefix.is_empty() => {
+            if uri.is_empty() || is_written_uri(uri) {
+                Name::Written
+            } else {
+                Name::Foreign(String::new(), uri.to_string())
+            }
+        }
+        Some(uri) if written().iter().any(|(p, u)| p == prefix && u == uri) => Name::Written,
+        Some(uri) if is_written_uri(uri) => Name::Unwritable,
+        Some(uri) => Name::Foreign(prefix.to_string(), uri.to_string()),
+    })
+}
+
+/// Namespace declarations made on the element itself; `""` is the default namespace.
+pub(super) fn declarations(e: &BytesStart) -> Vec<(String, String)> {
+    let open: &str = e;
+    if !open.contains("xmlns") {
+        return Vec::new();
+    }
+    e.attributes()
+        .flatten()
+        .filter_map(|a| {
+            let key: &str = a.key.as_ref();
+            let prefix = if key == "xmlns" {
+                ""
+            } else {
+                key.strip_prefix("xmlns:")?
+            };
+            Some((prefix.to_string(), a.value.to_string()))
+        })
+        .collect()
+}
+
+/// One paragraph's part of the scope: the declarations of its `<hp:p>` and of the elements
+/// the paragraph parser reads into (`<hp:run>`, wrappers it does not model) and has not left.
+pub(super) struct Scope {
+    base: usize,
+    /// element name and the scope's length before its own declarations
+    frames: Vec<(String, usize)>,
+}
+
+impl Scope {
+    pub(super) fn new(p: &BytesStart) -> Self {
+        Self {
+            base: push(declarations(p)),
+            frames: Vec::new(),
+        }
+    }
+
+    /// The parser reads into `e`.
+    pub(super) fn enter(&mut self, e: &BytesStart) {
+        let own = declarations(e);
+        if own.is_empty() {
+            return;
+        }
+        let name = e.name();
+        let name: &str = name.as_ref();
+        let len = push(own);
+        self.frames.push((name.to_string(), len));
+    }
+
+    /// The parser read the end of the element named `name`.
+    pub(super) fn leave(&mut self, name: &str) {
+        if let Some(i) = self.frames.iter().rposition(|(n, _)| n == name) {
+            truncate(self.frames[i].1);
+            self.frames.truncate(i);
+        }
+    }
+}
+
+impl Drop for Scope {
+    fn drop(&mut self) {
+        truncate(self.base);
+    }
+}
+
+/// Whether the paragraph parser must hand this element to [`take_element`] instead of
+/// reading into it: its namespace is one the writer does not declare. An OWPML element under
+/// another prefix, or one whose prefix resolves nowhere, stays with the paragraph parser,
+/// which reads by local name.
+pub(super) fn is_foreign(e: &BytesStart) -> bool {
+    matches!(
+        classify(e.name().as_ref(), &declarations(e), true),
+        Name::Foreign(..)
+    )
+}
+
+/// Reads the foreign element whose start (`empty`: the whole element) was just read and
+/// keeps it in the paragraph, under `<hp:run>` when `in_run`.
+pub(super) fn take_element(
+    e: &BytesStart,
+    empty: bool,
+    in_run: bool,
+    reader: &mut Reader<&[u8]>,
+    para: &mut Paragraph,
+) -> Result<(), HwpxError> {
+    let open: &str = e;
+    let xml = if empty {
+        format!("<{open}/>")
+    } else {
+        let inner = reader
+            .read_text(e.name())
+            .map_err(|err| HwpxError::XmlError(format!("paragraph: {err}")))?;
+        let name = e.name();
+        let name: &str = name.as_ref();
+        format!("<{open}>{}</{name}>", &*inner)
+    };
+    let Some(needed) = namespaces_needed(&xml) else {
+        return Ok(());
+    };
+    // The element declares what it borrows from the scope it stood in itself, so markup
+    // taken from paragraphs that bind one prefix differently never shares a scope.
+    let name_end = 1 + e.name().as_ref().len();
+    let borrowed: String = needed
+        .iter()
+        .map(|(prefix, uri)| match prefix.as_str() {
+            "" => format!(r#" xmlns="{uri}""#),
+            prefix => format!(r#" xmlns:{prefix}="{uri}""#),
+        })
+        .collect();
+    let xml = format!("{}{borrowed}{}", &xml[..name_end], &xml[name_end..]);
+    let foreign = para.foreign_xml.get_or_insert_with(Default::default);
+    if in_run {
+        foreign.run_children.push(xml);
+    } else {
+        foreign.p_children.push(xml);
+    }
+    Ok(())
+}
+
+/// The declarations a kept element needs from the scope it stood in, or `None` when some
+/// name in it cannot be written verbatim.
+fn namespaces_needed(xml: &str) -> Option<Vec<(String, String)>> {
+    let mut reader = Reader::from_str(xml);
+    // declarations of the open elements inside, outermost first
+    let mut inside: Vec<(String, String)> = Vec::new();
+    let mut frames: Vec<usize> = Vec::new();
+    let mut needed: Vec<(String, String)> = Vec::new();
+    loop {
+        let (e, empty) = match reader.read_event() {
+            Ok(Event::Start(e)) => (e, false),
+            Ok(Event::Empty(e)) => (e, true),
+            Ok(Event::End(_)) => {
+                if let Some(len) = frames.pop() {
+                    inside.truncate(len);
+                }
+                continue;
+            }
+            Ok(Event::Eof) => return Some(needed),
+            Err(_) => return None,
+            Ok(_) => continue,
+        };
+        frames.push(inside.len());
+        inside.extend(declarations(&e));
+        let attributes: Vec<String> = e
+            .attributes()
+            .flatten()
+            .map(|a| {
+                let key: &str = a.key.as_ref();
+                key.to_string()
+            })
+            .filter(|key| key != "xmlns" && !key.starts_with("xmlns:"))
+            .collect();
+        let element = e.name();
+        let element: &str = element.as_ref();
+        let mut borrow = |prefix: String, uri: String| {
+            let declared_inside = inside.iter().any(|(p, _)| *p == prefix);
+            if !declared_inside && !needed.iter().any(|(p, _)| *p == prefix) {
+                needed.push((prefix, uri));
+            }
+        };
+        // an unprefixed element keeps the default namespace it was read in, OWPML or not
+        if prefix(element).is_none() {
+            let default = resolve("", &inside, |uri| {
+                uri.filter(|uri| !uri.is_empty()).map(str::to_string)
+            });
+            if let Some(uri) = default {
+                borrow(String::new(), uri);
+            }
+        }
+        let names = std::iter::once((element.to_string(), true))
+            .chain(attributes.into_iter().map(|a| (a, false)));
+        for (qname, is_element) in names {
+            match classify(&qname, &inside, is_element) {
+                Name::Written => {}
+                Name::Unwritable => return None,
+                Name::Foreign(prefix, uri) => borrow(prefix, uri),
+            }
+        }
+        if empty {
+            if let Some(len) = frames.pop() {
+                inside.truncate(len);
+            }
+        }
+    }
+}
+
+fn add_namespaces(foreign: &mut ForeignXml, needed: Vec<(String, String)>) {
+    for ns in needed {
+        if !foreign.namespaces.contains(&ns) {
+            foreign.namespaces.push(ns);
+        }
+    }
+}
+
+/// Keeps the attributes of `<hp:p>` the parser does not read.
+pub(super) fn take_p_attributes(e: &BytesStart, read: &[&str], para: &mut Paragraph) {
+    let local = declarations(e);
+    let mut kept = Vec::new();
+    let mut needed = Vec::new();
+    for attr in e.attributes().flatten() {
+        let key: &str = attr.key.as_ref();
+        if read.contains(&key) || key == "xmlns" || key.starts_with("xmlns:") {
+            continue;
+        }
+        match classify(key, &local, false) {
+            Name::Written if prefix(key).is_none() => {}
+            // An OWPML attribute the parser does not read stays out of scope.
+            Name::Written | Name::Unwritable => continue,
+            Name::Foreign(prefix, uri) => {
+                // declared on <hp:p>, a writer prefix would rebind the paragraph's own names
+                if written().iter().any(|(p, _)| *p == prefix) {
+                    continue;
+                }
+                if !needed.contains(&(prefix.clone(), uri.clone())) {
+                    needed.push((prefix, uri));
+                }
+            }
+        }
+        kept.push((key.to_string(), attr.value.replace('"', "&quot;")));
+    }
+    if kept.is_empty() {
+        return;
+    }
+    let foreign = para.foreign_xml.get_or_insert_with(Default::default);
+    add_namespaces(foreign, needed);
+    foreign.attributes.extend(kept);
+}
