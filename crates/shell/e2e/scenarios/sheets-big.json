{
  "deadlineMs": 900000,
  "steps": [
    {
      "op": "open",
      "path": "${WORK}/big.xlsx"
    },
    {
      "op": "waitReady",
      "timeoutMs": 120000
    },
    {
      "op": "wait",
      "ms": 1500
    },
    {
      "op": "query",
      "as": "prep-goto",
      "js": "window.__seuofficeControl?.({cmd:'goto',target:{kind:'range',range:'J50000'}}) ?? null"
    },
    {
      "op": "wait",
      "ms": 1000
    },
    {
      "op": "type",
      "text": "SEU-E2E-big\n"
    },
    {
      "op": "wait",
      "ms": 800
    },
    {
      "op": "query",
      "as": "prep-goto-again",
      "js": "window.__seuofficeControl?.({cmd:'goto',target:{kind:'range',range:'J50000'}}) ?? null"
    },
    {
      "op": "wait",
      "ms": 500
    },
    {
      "op": "query",
      "as": "big-before",
      "js": "window.__seuofficeControl?.({cmd:'selection'}) ?? null"
    },
    {
      "op": "shortcut",
      "name": "save"
    },
    {
      "op": "wait",
      "ms": 10000
    },
    {
      "op": "shortcut",
      "name": "closeTab"
    },
    {
      "op": "wait",
      "ms": 1000
    },
    {
      "op": "open",
      "path": "${WORK}/big.xlsx"
    },
    {
      "op": "waitReady",
      "timeoutMs": 120000
    },
    {
      "op": "wait",
      "ms": 1500
    },
    {
      "op": "query",
      "as": "prep-goto-reopen",
      "js": "window.__seuofficeControl?.({cmd:'goto',target:{kind:'range',range:'J50000'}}) ?? null"
    },
    {
      "op": "wait",
      "ms": 1000
    },
    {
      "op": "query",
      "as": "big-after",
      "js": "window.__seuofficeControl?.({cmd:'selection'}) ?? null"
    }
  ]
}
