+struct MemoInput<'a> {
+    author: &'a str,
+    text: &'a str,
+    authored_at: Option<DateTime<FixedOffset>>,
+}
+
+fn memo_input_object(json: &str) -> Result<Map<String, Value>, MemoError> {
+    match serde_json::from_str(json) {
+        Ok(Value::Object(object)) => Ok(object),
+        _ => Err(MemoError::insert_failed("메모 입력은 JSON 객체여야 함")),
+    }
+}
+
+impl<'a> MemoInput<'a> {
+    fn parse(object: &'a Map<String, Value>) -> Result<Self, MemoError> {
+        let member = |key: &str| match object.get(key) {
+            None => Ok(""),
+            Some(value) => value.as_str().ok_or_else(|| {
+                MemoError::insert_failed("메모 작성자와 본문은 문자열이어야 함")
+            }),
+        };
+        Ok(Self {
+            author: member("author")?,
+            text: member("text")?,
+            authored_at: object.get("authoredAt").map(authored_time).transpose()?,
+        })
+    }
+}
+
+fn authored_time(clock: &Value) -> Result<DateTime<FixedOffset>, MemoError> {
+    let invalid = || MemoError::insert_failed("메모 작성 시각이나 UTC 오프셋이 잘못됨");
+    // Even one day east of UTC, the HWPX timestamp must have a four-digit year.
+    let ms = clock
+        .get("unixMs")
+        .and_then(Value::as_i64)
+        .filter(|ms| (0..=253_402_214_399_999).contains(ms))
+        .ok_or_else(invalid)?;
+    let zone = clock
+        .get("offsetMinutesEast")
+        .and_then(Value::as_i64)
+        .and_then(|m| i32::try_from(m).ok())
+        .and_then(|m| m.checked_mul(60))
+        .and_then(FixedOffset::east_opt)
+        .ok_or_else(invalid)?;
+    let utc = DateTime::from_timestamp_millis(ms).ok_or_else(invalid)?;
+    Ok(utc.with_timezone(&zone))
 }
 
