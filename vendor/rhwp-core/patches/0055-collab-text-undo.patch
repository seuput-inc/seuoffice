 impl DocumentCore {
     /// Call again on the current head before applying a same-paragraph text inverse.
     pub fn get_collab_text_undo_context_native(&self, section: usize, paragraph: usize, path_json: &str) -> String {
diff --git a/src/wasm_api.rs b/src/wasm_api.rs
--- a/src/wasm_api.rs
+++ b/src/wasm_api.rs
@@ -2133,3 +2133,21 @@
+    #[wasm_bindgen(js_name = getCollabLiteralFragment)]
+    pub fn get_collab_literal_fragment(&self, section: usize, paragraph: usize, path: &str, start: usize, end: usize) -> Result<String, JsValue> {
+        self.core.collab_literal_fragment(section, paragraph, path, start, end)
+            .ok_or_else(|| JsValue::from_str("Unsupported collaborative text fragment"))
+    }
+
+    #[wasm_bindgen(js_name = getCollabShapeWitness)]
+    pub fn get_collab_shape_witness(&self, ids: &[u32]) -> Result<String, JsValue> {
+        if ids.len() > 4096 { return Err(JsValue::from_str("Too many fragment styles")); }
+        let mut hash = blake3::Hasher::new();
+        for &id in ids {
+            let shape = self.document().doc_info.char_shapes.get(id as usize)
+                .ok_or_else(|| JsValue::from_str("Missing fragment style"))?;
+            serde_json::to_writer(&mut hash, &(id, shape)).map_err(|_| JsValue::from_str("Invalid fragment style"))?;
+        }
+        Ok(hash.finalize().to_hex().to_string())
+    }
+
