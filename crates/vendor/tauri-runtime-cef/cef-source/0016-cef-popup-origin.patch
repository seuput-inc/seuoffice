+  // Only the caller's RFH-bound, browser-admitted default world can populate
+  // popup metadata. A renderer payload is never itself an activation grant.
+  static bool AuthenticatePopup(content::RenderFrameHostImpl* rfh,
+                                const blink::DocumentToken& document,
+                                const blink::V8ContextToken& context,
+                                CefPopupFeatures& features) {
+    CEF_REQUIRE_UIT();
+    if (!rfh || !CEF_API_IS_ADDED(15401)) return false;
+    const auto found = PopupRegistrations().find(rfh->GetGlobalId());
+    if (found == PopupRegistrations().end()) return false;
+    auto* service = found->second.get();
+    if (!service || service->render_frame_host() != rfh ||
+        !service->registered_ || service->world_ != 0 ||
+        !service->traffic_ || !service->traffic_->IsLive() ||
+        !service->document_identity_ || !service->context_identity_ ||
+        *service->document_identity_ != document ||
+        *service->context_identity_ != context ||
+        service->child_id_ != rfh->GetProcess()->GetDeprecatedID() ||
+        rfh->GetParent() || !rfh->MatchesLatestDocumentForCef(document)) {
+      return false;
+    }
+    features.nativeRendererChildId = service->child_id_;
+    features.nativeWorldId = service->world_;
+    features.nativeDocumentHigh = document.value().GetHighForSerialization();
+    features.nativeDocumentLow = document.value().GetLowForSerialization();
+    features.nativeContextHigh = context.value().GetHighForSerialization();
+    features.nativeContextLow = context.value().GetLowForSerialization();
+    features.nativeContextAuthenticated = 1;
+    return true;
+  }
+
  private:
+  using PopupRegistry = std::map<content::GlobalRenderFrameHostId,
+                                base::WeakPtr<CefNativeContextService>>;
+
+  static PopupRegistry& PopupRegistrations() {
+    static base::NoDestructor<PopupRegistry> registrations;
+    return *registrations;
+  }
+
+  bool PublishPopupRegistration() {
+    DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+    auto* rfh = static_cast<content::RenderFrameHostImpl*>(render_frame_host());
+    if (!registered_ || !traffic_ || !traffic_->IsLive() ||
+        !document_identity_ || !context_identity_ ||
+        !rfh->MatchesLatestDocumentForCef(*document_identity_)) return false;
+    const auto key = rfh->GetGlobalId();
+    const bool inserted =
+        PopupRegistrations().emplace(key, weak_.GetWeakPtr()).second;
+    if (!inserted) return false;
+    popup_registration_ = key;
+    return true;
+  }
+
+  void RemovePopupRegistration() {
+    DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+    if (!popup_registration_) return;
+    const auto found = PopupRegistrations().find(*popup_registration_);
+    // Never erase a newer endpoint that reused the RFH's route identity.
+    if (found != PopupRegistrations().end() && found->second.get() == this)
+      PopupRegistrations().erase(found);
+    popup_registration_.reset();
+  }
