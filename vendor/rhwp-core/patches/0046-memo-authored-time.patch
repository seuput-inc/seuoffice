Subject: [PATCH] memo: keep the author instant and HWPX wall time on replay

HWP carries a UTC FILETIME; HWPX also carries the author's local wall
time. Keep both on the individual memo, not in a host clock override.

diff --git a/src/model/memo_time.rs b/src/model/memo_time.rs
--- a/src/model/memo_time.rs
+++ b/src/model/memo_time.rs
@@ -4,8 +4,7 @@
 const UNIX_EPOCH_TICKS: i64 = 116_444_736_000_000_000;
 const TICKS_PER_SECOND: i64 = 10_000_000;
 
-pub(crate) fn now() -> u64 {
-    let time = Utc::now();
+pub(crate) fn filetime(time: DateTime<Utc>) -> u64 {
     (UNIX_EPOCH_TICKS
         + time.timestamp() * TICKS_PER_SECOND
         + i64::from(time.timestamp_subsec_nanos() / 100)) as u64
