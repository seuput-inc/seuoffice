+// Copyright 2026 The Chromium Embedded Framework Authors.
+// Use of this source code is governed by a BSD-style license.
+#ifndef CEF_LIBCEF_BROWSER_NATIVE_RESOURCE_REGISTRY_H_
+#define CEF_LIBCEF_BROWSER_NATIVE_RESOURCE_REGISTRY_H_
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <tuple>
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+#include "cef/libcef/common/native_resource.h"
+#include "content/public/browser/global_routing_id.h"
+#include "third_party/blink/public/common/tokens/tokens.h"
+
+// The factory key is captured on UI inside the native Chromium factory scope.
+// No request headers, initiator URL or MaybeChangeMainFrame lookup participates.
+class CefNativeResourceRegistry {
+ public:
+  using Key = std::tuple<content::GlobalRenderFrameHostId, std::string, uint64_t>;
+  static CefNativeResourceRegistry& Get() {
+    static base::NoDestructor<CefNativeResourceRegistry> registry;
+    return *registry;
+  }
+  bool Publish(const Key& key, std::shared_ptr<const CefNativeResourceOriginState> state) {
+    base::AutoLock lock(lock_);
+    return state && state->IsLive() && entries_.emplace(key, std::move(state)).second;
+  }
+  void Remove(const Key& key, const std::shared_ptr<const CefNativeResourceOriginState>& state) {
+    base::AutoLock lock(lock_);
+    const auto found = entries_.find(key);
+    if (found != entries_.end() && found->second == state) entries_.erase(found);
+  }
+  std::shared_ptr<const CefNativeResourceOriginState> Capture(const Key& key) {
+    base::AutoLock lock(lock_);
+    const auto found = entries_.find(key);
+    if (found == entries_.end() || !found->second->IsLive()) return nullptr;
+    return found->second;
+  }
+ private:
+  base::Lock lock_;
+  std::map<Key, std::shared_ptr<const CefNativeResourceOriginState>> entries_;
+};
+
+#endif  // CEF_LIBCEF_BROWSER_NATIVE_RESOURCE_REGISTRY_H_
