{
  "name": "@seuoffice/history-renderer",
  "version": "0.1.0-rc.1",
  "private": true,
  "description": "Render retained office document history from bytes in Node.js",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.d.ts",
    "examples",
    "README.md",
    "LICENSE",
    "LICENSE-APACHE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build && node ../../scripts/seuoffice-prepack.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@seuoffice/collab": "0.1.0",
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "prosemirror-model": "1.25.12",
    "prosemirror-transform": "1.12.0",
    "saxes": "6.0.0"
  },
  "optionalDependencies": {
    "@deno/darwin-arm64": "2.9.6",
    "@deno/linux-arm64-glibc": "2.9.6"
  },
  "devDependencies": {
    "@seuoffice/docx-engine": "*",
    "@seuoffice/engine-wasm": "*",
    "@seuoffice/pptx-engine": "*",
    "@seuoffice/pptx-ops": "*",
    "@seuoffice/xlsx-gateway": "*",
    "@seuoffice/zip-gate": "*",
    "@types/node": "^24.10.1",
    "esbuild": "0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
