+/// Receives one exact document loss after the native mutation unwinds.
+/*--cef(source=client,added=15401)--*/
+class CefNativeObservedDocumentCallback : public virtual CefBaseRefCounted {
+ public:
+  /// 1: document release/replacement/close; 2: original renderer process loss.
+  /*--cef()--*/
+  virtual void OnLost(int reason) = 0;
+};
+
+/// Native-only observation, never a V8 context or IPC authority.
+/*--cef(source=library,added=15401,no_debugct_check)--*/
+class CefNativeObservedDocument : public virtual CefBaseRefCounted {
+ public:
+  /*--cef()--*/
+  virtual CefRefPtr<CefNativeRendererProcess> GetProcess() = 0;
+  /// Race-free registration; false means no callback was registered.
+  /*--cef()--*/
+  virtual bool ObserveLoss(CefRefPtr<CefNativeObservedDocumentCallback> callback) = 0;
 };
 
