diff --git a/libcef/common/native_resource.h b/libcef/common/native_resource.h
--- /dev/null
+++ b/libcef/common/native_resource.h
@@ -0,0 +1,52 @@
+// Copyright 2026 The Chromium Embedded Framework Authors.
+// Use of this source code is governed by a BSD-style license.
+#ifndef CEF_LIBCEF_COMMON_NATIVE_RESOURCE_H_
+#define CEF_LIBCEF_COMMON_NATIVE_RESOURCE_H_
+
+#include <atomic>
+#include <memory>
+#include "base/synchronization/lock.h"
+#include "cef/include/cef_request.h"
+
+struct CefNativeResourceOriginState {
+  CefNativeResourceOrigin origin;
+  mutable base::Lock admission;
+  mutable std::atomic<bool> live{true};
+  bool IsLive() const { return live.load(std::memory_order_acquire); }
+  void Revoke() const {
+    base::AutoLock lock(admission);
+    live.store(false, std::memory_order_release);
+  }
+};
+
+class CefNativeResourceDeliveryImpl final : public CefNativeResourceDelivery {
+ public:
+  void BindOrigin(std::shared_ptr<const CefNativeResourceOriginState> origin) {
+    origin_ = std::move(origin);
+  }
+  bool TryAccept() override {
+    if (origin_) {
+      base::AutoLock lock(origin_->admission);
+      if (!origin_->IsLive()) return false;
+      return Claim();
+    }
+    return Claim();
+  }
+  bool IsCancelled() override {
+    return phase_.load(std::memory_order_acquire) == Phase::kCancelled;
+  }
+  void Cancel() { phase_.store(Phase::kCancelled, std::memory_order_release); }
+ private:
+  enum class Phase { kOpen, kAccepted, kCancelled };
+  bool Claim() {
+    auto expected = Phase::kOpen;
+    return phase_.compare_exchange_strong(expected, Phase::kAccepted,
+        std::memory_order_acq_rel, std::memory_order_acquire);
+  }
+  std::shared_ptr<const CefNativeResourceOriginState> origin_;
+  std::atomic<Phase> phase_{Phase::kOpen};
+  IMPLEMENT_REFCOUNTING(CefNativeResourceDeliveryImpl);
+};
+
+
+#endif  // CEF_LIBCEF_COMMON_NATIVE_RESOURCE_H_
