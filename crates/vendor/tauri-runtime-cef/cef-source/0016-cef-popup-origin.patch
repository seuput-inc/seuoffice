diff --git a/tests/ceftests/navigation_unittest.cc b/tests/ceftests/navigation_unittest.cc
--- a/tests/ceftests/navigation_unittest.cc
+++ b/tests/ceftests/navigation_unittest.cc
@@ -5,2 +5,4 @@
 #include <algorithm>
+#include <iomanip>
 #include <list>
+#include <sstream>
@@ -3709,2 +3711,145 @@
+#if CEF_API_ADDED(15401)
+namespace {
+enum class NativePopupCase { kLive, kMissing, kRejected, kStale, kForeign, kNested };
+
+std::string NativePopupToken(uint64_t high, uint64_t low) {
+  std::ostringstream text;
+  text << std::uppercase << std::hex << std::setfill('0')
+       << std::setw(16) << high << std::setw(16) << low;
+  return text.str();
+}
+
+class NativePopupOriginTest : public TestHandler {
+ public:
+  explicit NativePopupOriginTest(NativePopupCase which) : which_(which) {}
+
+  void RunTest() override {
+    AddResource(kReadyUrl, "<html><body>native popup source</body></html>", "text/html");
+    AddResource(kStaleUrl, "<html><body>unapproved replacement</body></html>", "text/html");
+    auto info = CefDictionaryValue::Create();
+    info->SetInt("seuoffice.trusted-mode", 1);
+    info->SetString("seuoffice.trusted-init", R"json({"scripts":[{"source":"(() => { const b = globalThis.__seuofficeNativeBridgeBootstrap(); delete globalThis.__seuofficeNativeBridgeBootstrap; delete globalThis.__seuofficeNativeSendSync; b.listenTauri(() => {}); })();","main_only":true}]})json");
+    CreateBrowser(CefString(), nullptr, info);
+    SetTestTimeout();
+  }
+
+  void OnAfterCreated(CefRefPtr<CefBrowser> browser) override {
+    TestHandler::OnAfterCreated(browser);
+    GrantPopupPermission(browser->GetHost()->GetRequestContext(), kReadyUrl);
+    if (which_ == NativePopupCase::kMissing) {
+      browser->GetMainFrame()->LoadURL(kReadyUrl);
+    } else {
+      browser->GetHost()->LoadApprovedMainFrameURL(
+          kReadyUrl, 1, "native-popup-fixture-intent", new Completion(this));
+    }
+  }
+
+  bool OnNativeContextRegistered(CefRefPtr<CefBrowser> browser,
+      CefRefPtr<CefFrame> frame, const CefString& frame_id, int child,
+      const CefString& document, const CefString& context, uint64_t issuance,
+      const CefString& intent, int world, const CefString& document_url,
+      CefRefPtr<CefNativeContextEvaluation> evaluation,
+      CefRefPtr<CefNativeContextChannel> channel) override {
+    EXPECT_EQ(kReadyUrl, document_url.ToString());
+    EXPECT_EQ(0, world);
+    EXPECT_GT(child, 0);
+    EXPECT_TRUE(frame->IsMain());
+    registered_ = true;
+    frame_ = frame_id.ToString();
+    document_ = document.ToString();
+    context_ = context.ToString();
+    child_ = child;
+    return which_ != NativePopupCase::kRejected;
+  }
+
+  void OnLoadEnd(CefRefPtr<CefBrowser> browser, CefRefPtr<CefFrame> frame,
+                 int http_status_code) override {
+    if (!frame->IsMain()) return;
+    const auto url = frame->GetURL().ToString();
+    if (url != kReadyUrl && url != kStaleUrl) return;
+    std::string script;
+    if (which_ == NativePopupCase::kForeign) {
+      script = R"js(const child = document.createElement('iframe'); child.srcdoc = '<script>top.open("https://popup-origin.example/foreign"); console.log("CEF_NATIVE_POPUP_FINISHED")<\/script>'; document.body.appendChild(child);)js";
+    } else if (which_ == NativePopupCase::kNested) {
+      script = "window.open(window.open('https://popup-origin.example/inner')); console.log('CEF_NATIVE_POPUP_FINISHED');";
+    } else if (which_ == NativePopupCase::kStale && url == kReadyUrl) {
+      script = "window.open('https://popup-origin.example/live'); location.href='https://popup-origin.example/unapproved';";
+    } else {
+      script = "window.open('https://popup-origin.example/popup'); console.log('CEF_NATIVE_POPUP_FINISHED');";
+    }
+    frame->ExecuteJavaScript(script, url, 0);
+  }
+
+  bool OnBeforePopup(CefRefPtr<CefBrowser> browser, CefRefPtr<CefFrame> frame,
+      int popup_id, const CefString& target_url, const CefString& target_frame_name,
+      cef_window_open_disposition_t target_disposition, bool user_gesture,
+      const CefPopupFeatures& features, CefWindowInfo& window_info,
+      CefRefPtr<CefClient>& client, CefBrowserSettings& settings,
+      CefRefPtr<CefDictionaryValue>& extra_info, bool* no_javascript_access) override {
+    EXPECT_TRUE(registered_);
+    EXPECT_EQ(1, features.nativeContextAuthenticated);
+    EXPECT_EQ(child_, features.nativeRendererChildId);
+    EXPECT_EQ(0, features.nativeWorldId);
+    EXPECT_EQ(frame_, frame->GetIdentifier().ToString());
+    EXPECT_EQ(document_, NativePopupToken(features.nativeDocumentHigh, features.nativeDocumentLow));
+    EXPECT_EQ(context_, NativePopupToken(features.nativeContextHigh, features.nativeContextLow));
+    ++popups_;
+    return true;
+  }
+
+  bool OnConsoleMessage(CefRefPtr<CefBrowser> browser, cef_log_severity_t level,
+      const CefString& message, const CefString& source, int line) override {
+    if (message != "CEF_NATIVE_POPUP_FINISHED") return false;
+    const int expected = which_ == NativePopupCase::kNested ? 2
+        : (which_ == NativePopupCase::kLive || which_ == NativePopupCase::kStale ? 1 : 0);
+    EXPECT_EQ(expected, popups_);
+    EXPECT_EQ(which_ != NativePopupCase::kMissing, registered_);
+    finished_ = true;
+    DestroyTest();
+    return true;
+  }
+
+  void DestroyTest() override {
+    EXPECT_TRUE(finished_);
+    TestHandler::DestroyTest();
+  }
+
+ private:
+  class Completion : public CefApprovedNavigationCallback {
+   public:
+    explicit Completion(CefRefPtr<NativePopupOriginTest> owner) : owner_(owner) {}
+    void OnComplete(bool accepted) override { EXPECT_TRUE(accepted); }
+   private:
+    CefRefPtr<NativePopupOriginTest> owner_;
+    IMPLEMENT_REFCOUNTING(Completion);
+  };
+  static constexpr char kReadyUrl[] = "https://popup-origin.example/ready";
+  static constexpr char kStaleUrl[] = "https://popup-origin.example/unapproved";
+  const NativePopupCase which_;
+  bool registered_ = false;
+  bool finished_ = false;
+  int child_ = 0;
+  int popups_ = 0;
+  std::string frame_;
+  std::string document_;
+  std::string context_;
+  IMPLEMENT_REFCOUNTING(NativePopupOriginTest);
+};
+
+void RunNativePopupCase(NativePopupCase which) {
+  CefRefPtr<NativePopupOriginTest> handler = new NativePopupOriginTest(which);
+  handler->ExecuteTest();
+  ReleaseAndWaitForDestructor(handler);
+}
