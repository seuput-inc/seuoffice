+TEST_F(FrameTreeTest, CefAdmissionPairRetainsPostAfterUnsubscribe) {
+  auto* root = contents()->GetPrimaryFrameTree().root();
+  int before = 0;
+  int after = 0;
+  auto subscription = root->AddCefPreNavigationRevoker(base::BindLambdaForTesting(
+      [&](RenderFrameHostImpl* affected,
+          std::vector<base::OnceClosure>* completions) {
+        EXPECT_EQ(nullptr, affected);
+        ++before;
+        completions->push_back(base::BindOnce([](int* value) { ++*value; }, &after));
+      }));
+  {
+    auto outer = FrameTreeNode::BeginCefAdmissionMutation();
+    {
+      auto mutation = root->RevokeCefAdmission();
+      EXPECT_EQ(1, before);
+      EXPECT_EQ(0, after);
+      subscription = {};
+    }
+    EXPECT_EQ(0, after);
+  }
+  EXPECT_EQ(1, after);
+  {
+    auto mutation = root->RevokeCefAdmission();
+  }
+  EXPECT_EQ(1, before);
+  EXPECT_EQ(1, after);
+}
+
+TEST_F(FrameTreeTest, CefAdmissionPrecedesNavigationRequestReplacement) {
+  main_test_rfh()->InitializeRenderFrameIfNeeded();
+  auto* root = contents()->GetPrimaryFrameTree().root();
+  EXPECT_EQ(nullptr, root->navigation_request());
+  int before = 0;
+  int after = 0;
+  auto subscription = root->AddCefPreNavigationRevoker(base::BindLambdaForTesting(
+      [&](RenderFrameHostImpl* affected,
+          std::vector<base::OnceClosure>* completions) {
+        if (affected) return;
+        ++before;
+        if (before == 1) {
+          EXPECT_EQ(nullptr, root->navigation_request());
+        }
+        completions->push_back(base::BindOnce([](int* value) { ++*value; }, &after));
+      }));
+  auto navigation = NavigationSimulator::CreateBrowserInitiated(
+      GURL("https://approved.example/start"), contents());
+  navigation->Start();
+  EXPECT_GE(before, 1);
+  EXPECT_EQ(before, after);
+  ASSERT_NE(nullptr, root->navigation_request());
+  const int before_redirect = before;
+  navigation->Redirect(GURL("https://redirect.example/end"));
+  EXPECT_EQ(before_redirect, before);
+  navigation->Fail(net::ERR_ABORTED);
+  EXPECT_GT(before, before_redirect);
+  EXPECT_EQ(before, after);
+}
+
+TEST_F(FrameTreeTest, CefAdmissionPostOutlivesFrameAndTreeDestruction) {
+  main_test_rfh()->InitializeRenderFrameIfNeeded();
