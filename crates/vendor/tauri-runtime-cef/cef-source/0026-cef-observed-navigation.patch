 #include "cef/libcef/browser/browser_event_util.h"
 #include "cef/libcef/browser/browser_host_base.h"
@@ -512,3 +518,45 @@
 void CefBrowserContentsDelegate::DidFinishNavigation(
     content::NavigationHandle* navigation_handle) {
+  // Resolve the original NavigationUIData before stock CEF can relabel a
+  // missing frame to the browser's current main frame.
+  auto* approval = web_contents() ? CefApprovedNavigation::Get(web_contents()) : nullptr;
+  auto receipt = approval ? approval->TakeObservation(navigation_handle) : std::nullopt;
+  if (receipt && CEF_API_IS_ADDED(15401)) {
+    CefRefPtr<CefNativeRendererProcess> process;
+    std::string document;
+    bool committed = navigation_handle->HasCommitted() &&
+                     !navigation_handle->IsErrorPage();
+    if (committed) {
+      auto* host = static_cast<content::RenderFrameHostImpl*>(
+          navigation_handle->GetRenderFrameHost());
+      const auto& original_document = static_cast<content::NavigationRequest*>(
+          navigation_handle)->GetDocumentToken();
+      if (!host || host->GetParent() || !host->MatchesLatestDocumentForCef(original_document)) {
+        committed = false;
+      } else {
+        process = CefNativeRendererProcessImpl::ForHost(host->GetProcess());
+        if (process) document = original_document.ToString();
+        else committed = false;
+      }
+    }
+    const int observed_error = committed ? net::OK : (navigation_handle->GetNetErrorCode() != net::OK ? navigation_handle->GetNetErrorCode() : net::ERR_FAILED);
+    if (auto c = client()) {
+      auto b = browser();
+      auto notify = [](CefRefPtr<CefClient> client, CefRefPtr<CefBrowser> browser,
+                       uint64_t issuance, std::string nonce, bool committed, int error_code,
+                       std::string url, std::string document,
+                       CefRefPtr<CefNativeRendererProcess> process) {
+        client->OnNativeObservedNavigation(browser, issuance, nonce, committed,
+                                           error_code, url, document, process);
+      };
+      if (!CEF_TASK_RUNNER<CEF_UIT>()->PostTask(
+              FROM_HERE, base::BindOnce(notify, c, b, receipt->first, receipt->second,
+                                        committed, observed_error, navigation_handle->GetURL().spec(),
+                                        document, process))) {
+        c->OnNativeObservedNavigation(b, receipt->first, receipt->second,
+                                      false, net::ERR_FAILED, CefString(), CefString(), nullptr);
+        return;
+      }
+    }
+  }
   const net::Error error_code = navigation_handle->GetNetErrorCode();
@@ -722,7 +751,18 @@
 void CefBrowserContentsDelegate::WebContentsDestroyed() {
   auto wc = web_contents();
+  auto* approval = wc ? CefApprovedNavigation::Get(wc) : nullptr;
+  auto receipts = approval ? approval->TakeClosedObservations()
+                           : std::vector<std::pair<uint64_t, std::string>>();
+  auto browser_ref = browser();
+  auto client_ref = client();
   ObserveWebContents(nullptr);
   for (auto& observer : observers_) {
     observer.OnWebContentsDestroyed(wc);
   }
+  if (client_ref && CEF_API_IS_ADDED(15401)) {
+    for (const auto& receipt : receipts) {
+      client_ref->OnNativeObservedNavigation(browser_ref, receipt.first,
+          receipt.second, false, net::ERR_ABORTED, CefString(), CefString(), nullptr);
+    }
+  }
 }
