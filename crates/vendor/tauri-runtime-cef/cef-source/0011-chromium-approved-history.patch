+class ApprovedHistoryCommandTest : public NavigationControllerTest {
+ protected:
+  using Outcome = NavigationController::CefHistoryOutcome;
+  static constexpr char kPostBody[] = "post\n\0body";
+  struct Receipt {
+    bool current = true;
+    int bindings = 0;
+    std::optional<int64_t> navigation_id;
+    std::vector<Outcome> outcomes;
+  };
+
+  std::unique_ptr<NavigationController::CefHistoryCommand> Command(
+      const std::shared_ptr<Receipt>& receipt) {
+    return std::make_unique<NavigationController::CefHistoryCommand>(
+        std::make_unique<TestNavigationUIData>(),
+        base::BindRepeating([](std::shared_ptr<Receipt> receipt) {
+          return receipt->current;
+        }, receipt),
+        base::BindOnce([](std::shared_ptr<Receipt> receipt, int64_t id) {
+          ++receipt->bindings;
+          receipt->navigation_id = id;
+          return receipt->current;
+        }, receipt),
+        base::BindOnce([](std::shared_ptr<Receipt> receipt, Outcome outcome) {
+          receipt->outcomes.push_back(outcome);
+        }, receipt));
+  }
+
+  void CommitPost() {
+    const GURL url("https://approved.example/post");
+    auto navigation =
+        NavigationSimulatorImpl::CreateBrowserInitiated(url, contents());
+    NavigationController::LoadURLParams params(url);
+    params.load_type = NavigationController::LOAD_TYPE_HTTP_POST;
+    params.post_data = network::ResourceRequestBody::CreateFromCopyOfBytes(
+        base::byte_span_from_cstring(kPostBody));
+    params.post_data->set_identifier(731);
+    navigation->SetLoadURLParams(&params);
+    navigation->Start();
+    navigation->set_post_id(731);
+    navigation->Commit();
+    auto* frame = controller_impl().GetLastCommittedEntry()->GetFrameEntry(root_ftn());
+    blink::ExplodedPageState saved;
+    ASSERT_TRUE(blink::DecodePageState(frame->page_state().ToEncodedData(), &saved));
+    saved.top.http_body.request_body = params.post_data;
+    saved.top.http_body.http_content_type = u"application/octet-stream";
+    std::string encoded;
+    blink::EncodePageState(saved, &encoded);
+    frame->SetPageState(blink::PageState::CreateFromEncodedData(encoded));
+  }
+};
+
+TEST_F(ApprovedHistoryCommandTest, NoopPreservesAdmissionAndCompletesOnce) {
+  int revoked = 0;
+  auto subscription = root_ftn()->AddCefPreNavigationRevoker(
+      base::BindLambdaForTesting(
+          [&](RenderFrameHostImpl*, std::vector<base::OnceClosure>*) {
+            ++revoked;
+          }));
+  auto receipt = std::make_shared<Receipt>();
+  controller_impl().GoBackWithCefHistoryCommand(Command(receipt));
+  controller_impl().GoForwardWithCefHistoryCommand(Command(receipt));
+  controller_impl().ReloadWithCefHistoryCommand(ReloadType::NORMAL, true,
+                                               Command(receipt));
+  EXPECT_EQ(0, revoked);
+  EXPECT_EQ(0, receipt->bindings);
+  EXPECT_EQ((std::vector<Outcome>{Outcome::kSameDocumentOrNoop,
+                                 Outcome::kSameDocumentOrNoop,
+                                 Outcome::kSameDocumentOrNoop}),
+            receipt->outcomes);
+}
+
+TEST_F(ApprovedHistoryCommandTest, ClonedMetadataCannotCompleteTheUiCommand) {
+  auto receipt = std::make_shared<Receipt>();
+  auto command = Command(receipt);
+  auto data = command->TakeData();
+  auto clone = data->Clone();
+  clone.reset();
+  data.reset();
+  EXPECT_TRUE(receipt->outcomes.empty());
+  command->Finish(Outcome::kSameDocumentOrNoop);
+  command->Finish(Outcome::kCancelled);
+  command.reset();
+  EXPECT_EQ((std::vector<Outcome>{Outcome::kSameDocumentOrNoop}),
+            receipt->outcomes);
+}
+
+TEST_F(ApprovedHistoryCommandTest, RepostCancelDoesNotStartOrRevoke) {
+  CommitPost();
+  int revoked = 0;
+  auto subscription = root_ftn()->AddCefPreNavigationRevoker(
+      base::BindLambdaForTesting(
+          [&](RenderFrameHostImpl*, std::vector<base::OnceClosure>*) {
+            ++revoked;
+          }));
+  auto receipt = std::make_shared<Receipt>();
+  controller_impl().ReloadWithCefHistoryCommand(
+      ReloadType::BYPASSING_CACHE, true, Command(receipt));
+  EXPECT_EQ(1u, form_repost_counter_);
+  EXPECT_EQ(0, revoked);
+  EXPECT_FALSE(HasNavigationRequest());
+  EXPECT_TRUE(receipt->outcomes.empty());
+  controller_impl().CancelPendingReload();
+  controller_impl().ContinuePendingReload();
+  EXPECT_EQ(0, revoked);
+  EXPECT_FALSE(HasNavigationRequest());
+  EXPECT_EQ((std::vector<Outcome>{Outcome::kCancelled}), receipt->outcomes);
+}
+
+TEST_F(ApprovedHistoryCommandTest, RepostContinuePreservesPostCacheAndIdentity) {
+  CommitPost();
+  auto receipt = std::make_shared<Receipt>();
