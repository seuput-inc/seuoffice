{
  "steps": [
    {
      "op": "open",
      "path": "${WORK}/mindmap.xmind"
    },
    {
      "op": "waitReady",
      "timeoutMs": 60000
    },
    {
      "op": "wait",
      "ms": 1000
    },
    {
      "op": "query",
      "as": "prep-select",
      "js": "(() => { const t = document.querySelector('me-root me-tpc') ?? document.querySelector('me-tpc'); if (!t) return false; t.closest('.map-container')?.focus(); t.dispatchEvent(new MouseEvent('click', { bubbles: true })); return true })()"
    },
    {
      "op": "wait",
      "ms": 500
    },
    {
      "op": "type",
      "text": "\t"
    },
    {
      "op": "wait",
      "ms": 600
    },
    {
      "op": "type",
      "text": "SEU-E2E-mindmap"
    },
    {
      "op": "wait",
      "ms": 300
    },
    {
      "op": "type",
      "text": "\n"
    },
    {
      "op": "wait",
      "ms": 500
    },
    {
      "op": "query",
      "as": "mindmap-before",
      "js": "[...document.querySelectorAll('me-tpc')].map((e) => e.textContent).join(' | ')"
    },
    {
      "op": "shortcut",
      "name": "save"
    },
    {
      "op": "wait",
      "ms": 2500
    },
    {
      "op": "shortcut",
      "name": "closeTab"
    },
    {
      "op": "wait",
      "ms": 1000
    },
    {
      "op": "open",
      "path": "${WORK}/mindmap.xmind"
    },
    {
      "op": "waitReady",
      "timeoutMs": 60000
    },
    {
      "op": "wait",
      "ms": 1000
    },
    {
      "op": "query",
      "as": "mindmap-after",
      "js": "[...document.querySelectorAll('me-tpc')].map((e) => e.textContent).join(' | ')"
    }
  ]
}
