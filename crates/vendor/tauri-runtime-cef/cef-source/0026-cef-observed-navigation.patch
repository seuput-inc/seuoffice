     }
     ~NavigationData() override {
       base::AutoLock lock(state_->data_lock);
       state_->data.erase(this);
+      const bool has_clone = std::any_of(state_->data.begin(), state_->data.end(),
+          [this](const auto& entry) { return entry.second.issuance == issuance_; });
