+// Copyright 2026 The Chromium Embedded Framework Authors.
+// Use of this source code is governed by a BSD-style license.
+#ifndef CEF_LIBCEF_RENDERER_NATIVE_CONTEXT_EVALUATOR_MOJO_H_
+#define CEF_LIBCEF_RENDERER_NATIVE_CONTEXT_EVALUATOR_MOJO_H_
+
+#include <memory>
+#include <utility>
+#include "base/functional/bind.h"
+#include "cef/libcef/common/mojom/cef.mojom.h"
+#include "cef/libcef/renderer/native_context_evaluator.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+
+// Exact-context receiver, owned by the renderer observer's captured token.
+// Release does not execute script. Pending native replies become stale before
+// persistent V8 handles are dropped; it never resolves into a successor context.
+class CefNativeContextEvaluatorMojo final
+    : public cef::mojom::NativeContextEvaluator {
+ public:
+  CefNativeContextEvaluatorMojo(v8::Isolate* isolate,
+                                v8::Local<v8::Context> context)
+      : evaluator_(std::make_shared<CefNativeContextEvaluator>(isolate, context)),
+        receiver_(this) {}
+  ~CefNativeContextEvaluatorMojo() override { Release(); }
+
+  mojo::PendingRemote<cef::mojom::NativeContextEvaluator> BindNewPipeAndPassRemote() {
+    auto remote = receiver_.BindNewPipeAndPassRemote();
+    receiver_.set_disconnect_handler(base::BindOnce(
+        &CefNativeContextEvaluatorMojo::Release, base::Unretained(this)));
+    return remote;
+  }
+
+  void Release() {
+    receiver_.reset();
+    auto evaluator = evaluator_;
+    if (evaluator) evaluator->Release();
+  }
+
+ private:
+  void Evaluate(const std::string& nonce, const std::string& source,
+                EvaluateCallback callback) override {
+    auto evaluator = evaluator_;
+    evaluator->Evaluate(nonce, source, base::BindOnce(
+        [](EvaluateCallback reply, std::string nonce, std::string code,
+           std::string payload) {
+          std::move(reply).Run(nonce, code, payload);
+        }, std::move(callback)));
+  }
+  void Cancel(const std::string& nonce) override {
+    auto evaluator = evaluator_;
+    evaluator->Cancel(nonce);
+  }
+  std::shared_ptr<CefNativeContextEvaluator> evaluator_;
+  mojo::Receiver<cef::mojom::NativeContextEvaluator> receiver_;
+};
+#endif  // CEF_LIBCEF_RENDERER_NATIVE_CONTEXT_EVALUATOR_MOJO_H_
diff --git a/libcef/browser/native_context_evaluation.h b/libcef/browser/native_context_evaluation.h
new file mode 100644
--- /dev/null
+++ b/libcef/browser/native_context_evaluation.h
@@ -0,0 +1,124 @@
+// Copyright 2026 The Chromium Embedded Framework Authors.
+// Use of this source code is governed by a BSD-style license.
+#ifndef CEF_LIBCEF_BROWSER_NATIVE_CONTEXT_EVALUATION_H_
+#define CEF_LIBCEF_BROWSER_NATIVE_CONTEXT_EVALUATION_H_
+
+#include <limits>
+#include <map>
+#include <string>
+#include <utility>
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/string_number_conversions.h"
+#include "cef/include/cef_client.h"
+#include "cef/libcef/browser/thread_util.h"
+#include "content/browser/renderer_host/render_frame_host_impl.h"
+#include "content/browser/renderer_host/frame_tree_node.h"
+#include "cef/libcef/common/mojom/cef.mojom.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+// Browser UI sequence only. Renderer routing is the exact-context private pipe.
+// Invalidate is safe in the native pre-mutation hook: it invokes no client code.
+class CefNativeContextEvaluationImpl final : public CefNativeContextEvaluation {
+ public:
+  explicit CefNativeContextEvaluationImpl(
+      base::WeakPtr<content::RenderFrameHostImpl> owner,
+      blink::DocumentToken document,
+      mojo::PendingRemote<cef::mojom::NativeContextEvaluator> remote)
+      : owner_(std::move(owner)), document_(document), remote_(std::move(remote)) {
+    remote_.set_disconnect_handler(base::BindOnce(
+        &CefNativeContextEvaluationImpl::Close, weak_.GetWeakPtr()));
+  }
+
+  bool IsCurrentDocument() override {
+    CEF_REQUIRE_UIT_RETURN(false);
+    auto* owner = owner_.get();
+    return live_ && remote_.is_connected() && owner &&
+        owner->IsInPrimaryMainFrame() && owner->IsActive() &&
+        owner->IsRenderFrameLive() &&
+        !owner->HasPendingCommitForCrossDocumentNavigation() &&
+        owner->GetDocumentToken() == document_ && owner->frame_tree_node() &&
+        !owner->frame_tree_node()->navigation_request() &&
+        owner->frame_tree_node()->current_frame_host() == owner;
+  }
+
+  void Evaluate(const CefString& nonce, const CefString& source,
+                CefRefPtr<CefNativeContextEvaluationCallback> callback) override {
+    CEF_REQUIRE_UIT();
+    if (!callback) return;
+    CefRefPtr<CefNativeContextEvaluationImpl> keep_alive(this);
+    const std::string caller = nonce.ToString();
+    if (!live_ || !remote_.is_connected()) {
+      callback->OnComplete(nonce, "stale_context", "Context is not live");
+      return;
+    }
+    for (const auto& [ordinal, pending] : pending_) {
+      if (pending.nonce == caller) {
+        callback->OnComplete(nonce, "duplicate_request", "Request is already pending");
+        return;
+      }
+    }
+    if (next_ == std::numeric_limits<uint64_t>::max()) {
+      callback->OnComplete(nonce, "internal", "Evaluation ordinal exhausted");
+      return;
+    }
+    const std::string ordinal = base::NumberToString(++next_);
+    pending_.emplace(ordinal, Pending{caller, callback});
+    remote_->Evaluate(ordinal, source.ToString(), base::BindOnce(
+        &CefNativeContextEvaluationImpl::OnReply, weak_.GetWeakPtr(), ordinal));
+  }
+
+  void Cancel(const CefString& nonce) override {
+    CEF_REQUIRE_UIT();
+    if (!live_) return;
+    for (const auto& [ordinal, pending] : pending_) {
+      if (pending.nonce == nonce.ToString()) {
+        remote_->Cancel(ordinal);
+        return;
+      }
+    }
+  }
+
+  void Invalidate() {
+    CEF_REQUIRE_UIT();
+    live_ = false;
+    remote_.reset();
+  }
+
+  void Close() {
+    CEF_REQUIRE_UIT();
+    CefRefPtr<CefNativeContextEvaluationImpl> keep_alive(this);
+    Invalidate();
+    auto pending = std::move(pending_);
+    for (auto& [ordinal, request] : pending)
+      request.callback->OnComplete(request.nonce, "stale_context", "Context released");
+  }
+
+ private:
+  struct Pending {
+    std::string nonce;
+    CefRefPtr<CefNativeContextEvaluationCallback> callback;
+  };
+  void OnReply(const std::string& ordinal, const std::string& reply_ordinal,
+               const std::string& code, const std::string& payload) {
+    if (!live_) return;
+    auto it = pending_.find(ordinal);
+    if (it == pending_.end()) return;
+    auto request = std::move(it->second);
+    pending_.erase(it);
+    if (ordinal != reply_ordinal) {
+      request.callback->OnComplete(request.nonce, "internal", "Evaluation reply identity mismatch");
+      return;
+    }
+    request.callback->OnComplete(request.nonce, code, payload);
+  }
+  bool live_ = true;
+  uint64_t next_ = 0;
+  base::WeakPtr<content::RenderFrameHostImpl> owner_;
+  const blink::DocumentToken document_;
+  std::map<std::string, Pending> pending_;
+  mojo::Remote<cef::mojom::NativeContextEvaluator> remote_;
+  base::WeakPtrFactory<CefNativeContextEvaluationImpl> weak_{this};
+  IMPLEMENT_REFCOUNTING_DELETE_ON_UIT(CefNativeContextEvaluationImpl);
+};
+#endif  // CEF_LIBCEF_BROWSER_NATIVE_CONTEXT_EVALUATION_H_
