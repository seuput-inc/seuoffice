+#if CEF_API_ADDED(15401)
+namespace {
+class HiddenPolicyIsolationTest : public TestHandler, public CefRenderHandler {
+ public:
+  explicit HiddenPolicyIsolationTest(bool native_window = false) : native_window_(native_window) {}
+  void RunTest() override {
+    AddResource("https://tests/disabled",
+                "<script>document.title='disabled:'+document.visibilityState</script>", "text/html");
+    AddResource("https://other.test/replacement",
+                "<script>document.title='replacement:'+document.visibilityState</script>", "text/html");
+    AddResource("https://tests/default",
+                "<script>document.title='default:'+document.visibilityState</script>", "text/html");
+    CefBrowserSettings settings;
+    settings.background_throttling = STATE_DISABLED;
+    StartBrowser("https://tests/disabled", settings);
+    SetTestTimeout(10000);
+  }
+  CefRefPtr<CefRenderHandler> GetRenderHandler() override { return this; }
+  void GetViewRect(CefRefPtr<CefBrowser>, CefRect& rect) override {
+    rect = CefRect(0, 0, 100, 100);
+  }
+  void OnPaint(CefRefPtr<CefBrowser>, PaintElementType, const RectList&,
+               const void*, int, int) override {}
+  void OnAfterCreated(CefRefPtr<CefBrowser> browser) override {
+    TestHandler::OnAfterCreated(browser);
+    if (!disabled_) disabled_ = browser;
+    else default_ = browser;
+#if defined(OS_WIN)
+    if (native_window_)
+      EXPECT_FALSE(::IsWindowVisible(browser->GetHost()->GetWindowHandle()));
+    else
+#endif
+      browser->GetHost()->WasHidden(true);
+  }
+  void OnTitleChange(CefRefPtr<CefBrowser> browser, const CefString& title) override {
+    const auto value = title.ToString();
+    if (value.rfind("disabled:", 0) == 0) {
+      EXPECT_EQ(disabled_->GetIdentifier(), browser->GetIdentifier());
+      EXPECT_EQ("disabled:visible", value);
+      if (!navigated_) {
+        navigated_ = true;
+        browser->GetMainFrame()->LoadURL("https://other.test/replacement");
+      }
+    } else if (value.rfind("replacement:", 0) == 0) {
+      EXPECT_EQ(disabled_->GetIdentifier(), browser->GetIdentifier());
+      EXPECT_EQ("replacement:visible", value);
+      if (!started_default_) {
+        started_default_ = true;
+        CefBrowserSettings settings;
+        StartBrowser("https://tests/default", settings);
+      }
+    } else if (value.rfind("default:", 0) == 0 && !closed_disabled_) {
+      ASSERT_TRUE(default_);
+      EXPECT_NE(disabled_->GetIdentifier(), default_->GetIdentifier());
+      EXPECT_EQ(default_->GetIdentifier(), browser->GetIdentifier());
+      EXPECT_EQ("default:hidden", value);
+      closed_disabled_ = true;
+      disabled_->GetHost()->CloseBrowser(true);
+      default_->GetMainFrame()->ExecuteJavaScript(
+          "document.title='after:'+document.visibilityState", "", 0);
+    } else if (value.rfind("after:", 0) == 0) {
+      EXPECT_EQ(default_->GetIdentifier(), browser->GetIdentifier());
+      EXPECT_EQ("after:hidden", value);
+      completed_ = true;
+      DestroyTest();
+    }
+  }
+  void DestroyTest() override {
+    EXPECT_TRUE(completed_);
+    TestHandler::DestroyTest();
+  }
+ private:
+  void StartBrowser(const CefString& url, const CefBrowserSettings& settings) {
+    CefWindowInfo info;
+#if defined(OS_WIN)
+    if (native_window_) {
+      info.SetAsPopup(kNullWindowHandle, "hidden-policy-test");
+      info.style &= ~WS_VISIBLE;
+      info.runtime_style = CEF_RUNTIME_STYLE_ALLOY;
+    } else
+#endif
+      info.SetAsWindowless(kNullWindowHandle);
+    EXPECT_TRUE(CefBrowserHost::CreateBrowser(info, this, url, settings, nullptr, nullptr));
+  }
+  CefRefPtr<CefBrowser> disabled_;
+  CefRefPtr<CefBrowser> default_;
+  const bool native_window_;
+  bool navigated_ = false;
+  bool started_default_ = false;
+  bool closed_disabled_ = false;
+  bool completed_ = false;
+  IMPLEMENT_REFCOUNTING(HiddenPolicyIsolationTest);
+};
+}  // namespace
