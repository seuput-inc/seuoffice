+// Copyright 2026 The Chromium Embedded Framework Authors.
+// Use of this source code is governed by a BSD-style license.
+#ifndef CEF_LIBCEF_RENDERER_NATIVE_V8_BRIDGE_TEST_H_
+#define CEF_LIBCEF_RENDERER_NATIVE_V8_BRIDGE_TEST_H_
+#include <string>
+#include "cef/libcef/renderer/native_v8_bridge.h"
+
+enum class CefNativeV8BridgeTestCase {
+  kReentrantRelease, kBorrowedBootstrap, kBorrowedMethod, kDuplicateBootstrap, kInitializationThrows, kMalformedBody
+};
+// The traffic fixture supplies a fresh real browser-admitted context per case.
+// Empty means success. This helper does not replace actual navigation/release tests.
+std::string CefRunNativeV8BridgeLifecycleTest(v8::Isolate* isolate,
+    v8::Local<v8::Context> context, CefRefPtr<CefNativeContextSender> sender,
+    CefNativeV8BridgeTestCase test_case);
+#endif  // CEF_LIBCEF_RENDERER_NATIVE_V8_BRIDGE_TEST_H_
diff --git a/libcef/renderer/native_v8_bridge_test.cc b/libcef/renderer/native_v8_bridge_test.cc
new file mode 100644
--- /dev/null
+++ b/libcef/renderer/native_v8_bridge_test.cc
@@ -0,0 +1,114 @@
+// Copyright 2026 The Chromium Embedded Framework Authors.
+// Use of this source code is governed by a BSD-style license.
+#include "cef/libcef/renderer/native_v8_bridge_test.h"
+#include <map>
+#include <memory>
+#include "base/no_destructor.h"
+
+namespace {
+using Bridge = CefNativeV8Bridge;
+std::map<uint64_t, std::weak_ptr<Bridge>>& Hooks() {
+  static base::NoDestructor<std::map<uint64_t, std::weak_ptr<Bridge>>> hooks;
+  return *hooks;
+}
+void ReleaseHook(const v8::FunctionCallbackInfo<v8::Value>& args) {
+  if (!args.Data()->IsBigInt()) return;
+  bool exact = false;
+  const auto id = args.Data().As<v8::BigInt>()->Uint64Value(&exact);
+  const auto it = Hooks().find(id);
+  if (exact && it != Hooks().end())
+    if (auto bridge = it->second.lock()) bridge->Release();
+}
+struct ScopedHook {
+  explicit ScopedHook(const std::shared_ptr<Bridge>& bridge) {
+    static uint64_t next = 0;
+    id = ++next;
+    Hooks().emplace(id, bridge);
+  }
+  ~ScopedHook() { Hooks().erase(id); }
+  uint64_t id;
+};
+v8::Local<v8::String> Text(v8::Isolate* isolate, const char* value) {
+  return v8::String::NewFromUtf8(isolate, value).ToLocalChecked();
+}
+bool True(v8::Isolate* isolate, v8::Local<v8::Context> context, const char* source) {
+  v8::TryCatch caught(isolate);
+  v8::Local<v8::Script> script;
+  v8::Local<v8::Value> value;
+  return v8::Script::Compile(context, Text(isolate, source)).ToLocal(&script) &&
+      script->Run(context).ToLocal(&value) && value->IsTrue();
+}
+}  // namespace
+
+std::string CefRunNativeV8BridgeLifecycleTest(v8::Isolate* isolate,
+    v8::Local<v8::Context> context, CefRefPtr<CefNativeContextSender> sender,
+    CefNativeV8BridgeTestCase test_case) {
+  if (!sender || !sender->IsAdmitted()) return "fixture context was not admitted";
+  v8::HandleScope handles(isolate);
+  v8::Context::Scope entered(context);
+  auto bridge = std::make_shared<Bridge>(isolate, context, sender, Bridge::Mode::kPreload);
+  if (!bridge->Install()) return "native bootstrap installation failed";
+  if (test_case == CefNativeV8BridgeTestCase::kInitializationThrows) {
+    if (bridge->ExecuteTrustedScripts({{"throw new Error('intentional init failure')", true}}, true))
+      return "initialization throw was accepted";
+    bridge->Release();
+    bridge->Release();
+    if (bridge->FinishInitialization() || bridge->Deliver(1, true, {}))
+      return "released initialization still accepted work";
+    return {};
+  }
+  if (test_case == CefNativeV8BridgeTestCase::kBorrowedBootstrap) {
+    v8::Local<v8::Value> value;
+    if (!context->Global()->Get(context, Text(isolate, "__seuofficeNativeBridgeBootstrap")).ToLocal(&value) ||
+        !value->IsFunction()) return "bootstrap was not a native function";
+    auto other = v8::Context::New(isolate);
+    {
+      v8::Context::Scope cross_frame(other);
+      v8::TryCatch caught(isolate);
+      const auto result = value.As<v8::Function>()->Call(other, v8::Undefined(isolate), 0, nullptr);
+      if (!result.IsEmpty() || !caught.HasCaught()) return "borrowed bootstrap crossed contexts";
+    }
+  }
+  const ScopedHook hook(bridge);
+  v8::Local<v8::Function> release;
+  if (!v8::Function::New(context, ReleaseHook, v8::BigInt::NewFromUnsigned(isolate, hook.id)).ToLocal(&release) ||
+      !context->Global()->DefineOwnProperty(context, Text(isolate, "__releaseBridgeTest"), release).FromMaybe(false))
+    return "release hook installation failed";
+  const char* initialize = test_case == CefNativeV8BridgeTestCase::kDuplicateBootstrap
+      ? "{const b=globalThis.__seuofficeNativeBridgeBootstrap;const n=b();delete globalThis.__seuofficeNativeBridgeBootstrap;let denied=false;try{b()}catch{denied=true}globalThis.__duplicateDenied=denied;n.listenTauri(()=>{}); }"
+      : "{const n=globalThis.__seuofficeNativeBridgeBootstrap();globalThis.__testNative=n;delete globalThis.__seuofficeNativeBridgeBootstrap;n.listenTauri((id,raw,body)=>{if(id!==7||!raw||!(body instanceof ArrayBuffer)||body.byteLength!==0)throw new Error('invalid empty Raw');globalThis.__releaseBridgeTest()}); }";
+  if (test_case == CefNativeV8BridgeTestCase::kMalformedBody)
+    initialize = "{const n=globalThis.__seuofficeNativeBridgeBootstrap();delete globalThis.__seuofficeNativeBridgeBootstrap;let count=0;try{n.invokeTauri('ipc_send',1,2,'application/octet-stream','invalid',{})}catch{count++}try{n.sendSync('webframe:get-zoom-factor',null)}catch{count++}globalThis.__malformedDenied=count;n.listenTauri(()=>{}); }";
+  if (!bridge->ExecuteTrustedScripts({{initialize, true}}, true) || !bridge->FinishInitialization())
+    return "trusted initialization failed";
+  if (test_case == CefNativeV8BridgeTestCase::kBorrowedMethod) {
+    v8::Local<v8::Value> object, function;
+    if (!context->Global()->Get(context, Text(isolate, "__testNative")).ToLocal(&object) ||
+        !object->IsObject() ||
+        !object.As<v8::Object>()->Get(context, Text(isolate, "sendSync")).ToLocal(&function) ||
+        !function->IsFunction()) return "native method was unavailable";
+    auto other = v8::Context::New(isolate);
+    v8::Context::Scope cross_frame(other);
+    v8::TryCatch caught(isolate);
+    v8::Local<v8::Value> args[] = {Text(isolate, "webframe:get-zoom-factor"), v8::ArrayBuffer::New(isolate, 0)};
+    const auto result = function.As<v8::Function>()->Call(other, v8::Undefined(isolate), 2, args);
+    if (!result.IsEmpty() || !caught.HasCaught()) return "borrowed native method crossed contexts";
+  }
+  if (test_case == CefNativeV8BridgeTestCase::kDuplicateBootstrap) {
+    if (!True(isolate, context, "globalThis.__duplicateDenied === true"))
+      return "duplicate bootstrap did not throw";
+  } else if (test_case == CefNativeV8BridgeTestCase::kMalformedBody) {
