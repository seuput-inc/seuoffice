+// Copyright 2026 The Chromium Embedded Framework Authors.
+// Use of this source code is governed by a BSD-style license.
+#ifndef CEF_LIBCEF_BROWSER_NATIVE_CONTEXT_SERVICE_H_
+#define CEF_LIBCEF_BROWSER_NATIVE_CONTEXT_SERVICE_H_
+
+#include <string>
+#include <utility>
+
+#include "cef/include/cef_client.h"
+#include "cef/libcef/browser/browser_info_manager.h"
+#include "cef/libcef/browser/frame_host_impl.h"
+#include "cef/libcef/browser/frame_service_base.h"
+#include "cef/libcef/common/mojom/cef.mojom.h"
+#include "content/browser/renderer_host/render_frame_host_impl.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/render_process_host.h"
+
+// One endpoint is bound directly by the BrowserInterfaceBroker for the RFH
+// that issued the receiver request. It is never the ordinary CEF frame queue.
+class CefNativeContextService final
+    : public CefFrameServiceBase<cef::mojom::NativeContextHost> {
+ public:
+  CefNativeContextService(
+      content::RenderFrameHost* host,
+      mojo::PendingReceiver<cef::mojom::NativeContextHost> receiver)
+      : CefFrameServiceBase(host, std::move(receiver)) {}
+
+  ~CefNativeContextService() override { Revoke(); }
+
+ private:
+  void Register(const blink::DocumentToken& document_token,
+                const blink::V8ContextToken& context_token,
+                int32_t world_id) override {
+    DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+    if (attempted_) return;
+    attempted_ = true;
+    auto* rfh = static_cast<content::RenderFrameHostImpl*>(render_frame_host());
+    if (world_id != 0 || rfh->GetParent() || !rfh->MatchesLatestDocumentForCef(document_token))
+      return;
+    auto frame = CefBrowserInfoManager::GetFrameHost(
+        rfh, /*prefer_speculative=*/true, /*browser_info=*/nullptr,
+        /*is_excluded=*/nullptr);
+    if (!frame || !frame->IsSameFrame(rfh)) return;
+    const auto frame_id = frame->GetIdentifier().ToString();
+    auto browser = frame->GetBrowser();
+    if (!browser || !browser->GetHost()) return;
+    auto client = browser->GetHost()->GetClient();
+    if (!client || !CEF_API_IS_ADDED(15401)) return;
+    browser_ = browser;
+    frame_ = frame;
+    frame_id_ = frame_id;
+    client_ = client;
+    child_id_ = rfh->GetProcess()->GetDeprecatedID();
+    document_ = document_token.ToString();
+    context_ = context_token.ToString();
+    world_ = world_id;
+    registered_ = true;
+    client->OnNativeContextRegistered(browser, frame, frame_id_, child_id_,
+                                      document_token.ToString(),
+                                      context_token.ToString(), world_id);
+  }
+
+  void DidStartNavigation(content::NavigationHandle* navigation) override {
+    if (navigation->GetFrameTreeNodeId() ==
+            render_frame_host()->GetFrameTreeNodeId() &&
+        !navigation->IsSameDocument()) Revoke();
+  }
+
+  void DidFinishNavigation(content::NavigationHandle* navigation) override {
+    if (navigation->GetFrameTreeNodeId() ==
+            render_frame_host()->GetFrameTreeNodeId() &&
+        !navigation->HasCommitted()) Revoke();
+  }
+
+  void RenderFrameHostChanged(content::RenderFrameHost* old_host,
+                              content::RenderFrameHost* new_host) override {
+    if (old_host == render_frame_host()) Revoke();
+  }
+
+  void Revoke() {
+    DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+    attempted_ = true;
+    if (!registered_) return;
+    registered_ = false;
+    auto client = std::move(client_);
+    auto browser = std::move(browser_);
+    auto frame = std::move(frame_);
+    auto document = std::move(document_);
+    auto context = std::move(context_);
+    client->OnNativeContextRevoked(browser, frame, frame_id_, child_id_, document,
+                                   context, world_);
+  }
+
+  bool attempted_ = false;
+  bool registered_ = false;
+  int child_id_ = 0;
+  int world_ = 0;
+  std::string frame_id_;
+  std::string document_;
+  std::string context_;
+  CefRefPtr<CefBrowser> browser_;
+  CefRefPtr<CefFrame> frame_;
+  CefRefPtr<CefClient> client_;
+};
+
+#endif  // CEF_LIBCEF_BROWSER_NATIVE_CONTEXT_SERVICE_H_
