+bool RenderFrameHostImpl::MatchesLatestDocumentForCef(
+    const blink::DocumentToken& document_token) const {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (IsPendingDeletion() || IsInBackForwardCache() ||
+      !frame_tree_node() || frame_tree_node()->navigation_request()) {
+    return false;
+  }
+  auto* manager = frame_tree_node()->render_manager();
+  auto* current = manager->current_frame_host();
+  auto* speculative = manager->speculative_frame_host();
+  if (this != current && this != speculative) {
+    return false;
+  }
+  auto* other = this == current ? speculative : current;
+  if (other && other->HasPendingCommitForCrossDocumentNavigation()) {
+    return false;
+  }
+  if (navigation_requests_.empty()) {
+    return this == current && IsActive() && IsRenderFrameLive() &&
+           frame_tree_node()->MatchesCefReadyDocument(GetGlobalFrameToken(),
+                                                       document_token) &&
+           GetDocumentToken() == document_token;
+  }
+  if (navigation_requests_.size() != 1) {
+    return false;
+  }
+  const auto& request = navigation_requests_.begin()->second;
+  return request->state() == NavigationRequest::READY_TO_COMMIT &&
+         frame_tree_node()->IsLatestNavigationForCef(request->GetNavigationId()) &&
+         frame_tree_node()->MatchesCefReadyDocument(GetGlobalFrameToken(),
+                                                     document_token) &&
+         request->GetRenderFrameHost() == this &&
+         request->GetDocumentToken() == document_token;
+}
