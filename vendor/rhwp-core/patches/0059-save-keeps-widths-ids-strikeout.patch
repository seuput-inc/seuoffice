+//! A save keeps what the edit did not touch: the streams of a file the strict compound-file
+//! reader refuses, and in an HWPX the paragraph ids and Hangul's "no strikeout" placeholder.
+#![cfg(not(target_arch = "wasm32"))]
+
+use std::io::{Cursor, Read, Write};
+
+use rhwp::document_core::DocumentCore;
+use rhwp::parser::cfb_reader::CfbReader;
+
+const FREE: u32 = 0xFFFF_FFFF;
+const END_OF_CHAIN: u32 = 0xFFFF_FFFE;
+const VENDOR: &str = "/Vendor/Opaque";
+const PAYLOAD: &[u8] = b"vendor-opaque-stream";
+const SECTION: &str = "Contents/section0.xml";
+const HEADER: &str = "Contents/header.xml";
+const HANGUL_ID: &str = "2147483648";
+
+fn two_paragraphs() -> DocumentCore {
+    let mut core = DocumentCore::new_empty();
+    core.create_blank_document_native().unwrap();
+    core.insert_text_native(0, 0, 0, "first paragraph").unwrap();
+    core.split_paragraph_native(0, 0, 15, None).unwrap();
+    core.insert_text_native(0, 1, 0, "second paragraph")
+        .unwrap();
+    core
+}
+
+/// Every stream of a compound file, by path.
+fn streams(bytes: &[u8]) -> Vec<(String, Vec<u8>)> {
+    let mut file = cfb::CompoundFile::open(Cursor::new(bytes.to_vec())).unwrap();
+    let paths: Vec<_> = file
+        .walk()
+        .filter(|entry| entry.is_stream())
+        .map(|entry| entry.path().to_path_buf())
+        .collect();
+    paths
+        .into_iter()
+        .map(|path| {
+            let mut data = Vec::new();
+            file.open_stream(&path)
+                .unwrap()
+                .read_to_end(&mut data)
+                .unwrap();
+            (path.to_string_lossy().replace('\\', "/"), data)
+        })
+        .collect()
+}
+
+/// The editor's document with a vendor stream in a storage of its own, its unused FAT slots
+/// marked "end of chain" as some writers leave them, and its stream paths (read before the
+/// slots change: the strict reader refuses the result).
+fn lenient_file() -> (Vec<u8>, Vec<String>) {
+    let bytes = two_paragraphs().export_hwp_native().unwrap();
+    let mut file = cfb::CompoundFile::open(Cursor::new(bytes)).unwrap();
+    file.create_storage("/Vendor").unwrap();
+    file.create_stream(VENDOR)
+        .unwrap()
+        .write_all(PAYLOAD)
+        .unwrap();
+    file.flush().unwrap();
+    let mut bytes = file.into_inner().into_inner();
+    let paths = streams(&bytes).into_iter().map(|(path, _)| path).collect();
+    let sector = 1usize << u16::from_le_bytes([bytes[30], bytes[31]]);
+    let first_fat = u32::from_le_bytes(bytes[76..80].try_into().unwrap()) as usize;
+    let fat = (first_fat + 1) * sector;
+    for at in (fat..fat + sector).step_by(4) {
+        if u32::from_le_bytes(bytes[at..at + 4].try_into().unwrap()) == FREE {
+            bytes[at..at + 4].copy_from_slice(&END_OF_CHAIN.to_le_bytes());
+        }
+    }
+    (bytes, paths)
+}
+
+#[test]
+fn a_file_the_strict_reader_refuses_keeps_its_streams_through_an_edit() {
+    let (source, paths) = lenient_file();
+    assert!(
+        CfbReader::open(&source).is_err(),
+        "the case needs the lenient reader"
+    );
+    let mut core = DocumentCore::from_bytes(&source).unwrap();
+    core.insert_text_native(0, 1, 0, "x").unwrap();
+    let saved = streams(&core.export_hwp_native().unwrap());
+
+    for path in paths {
+        assert!(saved.iter().any(|(p, _)| *p == path), "{path} lost: {saved:?}");
+    }
+    let vendor = saved.iter().find(|(p, _)| p == VENDOR).unwrap();
+    assert_eq!(vendor.1, PAYLOAD);
+}
+
+fn part(bytes: &[u8], name: &str) -> String {
+    let mut zip = zip::ZipArchive::new(Cursor::new(bytes)).unwrap();
+    let mut xml = String::new();
+    zip.by_name(name).unwrap().read_to_string(&mut xml).unwrap();
+    xml
+}
+
+fn with_parts(bytes: &[u8], parts: &[(&str, &str)]) -> Vec<u8> {
+    let mut input = zip::ZipArchive::new(Cursor::new(bytes)).unwrap();
+    let mut output = zip::ZipWriter::new(Cursor::new(Vec::new()));
+    for i in 0..input.len() {
+        let mut entry = input.by_index(i).unwrap();
+        let mut data = Vec::new();
+        entry.read_to_end(&mut data).unwrap();
+        let name = entry.name().unwrap().to_string();
+        if let Some((_, xml)) = parts.iter().find(|(part, _)| *part == name) {
+            data = xml.as_bytes().to_vec();
+        }
+        output
+            .start_file(
+                name,
+                zip::write::SimpleFileOptions::default().compression_method(entry.compression()),
+            )
+            .unwrap();
+        output.write_all(&data).unwrap();
+    }
+    output.finish().unwrap().into_inner()
+}
+
+/// The `<hp:p id>` values in document order.
+fn paragraph_ids(xml: &str) -> Vec<String> {
+    const OPEN: &str = "<hp:p id=\"";
+    xml.match_indices(OPEN)
+        .map(|(at, _)| {
+            let rest = &xml[at + OPEN.len()..];
+            rest[..rest.find('"').unwrap()].to_string()
+        })
+        .collect()
+}
+
+#[test]
+fn hwpx_save_keeps_paragraph_ids_and_the_no_strikeout_placeholder() {
+    let bytes = two_paragraphs().export_hwpx_native().unwrap();
+    // ids as Hangul writes them: repeated rather than numbered
+    let mut section = part(&bytes, SECTION);
+    let mut at = 0;
+    while let Some(found) = section[at..].find("<hp:p id=\"") {
+        let start = at + found + "<hp:p id=\"".len();
+        let end = start + section[start..].find('"').unwrap();
+        section.replace_range(start..end, HANGUL_ID);
+        at = start + HANGUL_ID.len();
+    }
+    let header = part(&bytes, HEADER).replacen(
+        r#"<hh:strikeout shape="NONE""#,
+        r#"<hh:strikeout shape="3D""#,
+        1,
+    );
+    let source = with_parts(&bytes, &[(SECTION, &section), (HEADER, &header)]);
+    let before = paragraph_ids(&section);
+
+    let mut core = DocumentCore::from_bytes(&source).unwrap();
+    let end = "second paragraph".len();
+    core.insert_text_native(0, 1, end, "x").unwrap();
+    core.split_paragraph_native(0, 1, end + 1, None).unwrap();
+    let saved = core.export_hwpx_native().unwrap();
+
+    let ids = paragraph_ids(&part(&saved, SECTION));
+    assert_eq!(ids.len(), before.len() + 1, "{ids:?}");
+    let kept = ids.iter().filter(|id| *id == HANGUL_ID).count();
+    assert_eq!(kept, before.len(), "{ids:?}");
+    assert!(part(&saved, HEADER).contains(r#"<hh:strikeout shape="3D""#));
+}
