+std::string CefRunNativeV8BridgeRestoreTest(v8::Isolate* isolate,
+    v8::Local<v8::Context> context, std::shared_ptr<CefNativeV8Bridge> bridge,
+    CefRefPtr<CefNativeContextSender> sender, CefNativeV8Bridge::Mode mode,
+    CefNativeV8BridgeRestoreTestCase test_case) {
+  if (!bridge || bridge->IsReleased() || !sender || !sender->IsAdmitted())
+    return "restore fixture lacks retained bridge or actual fresh native admission";
+  v8::HandleScope handles(isolate);
+  v8::Context::Scope entered(context);
+  if (test_case == CefNativeV8BridgeRestoreTestCase::kWrongContext) {
+    auto other = v8::Context::New(isolate);
+    if (bridge->Rebind(isolate, other, sender, mode))
+      return "a different V8 context rebound the retained bridge";
+    return {};
+  }
+  const bool restored = bridge->Rebind(isolate, context, sender, mode);
+  if (test_case == CefNativeV8BridgeRestoreTestCase::kMissingResumeAck ||
+      test_case == CefNativeV8BridgeRestoreTestCase::kReentrantResumeRelease) {
+    if (restored || !bridge->IsReleased())
+      return "refused or reentrantly released resume retained authority";
+    return {};
+  }
+  if (!restored) return "actual fresh native sender could not rebind the exact retained context";
+  if (bridge->Deliver(7, true, {})) return "native replies were delivered before post-thaw readiness";
+  if (test_case == CefNativeV8BridgeRestoreTestCase::kDuplicateRebind &&
+      bridge->Rebind(isolate, context, sender, mode))
+    return "one native restore admission rebound twice";
+  if (!bridge->RestoreReady()) return "post-thaw readiness was refused";
+  if (bridge->RestoreReady()) return "post-thaw readiness was acknowledged twice";
+  return {};
+}
