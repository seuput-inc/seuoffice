diff --git a/tests/cases/unknown_paragraph_records.rs b/tests/cases/unknown_paragraph_records.rs
new file mode 100644
index 000000000..e8f3a5eda
--- /dev/null
+++ b/tests/cases/unknown_paragraph_records.rs
@@ -0,0 +1,244 @@
+//! Records the parser does not model stay with the paragraph that owns them: an edit
+//! elsewhere rebuilds the section from the model and must still write them back unchanged.
+
+use std::io::{Cursor, Read, Write};
+
+use rhwp::document_core::DocumentCore;
+use rhwp::parser::cfb_reader::decompress_stream;
+use rhwp::parser::record::Record;
+use rhwp::parser::tags;
+use rhwp::serializer::record_writer::write_records;
+
+const SECTION: &str = "/BodyText/Section0";
+const OPAQUE_TAG: u16 = 0x3fe;
+
+fn opaque(level: u16, data: &[u8]) -> Record {
+    Record {
+        tag_id: OPAQUE_TAG,
+        level,
+        size: data.len() as u32,
+        data: data.to_vec(),
+    }
+}
+
+fn compressed(bytes: &[u8]) -> bool {
+    let mut file = cfb::CompoundFile::open(Cursor::new(bytes)).unwrap();
+    let mut header = Vec::new();
+    file.open_stream("/FileHeader")
+        .unwrap()
+        .read_to_end(&mut header)
+        .unwrap();
+    header[36] & 1 != 0
+}
+
+fn section_records(bytes: &[u8]) -> Vec<Record> {
+    let mut file = cfb::CompoundFile::open(Cursor::new(bytes)).unwrap();
+    let mut stream = Vec::new();
+    file.open_stream(SECTION)
+        .unwrap()
+        .read_to_end(&mut stream)
+        .unwrap();
+    let data = if compressed(bytes) {
+        decompress_stream(&stream).unwrap()
+    } else {
+        stream
+    };
+    Record::read_all(&data).unwrap()
+}
+
+fn with_section_records(bytes: &[u8], records: &[Record]) -> Vec<u8> {
+    let mut data = write_records(records);
+    if compressed(bytes) {
+        let mut encoder =
+            flate2::write::DeflateEncoder::new(Vec::new(), flate2::Compression::default());
+        encoder.write_all(&data).unwrap();
+        data = encoder.finish().unwrap();
+    }
+    let mut file = cfb::CompoundFile::open(Cursor::new(bytes.to_vec())).unwrap();
+    file.create_stream(SECTION)
+        .unwrap()
+        .write_all(&data)
+        .unwrap();
+    file.flush().unwrap();
+    file.into_inner().into_inner()
+}
+
+/// Index one past the last record of the subtree that starts at `start`.
+fn subtree_end(records: &[Record], start: usize) -> usize {
+    let level = records[start].level;
+    start
+        + 1
+        + records[start + 1..]
+            .iter()
+            .take_while(|r| r.level > level)
+            .count()
+}
+
+/// Indexes of the paragraph headers at `level`, in file order.
+fn paragraphs(records: &[Record], level: u16) -> Vec<usize> {
+    records
+        .iter()
+        .enumerate()
+        .filter(|(_, r)| r.tag_id == tags::HWPTAG_PARA_HEADER && r.level == level)
+        .map(|(i, _)| i)
+        .collect()
+}
+
+/// The child records of the paragraph whose header is at `header`.
+fn children(records: &[Record], header: usize) -> &[Record] {
+    &records[header + 1..subtree_end(records, header)]
+}
+
+fn same(a: &Record, b: &Record) -> bool {
+    a.tag_id == b.tag_id && a.level == b.level && a.data == b.data
+}
+
+/// Body paragraphs "first paragraph" and "second paragraph", as the app makes them.
+fn two_paragraphs() -> DocumentCore {
+    let mut core = DocumentCore::new_empty();
+    core.create_blank_document_native().unwrap();
+    core.insert_text_native(0, 0, 0, "first paragraph").unwrap();
+    core.split_paragraph_native(0, 0, 15, None).unwrap();
+    core.insert_text_native(0, 1, 0, "second paragraph")
+        .unwrap();
+    core
+}
+
+/// Puts `extra` right after the record at `after` and opens the result.
+fn insert_after(bytes: &[u8], after: usize, extra: &[Record]) -> (Vec<u8>, DocumentCore) {
+    let mut records = section_records(bytes);
+    for (offset, record) in extra.iter().enumerate() {
+        records.insert(after + 1 + offset, record.clone());
+    }
+    let bytes = with_section_records(bytes, &records);
+    let core = DocumentCore::from_bytes(&bytes).unwrap();
+    (bytes, core)
+}
+
+fn reopen(core: &DocumentCore) -> (Vec<u8>, DocumentCore) {
+    let bytes = core.export_hwp_native().unwrap();
+    let reopened = DocumentCore::from_bytes(&bytes).unwrap();
+    (bytes, reopened)
+}
+
+/// First paragraph with an opaque record right after its text and an opaque record with a
+/// child of its own as its last children.
+fn body_fixture() -> (DocumentCore, [Record; 3]) {
+    let base = two_paragraphs().export_hwp_native().unwrap();
+    let records = section_records(&base);
+    let first = paragraphs(&records, 0)[0];
+    let text = first
+        + 1
+        + children(&records, first)
+            .iter()
+            .position(|r| r.tag_id == tags::HWPTAG_PARA_TEXT)
+            .unwrap();
+    let after_text = opaque(1, b"after-text");
+    let (bytes, _) = insert_after(&base, text, std::slice::from_ref(&after_text));
+    let records = section_records(&bytes);
+    let last = subtree_end(&records, paragraphs(&records, 0)[0]) - 1;
+    let tail = [
+        opaque(1, b"vendor-opaque-metadata"),
+        opaque(2, b"child-of-opaque"),
+    ];
+    let (_, core) = insert_after(&bytes, last, &tail);
+    let [a, b] = tail;
+    (core, [after_text, a, b])
+}
+
+#[test]
+fn edit_in_another_paragraph_keeps_the_records_of_an_untouched_one() {
+    let (mut core, [after_text, tail, tail_child]) = body_fixture();
+
+    core.insert_text_native(0, 1, 0, "x").unwrap();
+    let (bytes, reopened) = reopen(&core);
+    let (bytes, _) = reopen(&reopened);
+
+    let records = section_records(&bytes);
+    let first = children(&records, paragraphs(&records, 0)[0]);
+    let text = first
+        .iter()
+        .position(|r| r.tag_id == tags::HWPTAG_PARA_TEXT)
+        .unwrap();
+    assert!(same(&first[text + 1], &after_text), "{:?}", first[text + 1]);
+    let n = first.len();
+    assert!(same(&first[n - 2], &tail), "{:?}", first[n - 2]);
+    assert!(same(&first[n - 1], &tail_child), "{:?}", first[n - 1]);
+    let opaque_count = records.iter().filter(|r| r.tag_id == OPAQUE_TAG).count();
+    assert_eq!(opaque_count, 3);
+}
+
+#[test]
+fn table_cell_paragraph_keeps_its_records_through_an_edit_elsewhere() {
+    let mut core = two_paragraphs();
+    core.create_table_native(0, 1, 0, 1, 1).unwrap();
+    let base = core.export_hwp_native().unwrap();
+    let records = section_records(&base);
+    let cell_para = records
+        .iter()
+        .position(|r| r.tag_id == tags::HWPTAG_PARA_HEADER && r.level > 0)
+        .expect("cell paragraph");
+    let level = records[cell_para].level + 1;
+    let record = opaque(level, b"cell-opaque");
+    let end = subtree_end(&records, cell_para) - 1;
+    let (_, mut core) = insert_after(&base, end, std::slice::from_ref(&record));
+
+    core.insert_text_native(0, 0, 0, "x").unwrap();
+    let (bytes, _) = reopen(&core);
+
+    let records = section_records(&bytes);
+    let cell_para = records
+        .iter()
+        .position(|r| r.tag_id == tags::HWPTAG_PARA_HEADER && r.level > 0)
+        .unwrap();
+    let kept = children(&records, cell_para);
+    assert!(kept.iter().any(|r| same(r, &record)), "{kept:?}");
+}
+
+#[test]
+fn deleting_the_owning_paragraph_removes_its_records() {
+    let (mut core, _) = body_fixture();
+
+    core.delete_paragraph_native(0, 0).unwrap();
+    let (bytes, _) = reopen(&core);
+
+    let records = section_records(&bytes);
+    assert!(records.iter().all(|r| r.tag_id != OPAQUE_TAG));
+}
+
+#[test]
+fn split_keeps_the_records_with_the_front_paragraph() {
+    let (mut core, [after_text, tail, tail_child]) = body_fixture();
+
+    core.split_paragraph_native(0, 0, 5, None).unwrap();
+    let (bytes, _) = reopen(&core);
+
+    let records = section_records(&bytes);
+    let paras = paragraphs(&records, 0);
+    let front = children(&records, paras[0]);
+    for record in [&after_text, &tail, &tail_child] {
+        assert!(front.iter().any(|r| same(r, record)), "{record:?}");
+    }
+    assert!(children(&records, paras[1])
+        .iter()
+        .all(|r| r.tag_id != OPAQUE_TAG));
+}
+
+#[test]
+fn merge_carries_the_back_paragraph_records_into_the_merged_one() {
+    let base = two_paragraphs().export_hwp_native().unwrap();
+    let records = section_records(&base);
+    let second = paragraphs(&records, 0)[1];
+    let record = opaque(1, b"back-paragraph");
+    let end = subtree_end(&records, second) - 1;
+    let (_, mut core) = insert_after(&base, end, std::slice::from_ref(&record));
+
+    core.merge_paragraph_native(0, 1).unwrap();
+    let (bytes, _) = reopen(&core);
+
+    let records = section_records(&bytes);
+    let paras = paragraphs(&records, 0);
+    assert_eq!(paras.len(), 1);
+    let merged = children(&records, paras[0]);
+    assert!(same(merged.last().unwrap(), &record), "{merged:?}");
+}
diff --git a/tests/cases/unknown_paragraph_xml.rs b/tests/cases/unknown_paragraph_xml.rs
new file mode 100644
index 000000000..b74987df9
--- /dev/null
+++ b/tests/cases/unknown_paragraph_xml.rs
@@ -0,0 +1,315 @@
+//! HWPX markup outside the OWPML namespaces in a paragraph (attributes of `<hp:p>`,
+//! elements under `<hp:p>` or `<hp:run>`) stays with that paragraph through edits elsewhere,
+//! save and reopen. Text inside such an element is not paragraph text.
+#![cfg(not(target_arch = "wasm32"))]
+
+use std::io::{Cursor, Read, Write};
+
+use rhwp::document_core::DocumentCore;
+
+const SECTION: &str = "Contents/section0.xml";
+const NS: &str = r#"xmlns:ext="urn:example:ext""#;
+const P_ATTRS: &str = r#"ext:mark="kept" data-x="1""#;
+const P_CHILD: &str = r#"<ext:note id="7">under-p</ext:note>"#;
+const RUN_CHILD: &str = r#"<ext:inRun><hp:t>leak</hp:t></ext:inRun>"#;
+// as saved: each kept element declares the foreign prefix it borrowed from the root
+const P_CHILD_KEPT: &str = r#"<ext:note xmlns:ext="urn:example:ext" id="7">under-p</ext:note>"#;
+const RUN_CHILD_KEPT: &str =
+    r#"<ext:inRun xmlns:ext="urn:example:ext"><hp:t>leak</hp:t></ext:inRun>"#;
+
+fn section_xml(bytes: &[u8]) -> String {
+    let mut zip = zip::ZipArchive::new(Cursor::new(bytes)).unwrap();
+    let mut xml = String::new();
+    zip.by_name(SECTION)
+        .unwrap()
+        .read_to_string(&mut xml)
+        .unwrap();
+    xml
+}
+
+fn with_section_xml(bytes: &[u8], xml: &str) -> Vec<u8> {
+    let mut input = zip::ZipArchive::new(Cursor::new(bytes)).unwrap();
+    let mut output = zip::ZipWriter::new(Cursor::new(Vec::new()));
+    for i in 0..input.len() {
+        let mut entry = input.by_index(i).unwrap();
+        let mut data = Vec::new();
+        entry.read_to_end(&mut data).unwrap();
+        let name = entry.name().unwrap().to_string();
+        if name == SECTION {
+            data = xml.as_bytes().to_vec();
+        }
+        output
+            .start_file(
+                name,
+                zip::write::SimpleFileOptions::default().compression_method(entry.compression()),
+            )
+            .unwrap();
+        output.write_all(&data).unwrap();
+    }
+    output.finish().unwrap().into_inner()
+}
+
+/// Byte ranges of the `<hp:p ...>...</hp:p>` elements, nested ones included.
+fn paragraphs(xml: &str) -> Vec<std::ops::Range<usize>> {
+    let mut open = Vec::new();
+    let mut out = Vec::new();
+    let mut at = 0;
+    while let Some(found) = xml[at..].find(['<']) {
+        let start = at + found;
+        if xml[start..].starts_with("<hp:p ") || xml[start..].starts_with("<hp:p>") {
+            open.push(start);
+        } else if xml[start..].starts_with("</hp:p>") {
+            let begin = open.pop().unwrap();
+            out.push(begin..start + "</hp:p>".len());
+        }
+        at = start + 1;
+    }
+    out.sort_by_key(|r| r.start);
+    out
+}
+
+/// Top-level paragraph `n` (not nested in a table).
+fn body_paragraph(xml: &str, n: usize) -> &str {
+    let all = paragraphs(xml);
+    let top: Vec<_> = all
+        .iter()
+        .filter(|r| {
+            !all.iter()
+                .any(|o| o != *r && o.start < r.start && r.end <= o.end)
+        })
+        .collect();
+    &xml[top[n].clone()]
+}
+
+fn two_paragraphs() -> DocumentCore {
+    let mut core = DocumentCore::new_empty();
+    core.create_blank_document_native().unwrap();
+    core.insert_text_native(0, 0, 0, "first paragraph").unwrap();
+    core.split_paragraph_native(0, 0, 15, None).unwrap();
+    core.insert_text_native(0, 1, 0, "second paragraph")
+        .unwrap();
+    core
+}
+
+/// Adds the foreign markup to the paragraph whose text run is `<hp:t>{text}</hp:t>`.
+fn add_foreign(core: &DocumentCore, text: &str) -> DocumentCore {
+    let bytes = core.export_hwpx_native().unwrap();
+    let mut xml = section_xml(&bytes);
+    let root = xml.find("<hs:sec ").unwrap() + "<hs:sec ".len();
+    xml.insert_str(root, &format!("{NS} "));
+    let t = format!("<hp:t>{text}</hp:t>");
+    let t_at = xml.find(&t).unwrap();
+    let p_start = xml[..t_at].rfind("<hp:p ").unwrap() + "<hp:p ".len();
+    xml.insert_str(t_at + t.len(), RUN_CHILD);
+    let p_end = xml[t_at..].find("</hp:p>").unwrap() + t_at;
+    xml.insert_str(p_end, P_CHILD);
+    xml.insert_str(p_start, &format!("{P_ATTRS} "));
+    DocumentCore::from_bytes(&with_section_xml(&bytes, &xml)).unwrap()
+}
+
+fn assert_kept(paragraph: &str) {
+    for part in [
+        P_CHILD_KEPT,
+        RUN_CHILD_KEPT,
+        r#"ext:mark="kept""#,
+        r#"data-x="1""#,
+        NS,
+    ] {
+        assert!(paragraph.contains(part), "{part} missing in {paragraph}");
+    }
+}
+
+fn saved(core: &DocumentCore) -> (String, DocumentCore) {
+    let bytes = core.export_hwpx_native().unwrap();
+    (
+        section_xml(&bytes),
+        DocumentCore::from_bytes(&bytes).unwrap(),
+    )
+}
