+TEST_F(RenderFrameHostImplTest, CefFactoryDocumentNestedScopesRestore) {
+  auto* host = main_test_rfh();
+  const blink::DocumentToken outer;
+  const blink::DocumentToken inner;
+  EXPECT_FALSE(host->GetScopedURLLoaderFactoryDocumentForCef());
+  {
+    RenderFrameHostImpl::ScopedCefFactoryDocument first(*host, outer);
+    EXPECT_EQ(outer, host->GetScopedURLLoaderFactoryDocumentForCef());
+    {
+      RenderFrameHostImpl::ScopedCefFactoryDocument second(*host, inner);
+      EXPECT_EQ(inner, host->GetScopedURLLoaderFactoryDocumentForCef());
+    }
+    EXPECT_EQ(outer, host->GetScopedURLLoaderFactoryDocumentForCef());
+    {
+      RenderFrameHostImpl::ScopedCefFactoryDocument untrusted(*host, std::nullopt);
+      EXPECT_FALSE(host->GetScopedURLLoaderFactoryDocumentForCef());
+    }
+    EXPECT_EQ(outer, host->GetScopedURLLoaderFactoryDocumentForCef());
+  }
+  EXPECT_FALSE(host->GetScopedURLLoaderFactoryDocumentForCef());
+}
+
+TEST_F(RenderFrameHostImplTest, CefFactoryDocumentIsBoundToExactFrame) {
+  auto* host = main_test_rfh();
+  auto* other = static_cast<RenderFrameHostImpl*>(
+      RenderFrameHostTester::For(host)->AppendChild("other"));
+  const blink::DocumentToken document;
+  {
+    RenderFrameHostImpl::ScopedCefFactoryDocument scope(*host, document);
+    EXPECT_EQ(document, host->GetScopedURLLoaderFactoryDocumentForCef());
+    EXPECT_FALSE(other->GetScopedURLLoaderFactoryDocumentForCef());
+  }
+  EXPECT_FALSE(host->GetScopedURLLoaderFactoryDocumentForCef());
+  EXPECT_FALSE(other->GetScopedURLLoaderFactoryDocumentForCef());
+}
+
+class CefFactoryCaptureClient : public ContentBrowserClient {
+ public:
+  void WillCreateURLLoaderFactory(
+      BrowserContext*, RenderFrameHost* frame, int, URLLoaderFactoryType,
+      const url::Origin&, const net::IsolationInfo&, std::optional<int64_t>,
+      ukm::SourceIdObj, network::URLLoaderFactoryBuilder&,
+      mojo::PendingRemote<network::mojom::TrustedURLLoaderHeaderClient>*,
+      bool*, bool*, network::mojom::URLLoaderFactoryOverridePtr*,
+      scoped_refptr<base::SequencedTaskRunner>, bool) override {
+    observed = frame ? RenderFrameHostImpl::From(frame)
+                           ->GetScopedURLLoaderFactoryDocumentForCef()
+                     : std::nullopt;
+  }
+  std::optional<blink::DocumentToken> observed;
+};
+
+TEST_F(RenderFrameHostImplTest, CefFactoryCallbackUsesCapturedNotCurrentDocument) {
+  auto* host = main_test_rfh();
+  const blink::DocumentToken pending;
+  ASSERT_NE(pending, host->GetDocumentToken());
+  CefFactoryCaptureClient client;
+  auto* previous_client = SetBrowserClientForTesting(&client);
+  const auto origin = url::Origin::Create(GURL("https://factory.example"));
+  const net::IsolationInfo isolation;
+  auto params = url_loader_factory::ContentClientParams(
+      contents()->GetBrowserContext(), host, host->GetProcess()->GetDeprecatedID(),
+      origin, isolation, ukm::kInvalidSourceIdObj).WithCefDocumentToken(pending);
+  network::URLLoaderFactoryBuilder builder;
+  params.Run(builder, ContentBrowserClient::URLLoaderFactoryType::kDocumentSubResource,
+             nullptr, nullptr, nullptr, false);
+  EXPECT_EQ(pending, client.observed);
+  EXPECT_FALSE(host->GetScopedURLLoaderFactoryDocumentForCef());
+
+  auto worker = url_loader_factory::ContentClientParams(
+      contents()->GetBrowserContext(), host, host->GetProcess()->GetDeprecatedID(),
+      origin, isolation, ukm::kInvalidSourceIdObj).WithCefDocumentToken(pending);
+  worker.Run(builder, ContentBrowserClient::URLLoaderFactoryType::kWorkerSubResource,
+             nullptr, nullptr, nullptr, false);
+  EXPECT_FALSE(client.observed);
+  EXPECT_FALSE(host->GetScopedURLLoaderFactoryDocumentForCef());
+  SetBrowserClientForTesting(previous_client);
+}
+
 }  // namespace content
