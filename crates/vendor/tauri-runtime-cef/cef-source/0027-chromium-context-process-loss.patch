# Pinned Chromium source-only patch. No generated ABI or native execution proof.
diff --git a/content/browser/renderer_host/frame_tree_node.h b/content/browser/renderer_host/frame_tree_node.h
--- a/content/browser/renderer_host/frame_tree_node.h
+++ b/content/browser/renderer_host/frame_tree_node.h
@@ -360,5 +360,19 @@
   [[nodiscard]] base::CallbackListSubscription AddCefPreNavigationRevoker(
       base::RepeatingCallback<void(RenderFrameHostImpl*, std::vector<base::OnceClosure>*)> callback) {
     return cef_pre_navigation_revokers_.Add(std::move(callback));
   }
+  // Process-loss claims run before ordinary document revokers, under the same
+  // mutation scope. They may only claim exact native state and append deferred
+  // completion; no client callback or nested loop is permitted here.
+  [[nodiscard]] base::CallbackListSubscription AddCefPreProcessLossObserver(
+      base::RepeatingCallback<void(RenderFrameHostImpl*, std::vector<base::OnceClosure>*)> callback) {
+    return cef_pre_process_loss_observers_.Add(std::move(callback));
+  }
+  void NotifyCefPreProcessLoss(RenderFrameHostImpl* host) {
+    std::vector<base::OnceClosure> completions;
+    cef_pre_process_loss_observers_.Notify(host, &completions);
+    for (auto& completion : completions) {
+      DeferCefAdmissionCompletion(std::move(completion));
+    }
+  }
   struct CefAdmissionMutationState {
@@ -983,3 +998,5 @@
   base::RepeatingCallbackList<void(RenderFrameHostImpl*, std::vector<base::OnceClosure>*)>
       cef_pre_navigation_revokers_;
+  base::RepeatingCallbackList<void(RenderFrameHostImpl*, std::vector<base::OnceClosure>*)>
+      cef_pre_process_loss_observers_;
   std::optional<int64_t> cef_latest_navigation_id_;
