+class ApprovedHistoryCompletion {
+ public:
+  explicit ApprovedHistoryCompletion(
+      CefRefPtr<CefApprovedHistoryNavigationCallback> callback)
+      : callback_(std::move(callback)) {}
+  ~ApprovedHistoryCompletion() { Finish(CEF_APPROVED_HISTORY_CANCELLED); }
+  void Finish(cef_approved_history_navigation_outcome_t outcome) {
+    auto callback = std::move(callback_);
+    if (callback) callback->OnComplete(outcome);
+  }
+
+ private:
+  CefRefPtr<CefApprovedHistoryNavigationCallback> callback_;
+};
+
+enum class ApprovedHistoryAction { kReload, kReloadIgnoreCache, kBack, kForward };
+
+void RunApprovedHistory(
+    CefRefPtr<CefBrowserHostBase> host, ApprovedHistoryAction action,
+    uint64_t issuance, const CefString& intent,
+    CefRefPtr<CefApprovedHistoryNavigationCallback> callback) {
+  CEF_REQUIRE_UIT();
+  if (!callback) return;
+  auto completion = std::make_unique<ApprovedHistoryCompletion>(std::move(callback));
+  if (host->WillBeDestroyed() || !host->GetWebContents() || intent.empty()) return;
+  auto* approval = CefApprovedNavigation::GetOrCreate(host->GetWebContents());
+  auto command = approval->ReserveCommand(
+      issuance, intent.ToString(),
+      base::BindOnce(
+          [](std::unique_ptr<ApprovedHistoryCompletion> completion,
+             content::NavigationController::CefHistoryOutcome outcome) {
+            using Outcome = content::NavigationController::CefHistoryOutcome;
+            switch (outcome) {
+              case Outcome::kStartedCrossDocument:
+                completion->Finish(CEF_APPROVED_HISTORY_STARTED_CROSS_DOCUMENT);
+                return;
+              case Outcome::kSameDocumentOrNoop:
+                completion->Finish(CEF_APPROVED_HISTORY_SAME_DOCUMENT_OR_NOOP);
+                return;
+              case Outcome::kCancelled:
+                completion->Finish(CEF_APPROVED_HISTORY_CANCELLED);
+                return;
+            }
+          }, std::move(completion)));
+  if (!command) return;
+  auto browser_info = host->browser_info();
+  base::OnceClosure navigate = base::BindOnce(
+      [](CefRefPtr<CefBrowserHostBase> host, ApprovedHistoryAction action,
+         std::unique_ptr<content::NavigationController::CefHistoryCommand> command) {
+        if (host->WillBeDestroyed() || !host->GetWebContents()) return;
+        auto& controller = host->GetWebContents()->GetController();
+        switch (action) {
+          case ApprovedHistoryAction::kReload:
+            controller.ReloadWithCefHistoryCommand(content::ReloadType::NORMAL,
+                                                   true, std::move(command));
+            return;
+          case ApprovedHistoryAction::kReloadIgnoreCache:
+            controller.ReloadWithCefHistoryCommand(content::ReloadType::BYPASSING_CACHE,
+                                                   true, std::move(command));
+            return;
+          case ApprovedHistoryAction::kBack:
+            controller.GoBackWithCefHistoryCommand(std::move(command));
+            return;
+          case ApprovedHistoryAction::kForward:
+            controller.GoForwardWithCefHistoryCommand(std::move(command));
+            return;
+        }
+      }, std::move(host), action, std::move(command));
+  if (browser_info->DeferNavigationIfLocked(navigate)) return;
+  std::move(navigate).Run();
+}
