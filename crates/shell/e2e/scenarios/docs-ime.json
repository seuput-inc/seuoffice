{
  "steps": [
    {
      "op": "open",
      "path": "${WORK}/docs-ime.docx"
    },
    {
      "op": "waitReady",
      "timeoutMs": 60000
    },
    {
      "op": "wait",
      "ms": 800
    },
    {
      "op": "query",
      "as": "prep-comp",
      "js": "(() => { if (window.__comp) return true; window.__comp = []; for (const type of ['keydown', 'compositionstart', 'compositionupdate', 'compositionend', 'beforeinput', 'input']) document.addEventListener(type, (e) => window.__comp.push(type + ':' + (type === 'keydown' ? e.key + '/' + e.keyCode : (e.data === undefined || e.data === null ? '' : e.data) + '/' + (e.inputType || ''))), true); return true })()"
    },
    {
      "op": "ime",
      "source": "ko-2set",
      "keys": "gksrmf"
    },
    {
      "op": "wait",
      "ms": 800
    },
    {
      "op": "query",
      "as": "diag-docs-composition",
      "js": "(window.__comp || []).join(' | ')"
    },
    {
      "op": "query",
      "as": "ime-before",
      "js": "document.querySelector('.editor-scroll .ProseMirror')?.textContent ?? null"
    },
    {
      "op": "shortcut",
      "name": "save"
    },
    {
      "op": "wait",
      "ms": 2500
    },
    {
      "op": "shortcut",
      "name": "closeTab"
    },
    {
      "op": "wait",
      "ms": 1000
    },
    {
      "op": "open",
      "path": "${WORK}/docs-ime.docx"
    },
    {
      "op": "waitReady",
      "timeoutMs": 60000
    },
    {
      "op": "wait",
      "ms": 800
    },
    {
      "op": "query",
      "as": "ime-after",
      "js": "document.querySelector('.editor-scroll .ProseMirror')?.textContent ?? null"
    }
  ]
}
