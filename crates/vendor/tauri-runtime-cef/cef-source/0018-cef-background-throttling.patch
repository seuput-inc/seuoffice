+#if CEF_API_ADDED(15401)
+TEST(BrowserSettingsTest, BackgroundThrottlingCopiesAndOldStructDefaults) {
+  CefBrowserSettings defaults;
+  EXPECT_EQ(STATE_DEFAULT, defaults.background_throttling);
+
+  CefBrowserSettings disabled;
+  disabled.background_throttling = STATE_DISABLED;
+  CefBrowserSettings copied = disabled;
+  EXPECT_EQ(STATE_DISABLED, copied.background_throttling);
+
+  CefBrowserSettings enabled;
+  enabled.background_throttling = STATE_ENABLED;
+  copied = enabled;
+  EXPECT_EQ(STATE_ENABLED, copied.background_throttling);
+
+  cef_browser_settings_t old_settings{};
+  old_settings.size = offsetof(cef_browser_settings_t, background_throttling);
+  old_settings.background_throttling = STATE_DISABLED;
+  copied = old_settings;
+  EXPECT_EQ(STATE_DEFAULT, copied.background_throttling);
+}
+#endif
