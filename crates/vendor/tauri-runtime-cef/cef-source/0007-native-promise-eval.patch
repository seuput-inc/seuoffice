+// Copyright 2026 The Chromium Embedded Framework Authors.
+// Use of this source code is governed by a BSD-style license.
+#ifndef CEF_LIBCEF_RENDERER_NATIVE_CONTEXT_EVALUATOR_H_
+#define CEF_LIBCEF_RENDERER_NATIVE_CONTEXT_EVALUATOR_H_
+
+#include <memory>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "v8/include/v8.h"
+
+// Renderer-thread-only. One instance belongs to one captured V8 context.
+class CefNativeContextEvaluator final {
+ public:
+  using Reply = base::OnceCallback<void(std::string, std::string, std::string)>;
+
+  CefNativeContextEvaluator(v8::Isolate* isolate, v8::Local<v8::Context> context);
+  ~CefNativeContextEvaluator();
+  CefNativeContextEvaluator(const CefNativeContextEvaluator&) = delete;
+  CefNativeContextEvaluator& operator=(const CefNativeContextEvaluator&) = delete;
+
+  // Nonce is a canonical decimal nonzero ordinal increasing on this pipe.
+  void Evaluate(std::string nonce, std::string source, Reply reply);
+  void Cancel(const std::string& nonce);
+  void Release();
+
+ private:
+  class State;
+  std::shared_ptr<State> state_;
+};
+
+#endif  // CEF_LIBCEF_RENDERER_NATIVE_CONTEXT_EVALUATOR_H_
diff --git a/libcef/renderer/native_context_evaluator.cc b/libcef/renderer/native_context_evaluator.cc
