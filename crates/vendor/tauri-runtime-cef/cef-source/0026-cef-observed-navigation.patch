+  ///
+  /// Browser-owned, one-shot observation of the original approved navigation.
+  /// It conveys no V8 context or IPC authority. A failed or cancelled
+  /// navigation has |committed| false and no document/process. The issuance
+  /// and observer nonce are native-only correlation data, never renderer input.
+  /// Error code is the original net error, or ERR_FAILED when native receipt
+  /// construction fails after a nominally successful commit.
+  ///
+  /*--cef(added=15401)--*/
+  virtual void OnNativeObservedNavigation(
+      CefRefPtr<CefBrowser> browser, uint64_t issuance,
+      const CefString& observer_nonce, bool committed, int error_code, const CefString& url,
+      const CefString& document, CefRefPtr<CefNativeRendererProcess> process) {}
 #endif
 };
diff --git a/libcef/browser/browser_contents_delegate.cc b/libcef/browser/browser_contents_delegate.cc
