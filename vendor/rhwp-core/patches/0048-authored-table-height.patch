+    #[test]
+    fn authored_table_height_survives_measurement_and_drives_the_next_resize() {
+        fn table(doc: &DocumentCore, index: usize) -> &crate::model::table::Table {
+            match &doc.document().sections[0].paragraphs[0].controls[index] {
+                Control::Table(table) => table,
+                _ => panic!("expected table"),
+            }
+        }
+        let mut edited = saved_page_of_table(2);
+        let mut reference = saved_page_of_table(2);
+        let ci = table_control(&edited);
+        let reference_ci = table_control(&reference);
+        let authored = table(&edited, ci).authored_height();
+        for projected in [authored + 900, authored + 2400] {
+            let px = crate::renderer::hwpunit_to_px(projected as i32, edited.dpi);
+            assert!(edited.sync_tac_host_row(0, 0, ci, px));
+            assert_eq!(table(&edited, ci).common.height, projected);
+            assert_eq!(table(&edited, ci).authored_height(), authored);
+            let field = crate::model::shape::common_obj_offsets::HEIGHT;
+            assert_eq!(&table(&edited, ci).raw_ctrl_data[field], &projected.to_le_bytes());
+            host_row_holds_table(&edited, ci);
+        }
+        let change = r#"[{"cellIdx":0,"heightDelta":600},{"cellIdx":1,"heightDelta":600}]"#;
+        reference
+            .resize_table_cells_native(0, 0, reference_ci, change)
+            .unwrap();
+        edited.resize_table_cells_native(0, 0, ci, change).unwrap();
+        let expected = table(&reference, reference_ci).authored_height();
+        assert!(expected > authored);
+        assert_eq!(table(&edited, ci).authored_height(), expected);
     }
 
     #[test]
