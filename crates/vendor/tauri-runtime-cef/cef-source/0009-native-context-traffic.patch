diff --git a/libcef/browser/native_context_traffic.h b/libcef/browser/native_context_traffic.h
new file mode 100644
--- /dev/null
+++ b/libcef/browser/native_context_traffic.h
@@ -0,0 +1,126 @@
+// Copyright 2026 The Chromium Embedded Framework Authors.
+// Use of this source code is governed by a BSD-style license.
+#ifndef CEF_LIBCEF_BROWSER_NATIVE_CONTEXT_TRAFFIC_H_
+#define CEF_LIBCEF_BROWSER_NATIVE_CONTEXT_TRAFFIC_H_
+
+#include <atomic>
+#include <map>
+#include <memory>
+#include <utility>
+#include <vector>
+#include "base/functional/bind.h"
+#include "base/synchronization/lock.h"
+#include "base/task/bind_post_task.h"
+#include "cef/include/cef_client.h"
+#include "cef/libcef/browser/thread_util.h"
+#include "cef/libcef/common/mojom/cef.mojom.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+class CefNativeContextSyncReplyImpl final : public CefNativeContextSyncReply {
+ public:
+  using Reply = cef::mojom::NativeContextHost::SendSyncCallback;
+  using Completion = base::OnceCallback<void(bool, std::vector<uint8_t>)>;
+  CefNativeContextSyncReplyImpl(Reply reply, std::weak_ptr<std::atomic<bool>> live)
+      : reply_(base::BindPostTask(CEF_TASK_RUNNER<CEF_UIT>(), base::BindOnce(
+            [](Reply reply, std::weak_ptr<std::atomic<bool>> live,
+               bool accepted, std::vector<uint8_t> bytes) {
+              auto gate = live.lock();
+              if (!gate || !gate->load()) { accepted = false; bytes.clear(); }
+              std::move(reply).Run(accepted, bytes);
+            }, std::move(reply), std::move(live)))) {}
+  void Complete(bool accepted, CefRefPtr<CefBinaryValue> body) override {
+    std::vector<uint8_t> bytes;
+    if (accepted && body) {
+      bytes.resize(body->GetSize());
+      if (!bytes.empty() && body->GetData(bytes.data(), bytes.size(), 0) != bytes.size())
+        accepted = false;
+    }
+    Completion reply;
+    {
+      base::AutoLock lock(lock_);
+      if (!reply_) return;
+      reply = std::move(reply_);
+    }
+    std::move(reply).Run(accepted, std::move(bytes));
+  }
+  bool IsPending() {
+    base::AutoLock lock(lock_);
+    return !!reply_;
+  }
+ private:
+  ~CefNativeContextSyncReplyImpl() override { Complete(false, nullptr); }
+  base::Lock lock_;
+  Completion reply_;
+  IMPLEMENT_REFCOUNTING(CefNativeContextSyncReplyImpl);
+};
+
+class CefNativeContextChannelImpl final : public CefNativeContextChannel {
+ public:
+  explicit CefNativeContextChannelImpl(
+      mojo::PendingRemote<cef::mojom::NativeContextReplies> replies)
+      : replies_(std::move(replies)) {}
+
+  bool Reply(uint32_t callback, bool raw, CefRefPtr<CefBinaryValue> body) override {
+    CEF_REQUIRE_UIT_RETURN(false);
+    if (!live_ || !listening_ || !replies_.is_connected()) return false;
+    std::vector<uint8_t> bytes(body ? body->GetSize() : 0);
+    if (!bytes.empty() && body->GetData(bytes.data(), bytes.size(), 0) != bytes.size())
+      return false;
+    replies_->Reply(callback, raw, std::move(bytes));
+    return true;
+  }
+
+  bool ReplyChannel(uint32_t callback, uint64_t index, bool raw,
+                    CefRefPtr<CefBinaryValue> body, bool end) override {
+    CEF_REQUIRE_UIT_RETURN(false);
+    if (!live_ || !listening_ || !replies_.is_connected()) return false;
+    std::vector<uint8_t> bytes(body ? body->GetSize() : 0);
+    if (!bytes.empty() && body->GetData(bytes.data(), bytes.size(), 0) != bytes.size())
+      return false;
+    replies_->ReplyChannel(callback, index, raw, std::move(bytes), end);
+    return true;
+  }
+
+  bool Listen() {
+    CEF_REQUIRE_UIT_RETURN(false);
+    if (!live_ || listening_ || !replies_.is_connected()) return false;
+    listening_ = true;
+    return true;
+  }
+  bool IsLive() const { return live_; }
+
+  CefRefPtr<CefNativeContextSyncReplyImpl> AddSync(
+      cef::mojom::NativeContextHost::SendSyncCallback reply) {
+    CEF_REQUIRE_UIT_RETURN(nullptr);
+    // A NoInterrupt renderer call cannot recursively issue another sync call.
+    if (!live_ || (sync_ && sync_->IsPending())) {
+      std::move(reply).Run(false, {});
+      return nullptr;
+    }
+    auto request = CefRefPtr<CefNativeContextSyncReplyImpl>(
+        new CefNativeContextSyncReplyImpl(std::move(reply), live_gate_));
+    sync_ = request;
+    return request;
+  }
+
+  void Invalidate() {
+    CEF_REQUIRE_UIT();
+    if (!live_) return;
+    live_ = false;
+    live_gate_->store(false);
+    listening_ = false;
+    replies_.reset();
+    auto pending = std::move(sync_);
+    if (pending) pending->Complete(false, nullptr);
+  }
+
+  ~CefNativeContextChannelImpl() override { Invalidate(); }
+ private:
+  bool live_ = true;
+  bool listening_ = false;
+  std::shared_ptr<std::atomic<bool>> live_gate_ = std::make_shared<std::atomic<bool>>(true);
+  mojo::Remote<cef::mojom::NativeContextReplies> replies_;
+  CefRefPtr<CefNativeContextSyncReplyImpl> sync_;
+  IMPLEMENT_REFCOUNTING_DELETE_ON_UIT(CefNativeContextChannelImpl);
+};
+#endif  // CEF_LIBCEF_BROWSER_NATIVE_CONTEXT_TRAFFIC_H_
diff --git a/libcef/renderer/native_context_sender.h b/libcef/renderer/native_context_sender.h
new file mode 100644
--- /dev/null
+++ b/libcef/renderer/native_context_sender.h
@@ -0,0 +1,168 @@
+// Copyright 2026 The Chromium Embedded Framework Authors.
+// Use of this source code is governed by a BSD-style license.
+#ifndef CEF_LIBCEF_RENDERER_NATIVE_CONTEXT_SENDER_H_
+#define CEF_LIBCEF_RENDERER_NATIVE_CONTEXT_SENDER_H_
+
+#include <deque>
+#include <tuple>
+#include "base/command_line.h"
+#include "content/public/common/content_switches.h"
+#include "content/public/renderer/render_thread.h"
+#include <string>
+#include <utility>
+#include <vector>
+#include "base/functional/callback.h"
+#include "cef/include/cef_render_process_handler.h"
+#include "cef/libcef/common/mojom/cef.mojom.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "third_party/blink/public/web/web_local_frame.h"
+#include "v8/include/v8.h"
+
+class CefNativeContextSenderImpl final : public CefNativeContextSender,
+                                        public cef::mojom::NativeContextReplies {
+ public:
+  CefNativeContextSenderImpl(std::string document, std::string context, int world,
+      base::RepeatingCallback<bool(uint32_t, bool, const std::vector<uint8_t>&, bool, uint64_t, bool)> reply)
+      : document_(std::move(document)), context_(std::move(context)), world_(world),
+        native_reply_(std::move(reply)), receiver_(this) {}
+
+  mojo::PendingReceiver<cef::mojom::NativeContextHost> BindHost() {
+    return host_.BindNewPipeAndPassReceiver();
+  }
+  mojo::PendingRemote<cef::mojom::NativeContextReplies> BindReplies() {
+    return receiver_.BindNewPipeAndPassRemote();
+  }
+  bool Register(const blink::DocumentToken& document,
+      const blink::V8ContextToken& context,
+      mojo::PendingRemote<cef::mojom::NativeContextEvaluator> evaluator) {
+    if (!content::RenderThread::Get() ||
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(switches::kProcessType)
+          != switches::kRendererProcess) { Release(); return false; }
+    bool admitted = false;
+    int32_t child = 0;
+    std::string url;
+    if (!host_->Register(document, context, world_, std::move(evaluator),
+          BindReplies(), &admitted, &child, &url, &trusted_mode_, &browser_pid_, &initialization_) || !admitted || child <= 0) {
+      Release();
+      return false;
+    }
+    admitted_ = true;
+    document_url_ = std::move(url);
+    return true;
+  }
+  int trusted_mode() const { return trusted_mode_; }
+  uint32_t browser_pid() const { return browser_pid_; }
+  const std::string& initialization() const { return initialization_; }
+
+  bool SetReady() {
+    CefRefPtr<CefNativeContextSenderImpl> keep_alive(this);
+    if (!IsAdmitted() || ready_) return false;
+    ready_ = true;
+    while (!pending_replies_.empty()) {
+      auto reply = std::move(pending_replies_.front());
+      pending_replies_.pop_front();
+      if (!IsAdmitted() || !native_reply_.Run(std::get<0>(reply), std::get<1>(reply), std::get<2>(reply),
+                                            std::get<3>(reply), std::get<4>(reply), std::get<5>(reply))) {
+        Release();
+        return false;
+      }
+    }
+    if (layout_pending_) FirstNonEmptyLayout();
+    return IsAdmitted();
+  }
+
+  void FirstNonEmptyLayout() {
+    if (!IsAdmitted() || layout_sent_) return;
+    if (!ready_) { layout_pending_ = true; return; }
+    layout_sent_ = true;
+    host_->FirstNonEmptyLayout();
+  }
+
+  bool IsAdmitted() override { return admitted_ && host_.is_connected(); }
+  CefString GetDocumentURL() override { return document_url_; }
+  bool Listen() override {
+    if (!ExactEntry()) return false;
+    host_->Listen();
+    return true;
+  }
+  bool SendTauri(const CefString& cmd, uint32_t callback, uint32_t error,
+      bool raw, const CefString& invoke_key, const CefString& headers_json,
+      CefRefPtr<CefBinaryValue> body) override {
+    if (!ExactEntry()) return false;
+    std::vector<uint8_t> bytes(body ? body->GetSize() : 0);
+    if (!bytes.empty() && body->GetData(bytes.data(), bytes.size(), 0) != bytes.size())
+      return false;
+    host_->SendTauri(cmd.ToString(), callback, error, raw, invoke_key.ToString(),
+                     headers_json.ToString(), std::move(bytes));
+    return true;
+  }
+  bool SendSync(const CefString& channel, CefRefPtr<CefBinaryValue> body,
+                CefRefPtr<CefBinaryValue>& result) override {
+    result = nullptr;
+    if (!ExactEntry()) return false;
+    std::vector<uint8_t> bytes(body ? body->GetSize() : 0);
+    if (!bytes.empty() && body->GetData(bytes.data(), bytes.size(), 0) != bytes.size())
+      return false;
+    // ExactEntry's V8 locals have gone out of scope. NoInterrupt restricts
+    // this wait to the exact reply; there is no nested RunLoop or V8 delivery.
+    bool accepted = false;
+    std::vector<uint8_t> response;
+    if (!host_->SendSync(channel.ToString(), std::move(bytes), &accepted, &response) || !accepted)
+      return false;
+    if (!response.empty()) result = CefBinaryValue::Create(response.data(), response.size());
+    return response.empty() || !!result;
+  }
+  void Release() {
+    admitted_ = false;
+    ready_ = false;
+    pending_replies_.clear();
+    receiver_.reset();
+    host_.reset();
+    native_reply_.Reset();
+  }
+
+ private:
+  bool ExactEntry() {
+    if (!IsAdmitted() || world_ != 0) return false;
+    auto* isolate = v8::Isolate::TryGetCurrent();
+    if (!isolate) return false;
+    v8::HandleScope scope(isolate);
+    auto current = isolate->GetCurrentContext();
+    auto entered = isolate->GetEnteredOrMicrotaskContext();
+    if (current.IsEmpty() || entered.IsEmpty() || current != entered) return false;
+    auto token = blink::WebLocalFrame::ContextToken(current);
+    return token && token->ToString() == context_;
+  }
+  void Reply(uint32_t callback, bool raw, const std::vector<uint8_t>& body) override {
+    DispatchReply(callback, raw, body, false, 0, false);
+  }
+  void ReplyChannel(uint32_t callback, uint64_t index, bool raw,
+                    const std::vector<uint8_t>& body, bool end) override {
+    DispatchReply(callback, raw, body, true, index, end);
+  }
+  void DispatchReply(uint32_t callback, bool raw, const std::vector<uint8_t>& body,
+                     bool indexed, uint64_t index, bool end) {
+    CefRefPtr<CefNativeContextSenderImpl> keep_alive(this);
+    if (!IsAdmitted() || !native_reply_) return;
+    if (!ready_) { pending_replies_.emplace_back(callback, raw, body, indexed, index, end); return; }
+    if (!native_reply_.Run(callback, raw, body, indexed, index, end)) Release();
+  }
+  const std::string document_;
+  const std::string context_;
+  const int world_;
+  bool admitted_ = false;
+  bool ready_ = false;
+  bool layout_pending_ = false;
+  bool layout_sent_ = false;
+  std::deque<std::tuple<uint32_t, bool, std::vector<uint8_t>, bool, uint64_t, bool>> pending_replies_;
+  std::string document_url_;
+  int trusted_mode_ = 0;
+  uint32_t browser_pid_ = 0;
+  std::string initialization_;
+  base::RepeatingCallback<bool(uint32_t, bool, const std::vector<uint8_t>&, bool, uint64_t, bool)> native_reply_;
+  mojo::Remote<cef::mojom::NativeContextHost> host_;
+  mojo::Receiver<cef::mojom::NativeContextReplies> receiver_;
+  IMPLEMENT_REFCOUNTING(CefNativeContextSenderImpl);
+};
+#endif  // CEF_LIBCEF_RENDERER_NATIVE_CONTEXT_SENDER_H_
