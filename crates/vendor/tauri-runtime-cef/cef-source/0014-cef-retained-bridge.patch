+CefRefPtr<CefNativeContextSenderImpl> CefRenderFrameObserver::CreateNativeSender(
+    const std::string& document, const std::string& context, int world) {
+  return new CefNativeContextSenderImpl(document, context, world,
+      base::BindRepeating(
+          [](CefRenderFrameObserver* observer, const std::string& token,
+             uint32_t callback, bool raw, const std::vector<uint8_t>& bytes,
+             bool indexed, uint64_t index, bool end) {
+            const auto it = observer->native_bridges_.find(token);
+            if (it == observer->native_bridges_.end()) return false;
+            auto bridge = it->second;
+            return indexed ? bridge->DeliverChannel(callback, index, raw, bytes, end)
+                           : bridge->Deliver(callback, raw, bytes);
+          }, base::Unretained(this), context));
+}
+
+bool CefRenderFrameObserver::AbortNativeRestore(
+    const std::string& context, bool separate_renderer) {
+  restored_context_.reset();
+  if (const auto it = native_bridges_.find(context); it != native_bridges_.end())
+    it->second->Release();
+  if (const auto it = native_context_senders_.find(context); it != native_context_senders_.end())
+    it->second->Release();
+  if (const auto it = native_context_evaluators_.find(context); it != native_context_evaluators_.end())
+    it->second->Release();
+  if (separate_renderer) base::Process::TerminateCurrentProcessImmediately(1);
+  return false;
+}
+
+bool CefRenderFrameObserver::WillRestoreFromBackForwardCache() {
+  if (!frame_ || !render_frame()) return false;
+  auto* frame = render_frame()->GetWebFrame();
+  if (!frame) return false;
+  auto browser = CefBrowserImpl::GetBrowserForMainFrame(frame->Top());
+  if (!browser) return false;
+  const int creation_mode = browser->native_context_mode();
+  // Only the actual browser-constructor's explicit unprotected role may skip
+  // native re-admission. Failed registration never downgrades a protected role.
+  if (creation_mode == 0) return native_bridges_.empty();
+  if (creation_mode != 1 && creation_mode != 2) return false;
+  auto* scheduler = frame->GetAgentGroupScheduler();
+  if (!scheduler) return false;
+  auto* isolate = scheduler->Isolate();
+  if (!isolate) return false;
+  v8::Isolate::Scope isolated(isolate);
+  v8::HandleScope handles(isolate);
+  auto context = frame->MainWorldScriptContext();
+  const auto document = frame->GetDocument();
+  if (context.IsEmpty() || document.IsNull() ||
+      blink::WebLocalFrame::FrameForContext(context) != frame) return false;
+  const auto token = blink::WebLocalFrame::ContextToken(context);
+  if (!token) return false;
+  const auto key = token->ToString();
+  const auto identity = native_contexts_.find(key);
+  auto old_sender = native_context_senders_.find(key);
+  auto old_evaluator = native_context_evaluators_.find(key);
+  auto retained = native_bridges_.find(key);
+  if (identity == native_contexts_.end() || identity->second.second != 0 ||
+      identity->second.first != document.Token().ToString() ||
+      old_sender == native_context_senders_.end() ||
+      old_evaluator == native_context_evaluators_.end() ||
+      retained == native_bridges_.end() || retained->second->IsReleased())
+    return AbortNativeRestore(key, false);
+  auto bridge = retained->second;
+  const uint32_t old_browser_pid = old_sender->second->browser_pid();
+  const bool separate_renderer = old_browser_pid != 0 &&
+      old_browser_pid != static_cast<uint32_t>(base::GetCurrentProcId()) &&
+      content::RenderThread::Get() &&
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          switches::kProcessType) == switches::kRendererProcess;
+  if (!separate_renderer || restored_context_)
+    return AbortNativeRestore(key, separate_renderer);
+  old_sender->second->Release();
+  old_evaluator->second->Release();
+  auto sender = CreateNativeSender(identity->second.first, key, 0);
+  auto evaluator = std::make_unique<CefNativeContextEvaluatorMojo>(isolate, context);
+  auto remote = evaluator->BindNewPipeAndPassRemote();
+  native_context_senders_[key] = sender;
+  native_context_evaluators_[key] = std::move(evaluator);
+  render_frame()->GetBrowserInterfaceBroker().GetInterface(sender->BindHost());
+  // Register redeems the browser's exact newly approved restore lineage. It
+  // does not reuse the old sender, admission token, evaluator pipe or intent.
+  if (!sender->Register(document.Token(), *token, std::move(remote)) ||
+      sender->trusted_mode() != creation_mode || sender->browser_pid() != old_browser_pid)
+    return AbortNativeRestore(key, separate_renderer);
+  const auto mode = creation_mode == 1 ? CefNativeV8Bridge::Mode::kInvoke
+                                      : CefNativeV8Bridge::Mode::kPreload;
+  auto alive = weak_factory_.GetWeakPtr();
+  const bool rebound = bridge->Rebind(isolate, context, sender, mode);
+  if (!alive) {
+    sender->Release();
+    bridge->Release();
+    base::Process::TerminateCurrentProcessImmediately(1);
+    return false;
+  }
+  if (!rebound || !frame_) return AbortNativeRestore(key, separate_renderer);
+  restored_context_ = key;
+  return true;
+}
+
+void CefRenderFrameObserver::DidSetPageLifecycleState(blink::BFCacheStateChange change) {
+  if (change != blink::BFCacheStateChange::kRestoredFromBFCache || !restored_context_) return;
+  const auto token = std::move(*restored_context_);
+  restored_context_.reset();
+  const auto sending = native_context_senders_.find(token);
+  const auto retained = native_bridges_.find(token);
+  if (sending == native_context_senders_.end() || retained == native_bridges_.end()) {
+    AbortNativeRestore(token, false);
+    return;
+  }
+  auto sender = sending->second;
+  auto bridge = retained->second;
+  const uint32_t browser_pid = sender->browser_pid();
+  const bool separate_renderer = browser_pid != 0 &&
+      browser_pid != static_cast<uint32_t>(base::GetCurrentProcId()) &&
+      content::RenderThread::Get() &&
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          switches::kProcessType) == switches::kRendererProcess;
+  if (!bridge->RestoreReady() || !sender->SetReady()) {
+    // SetReady may run JavaScript that destroys this observer. Retained native
+    // locals are the only objects consulted after it starts delivering replies.
+    sender->Release();
+    bridge->Release();
+    if (separate_renderer) base::Process::TerminateCurrentProcessImmediately(1);
+  }
+}
