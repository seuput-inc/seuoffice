+#[test]
+fn foreign_elements_bound_on_the_run_or_by_default_stay_out_of_the_text() {
+    let bytes = two_paragraphs().export_hwpx_native().unwrap();
+    let mut xml = section_xml(&bytes);
+    let t = "<hp:t>first paragraph</hp:t>";
+    let at = xml.find(t).unwrap() + t.len();
+    xml.insert_str(
+        at,
+        r#"<x:note><hp:t>leak</hp:t></x:note><note xmlns="urn:vendor2"><hp:t>leak2</hp:t></note>"#,
+    );
+    let run = xml[..at].rfind("<hp:run").unwrap() + "<hp:run".len();
+    xml.insert_str(run, r#" xmlns:x="urn:vendor""#);
+    let core = DocumentCore::from_bytes(&with_section_xml(&bytes, &xml)).unwrap();
+    assert_eq!(
+        core.document().sections[0].paragraphs[0].text,
+        "first paragraph"
+    );
+
+    let (xml, reopened) = saved(&core);
+    let first = body_paragraph(&xml, 0);
+    for part in [
+        r#"<x:note xmlns:x="urn:vendor"><hp:t>leak</hp:t></x:note>"#,
+        r#"<note xmlns="urn:vendor2"><hp:t>leak2</hp:t></note>"#,
+    ] {
+        assert!(first.contains(part), "{part} missing in {first}");
+    }
+    assert_eq!(
+        reopened.document().sections[0].paragraphs[0].text,
+        "first paragraph"
+    );
+}
