diff --git a/libcef/renderer/render_frame_observer.cc b/libcef/renderer/render_frame_observer.cc
--- a/libcef/renderer/render_frame_observer.cc
+++ b/libcef/renderer/render_frame_observer.cc
@@ -82,3 +82,15 @@
 void CefRenderFrameObserver::DidFinishLoad() {
+  if (render_frame()) {
+    const auto document = render_frame()->GetWebFrame()->GetDocument();
+    if (!document.IsNull()) {
+      const auto document_token = document.Token().ToString();
+      for (const auto& [token, identity] : native_contexts_) {
+        if (identity.first != document_token || identity.second != 0) continue;
+        auto found = native_context_senders_.find(token);
+        if (found != native_context_senders_.end()) found->second->DocumentReady();
+        break;
+      }
+    }
+  }
   if (frame_) {
     frame_->OnDidFinishLoad();
