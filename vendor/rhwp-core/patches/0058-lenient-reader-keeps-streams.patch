+/// The text of a PrvText stream (UTF-16LE), or None when it holds none.
+pub(crate) fn decode_preview_text(data: &[u8]) -> Option<String> {
+    if data.len() < 2 {
+        return None;
+    }
+
+    let text: String = data
+        .chunks(2)
+        .filter_map(|chunk| {
+            if chunk.len() == 2 {
+                let code = u16::from_le_bytes([chunk[0], chunk[1]]);
+                char::from_u32(code as u32)
+            } else {
+                None
+            }
+        })
+        .collect();
+
+    if text.is_empty() {
+        None
+    } else {
+        Some(text)
+    }
+}
