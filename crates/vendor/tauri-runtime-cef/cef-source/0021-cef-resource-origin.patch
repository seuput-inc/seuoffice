+
+CefRefPtr<CefNativeResourceDelivery> CefRequestImpl::GetNativeResourceDelivery() {
+  base::AutoLock lock_scope(lock_);
+  return native_resource_delivery_;
+}
+
+void CefRequestImpl::SetNativeResource(
+    std::shared_ptr<const CefNativeResourceOriginState> origin,
+    CefRefPtr<CefNativeResourceDeliveryImpl> delivery) {
+  base::AutoLock lock_scope(lock_);
+  native_resource_origin_ = std::move(origin);
+  native_resource_delivery_ = std::move(delivery);
+}
+
+CefRefPtr<CefNativeResourceDeliveryImpl> CefRequestImpl::native_resource_delivery() const {
+  base::AutoLock lock_scope(lock_);
+  return native_resource_delivery_;
+}
+
+std::shared_ptr<const CefNativeResourceOriginState> CefRequestImpl::native_resource_origin() const {
+  base::AutoLock lock_scope(lock_);
+  return native_resource_origin_;
+}
