   // Browser-only query. The intent must never be sent to the renderer.
+  // Consume the observation independently of protected context registration.
+  // The NavigationUIData object is browser-owned and survives redirects; no
+  // URL, current frame, or renderer-provided value selects this receipt.
+  std::optional<std::pair<uint64_t, std::string>> TakeObservation(
+      content::NavigationHandle* navigation) {
+    CEF_REQUIRE_UIT_RETURN(std::nullopt);
+    if (!navigation || !navigation->IsInPrimaryMainFrame() ||
+        navigation->IsSameDocument() || navigation->IsRendererInitiated() ||
+        navigation->IsPrerenderedPageActivation()) return std::nullopt;
+    base::AutoLock lock(state_->data_lock);
+    const auto* data = navigation->GetNavigationUIData();
+    const auto found = state_->data.find(data);
+    if (found == state_->data.end()) return std::nullopt;
+    const auto issuance = found->second.issuance;
+    const auto started = state_->observation_navigation.find(issuance);
+    const auto nonce = state_->observation_nonce.find(issuance);
+    if (started == state_->observation_navigation.end() ||
+        started->second != navigation->GetNavigationId() ||
+        nonce == state_->observation_nonce.end() ||
+        !state_->observed.insert(issuance).second) return std::nullopt;
+    return std::make_pair(issuance, nonce->second);
+  }
+
+  // Browser close claims every still-pending original navigation exactly
+  // once. No current-frame lookup is needed to retire an incomplete load.
+  std::vector<std::pair<uint64_t, std::string>> TakeClosedObservations() {
+    CEF_REQUIRE_UIT_RETURN({});
+    std::vector<std::pair<uint64_t, std::string>> result;
+    base::AutoLock lock(state_->data_lock);
+    for (const auto& [issuance, navigation_id] : state_->observation_navigation) {
+      const auto nonce = state_->observation_nonce.find(issuance);
+      if (nonce != state_->observation_nonce.end() &&
+          state_->observed.insert(issuance).second) {
+        result.emplace_back(issuance, nonce->second);
+      }
+    }
+    state_->observation_navigation.clear();
+    state_->observation_nonce.clear();
+    return result;
+  }
+
