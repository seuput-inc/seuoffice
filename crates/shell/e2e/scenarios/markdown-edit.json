{
  "steps": [
    {
      "op": "open",
      "path": "${WORK}/markdown.md"
    },
    {
      "op": "waitReady",
      "timeoutMs": 60000
    },
    {
      "op": "wait",
      "ms": 800
    },
    {
      "op": "query",
      "as": "prep-focus",
      "js": "(() => { const e = document.querySelector('.ProseMirror'); if (!e || e.textContent.length === 0) return false; e.focus(); return true })()"
    },
    {
      "op": "wait",
      "ms": 300
    },
    {
      "op": "type",
      "text": "SEU-E2E-markdown"
    },
    {
      "op": "wait",
      "ms": 300
    },
    {
      "op": "query",
      "as": "markdown-before",
      "js": "document.querySelector('.ProseMirror')?.textContent ?? null"
    },
    {
      "op": "shortcut",
      "name": "save"
    },
    {
      "op": "wait",
      "ms": 2500
    },
    {
      "op": "shortcut",
      "name": "closeTab"
    },
    {
      "op": "wait",
      "ms": 1000
    },
    {
      "op": "open",
      "path": "${WORK}/markdown.md"
    },
    {
      "op": "waitReady",
      "timeoutMs": 60000
    },
    {
      "op": "wait",
      "ms": 800
    },
    {
      "op": "query",
      "as": "markdown-after",
      "js": "document.querySelector('.ProseMirror')?.textContent ?? null"
    },
    {
      "op": "exportPdf",
      "path": "${WORK}/markdown-export.pdf"
    },
    {
      "op": "screenshot",
      "name": "markdown-after"
    }
  ]
}
