+      [&](RenderFrameHostImpl* affected,
+          std::vector<base::OnceClosure>* completions) {
+        ++before;
+        completions->push_back(base::BindOnce(
+            [](GlobalRenderFrameHostId original, int* after) {
+              EXPECT_EQ(nullptr, RenderFrameHost::FromID(original));
+              ++*after;
+            }, original, &after));
+      }));
+  DeleteContents();
+  EXPECT_GT(before, 0);
+  EXPECT_EQ(before, after);
+}
