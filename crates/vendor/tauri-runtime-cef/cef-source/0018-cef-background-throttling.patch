+TEST(BrowserSettingsTest, HiddenPolicyIsPerBrowserAndSurvivesOtherClose) {
+  CefRefPtr<HiddenPolicyIsolationTest> handler = new HiddenPolicyIsolationTest();
+  handler->ExecuteTest();
+  ReleaseAndWaitForDestructor(handler);
+}
