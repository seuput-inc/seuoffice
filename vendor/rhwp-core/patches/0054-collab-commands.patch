+    fn split_control_moves(&self, char_offset: usize, control_positions: &[usize], split_pos: usize, kept_number: Option<usize>) -> Vec<bool> {
+        self
+            .controls
+            .iter()
+            .enumerate()
+            .map(|(ci, ctrl)| {
+                ((Self::is_split_movable_control(ctrl)
+                    && control_positions.get(ci).copied().unwrap_or(usize::MAX) >= char_offset)
+                    || self
+                        .field_ranges
+                        .iter()
+                        .any(|fr| fr.control_idx == ci && fr.start_char_idx >= split_pos))
+                    && Some(ci) != kept_number
+            })
+            .collect()
+    }
+
+    pub(crate) fn collab_table_split(&self, offset: usize) -> Option<(usize, Vec<bool>)> {
+        let length = self.text.chars().count();
+        if self.controls.len() > 4096 || offset > length + self.controls.iter().filter(|c| Self::occupies_split_slot(c)).count() { return None; }
+        let positions = self.split_logical_control_positions();
+        let scalar = self.split_text_pos_for_logical_offset(offset, &positions);
+        let kept = (scalar == length).then(|| self.trailing_auto_number(&self.control_text_positions())).flatten();
+        Some((scalar, self.split_control_moves(offset, &positions, scalar, kept)))
+    }
