+/// Binds `ext` to `uri` on the paragraph holding `text`, with an attribute and a run child.
+fn bind_on_paragraph(xml: &mut String, text: &str, uri: &str, attr: &str, child: &str) {
+    let t = format!("<hp:t>{text}</hp:t>");
+    let t_at = xml.find(&t).unwrap();
+    xml.insert_str(t_at + t.len(), &format!("<ext:{child}/>"));
+    let p = xml[..t_at].rfind("<hp:p ").unwrap() + "<hp:p".len();
+    xml.insert_str(p, &format!(r#" xmlns:ext="{uri}" ext:{attr}="1""#));
+}
