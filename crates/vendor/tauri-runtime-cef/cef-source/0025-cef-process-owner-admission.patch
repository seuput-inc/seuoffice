+  bool PermitsTermination(const std::vector<CefString>& documents) override {
+    CEF_REQUIRE_UIT_RETURN(false);
+    if (!host_ || documents.empty() || documents.size() > 256 ||
+        !host_->GetProcess().IsValid() || host_->GetProcess().Pid() != pid_ ||
+        static_cast<content::RenderProcessHostImpl*>(host_)->HasUnrepresentedOwnersForCef())
+      return false;
+    std::set<std::string> retired;
+    for (const auto& document : documents) retired.insert(document.ToString());
+    bool accepted = true;
+    size_t observed = 0;
+    host_->ForEachRenderFrameHost([&](content::RenderFrameHost* frame) {
+      ++observed;
+      auto* root = frame->GetOutermostMainFrame();
+      auto browser = root ? CefBrowserHostBase::GetBrowserForHost(root) : nullptr;
+      if (!browser) { accepted = false; return; }
+      const auto* root_impl = static_cast<content::RenderFrameHostImpl*>(root);
+      const std::string key = base::NumberToString(browser->GetIdentifier()) + ":" +
+          root_impl->GetDocumentToken().ToString();
+      if (!retired.contains(key)) accepted = false;
+    });
+    // ForEachRenderFrameHost skips speculative and destructing RFHs. Never
+    // interpret their absence as permission to terminate an unseen owner.
+    return accepted && observed > 0 &&
+        observed == static_cast<size_t>(host_->GetRenderFrameHostCount());
+  }
   bool ObserveExit(CefRefPtr<CefNativeRendererProcessCallback> callback) override {
