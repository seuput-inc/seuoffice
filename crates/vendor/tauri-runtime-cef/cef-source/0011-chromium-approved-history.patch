+  ASSERT_TRUE(request->IsServedFromBackForwardCache());
+  EXPECT_EQ(1, receipt->bindings);
+  EXPECT_EQ(request->GetNavigationId(), receipt->navigation_id);
+  EXPECT_NE(nullptr, request->GetNavigationUIData());
+  auto back = NavigationSimulator::CreateFromPending(controller_impl());
+  back->ReadyToCommit();
+  ASSERT_TRUE(request);
+  EXPECT_EQ(frame, request->GetRenderFrameHost()->GetGlobalFrameToken());
+  EXPECT_EQ(document, request->GetRenderFrameHost()->GetDocumentToken());
+  EXPECT_TRUE(root_ftn()->MatchesCefReadyDocument(frame, document));
+  back->Commit();
+  EXPECT_EQ((std::vector<Outcome>{Outcome::kStartedCrossDocument}),
+            receipt->outcomes);
+}
