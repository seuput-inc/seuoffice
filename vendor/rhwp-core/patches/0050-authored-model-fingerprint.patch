+    out.value(&(*format as u8));
+}
+
+fn properties_raw(out: &mut DigestWriter, _: &DocProperties, raw: &Option<Vec<u8>>) {
+    out.value(&raw.is_some());
+    if let Some(raw) = raw {
+        // HWP DOCUMENT_PROPERTIES stores the local caret in bytes 14..26.
+        out.value(&(raw.len() as u64));
+        out.blob(&raw[..14.min(raw.len())]);
+        out.blob(raw.get(26..).unwrap_or_default());
+    }
+}
+
+fn table_header(out: &mut DigestWriter, table: &Table, common: &CommonObjAttr, raw: &[u8]) {
+    macro_rules! except_height {
+        ($($field:ident),+) => {{
+            let CommonObjAttr { height: _, $($field),+ } = common;
+            $(out.value($field);)+
+        }};
+    }
+    except_height!(
+        cell_frame_paint, cell_border_paint, outside_cell_border_paint, ctrl_id, attr,
+        vertical_offset, horizontal_offset, width, z_order, margin, instance_id,
+        prevent_page_break, treat_as_char, flow_with_text, allow_overlap,
+        affect_line_spacing, size_protect, hwp5_gen_shape_attr_bit28, vert_rel_to,
+        vert_align, horz_rel_to, horz_align, text_wrap, text_flow, width_criterion,
+        height_criterion, description, numbering_type, drop_cap_style, raw_extra, locked
+    );
+    out.value(&table.authored_height());
+    out.value(&table.authored_raw_height());
+    let height = common_obj_offsets::HEIGHT;
+    if raw.len() >= height.end {
+        out.blob(&raw[..height.start]);
+        out.blob(&raw[height.end..]);
+    } else {
+        out.blob(raw);
+    }
+}
+
+fn named_parts(out: &mut DigestWriter, parts: &[(String, Vec<u8>)]) {
+    let mut parts: Vec<_> = parts.iter().collect();
+    // Preserve order between duplicate paths: the first match is observable.
+    parts.sort_by(|a, b| a.0.cmp(&b.0));
+    out.value(&(parts.len() as u64));
+    for (path, bytes) in parts {
+        out.value(path);
+        out.blob(bytes);
+    }
+}
+
+impl Document {
+    pub fn collab_fingerprint(&self) -> Result<String, &'static str> {
+        let Self { header, doc_properties, doc_info, sections, preview, bin_data_content,
+            extra_streams, hwpx_aux_entries, is_hwp3_variant, is_hwpx_variant, provenance } = self;
+        let mut out = DigestWriter::new();
+        out.value("rhwp-authored-v2");
+        header.authored(&mut out);
+        doc_properties.authored(&mut out);
+        doc_info.authored(&mut out);
+        sections.authored(&mut out);
+        preview.authored(&mut out);
+        out.value(&(bin_data_content.len() as u64));
+        for BinDataContent { id, extension, data } in bin_data_content {
+            out.value(id);
+            out.value(extension);
+            match data {
+                BinDataBytes::Loaded(bytes) => out.blob(bytes),
+                BinDataBytes::Lazy { .. } => {
+                    let bytes = data.load_limited_shared(MAX_BIN_DATA_BYTES)
+                        .ok_or("Cannot fingerprint unreadable or oversized BinData")?;
+                    out.blob(&bytes);
+                }
+            }
+        }
+        named_parts(&mut out, extra_streams);
+        named_parts(&mut out, hwpx_aux_entries);
+        out.value(is_hwp3_variant);
+        out.value(is_hwpx_variant);
+        provenance.authored(&mut out);
+        Ok(blake3::Hash::from_bytes(out.finish()).to_hex().to_string())
+    }
+}
