+    /// Every stream under the root storage as a `/Storage/Name` path, found by following
+    /// the directory tree down from the root entry, as `CfbReader::list_streams` gives them.
+    pub fn list_streams(&self) -> Vec<String> {
+        let mut paths = Vec::new();
+        let Some(root) = self
+            .directory_entries
+            .iter()
+            .position(|entry| entry.obj_type == 5)
+        else {
+            return paths;
+        };
+        let mut visited = std::collections::HashSet::new();
+        visited.insert(root);
+        let mut pending = vec![(self.directory_entries[root].child, String::new())];
+        while let Some((entry_id, parent)) = pending.pop() {
+            if entry_id == Self::END_OF_CHAIN || entry_id == Self::FREE_SECT {
+                continue;
+            }
+            let entry_id = entry_id as usize;
+            if !visited.insert(entry_id) {
+                continue;
+            }
+            let Some(entry) = self.directory_entries.get(entry_id) else {
+                continue;
+            };
+            pending.push((entry.left_sibling, parent.clone()));
+            pending.push((entry.right_sibling, parent.clone()));
+            let path = format!("{}/{}", parent, entry.name);
+            match entry.obj_type {
+                1 => pending.push((entry.child, path)),
+                2 => paths.push(path),
+                _ => {}
+            }
+        }
+        paths
+    }
+
+    /// `CfbReader::read_preview_image_limited`: the picture only when the directory declares
+    /// 1..=`max_bytes` bytes for it and the chain holds all of them.
+    pub fn read_preview_image_limited(&self, max_bytes: usize) -> Option<Vec<u8>> {
+        let entry_id = self.find_entry_id("/PrvImage")?;
+        let declared_size = usize::try_from(self.directory_entries.get(entry_id)?.size).ok()?;
+        if declared_size == 0 || declared_size > max_bytes {
+            return None;
+        }
+        let data = self
+            .read_directory_stream_limited(entry_id, "/PrvImage", max_bytes)
+            .ok()?;
+        (data.len() == declared_size).then_some(data)
+    }
+
+    pub fn read_preview_text(&self) -> Option<String> {
+        decode_preview_text(&self.read_stream("/PrvText").ok()?)
+    }
