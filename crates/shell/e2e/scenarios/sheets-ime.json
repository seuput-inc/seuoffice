{
  "steps": [
    {
      "op": "open",
      "path": "${WORK}/sheets-ime.xlsx"
    },
    {
      "op": "waitReady",
      "timeoutMs": 60000
    },
    {
      "op": "wait",
      "ms": 1000
    },
    {
      "op": "query",
      "as": "prep-goto",
      "js": "window.__seuofficeControl?.({cmd:'goto',target:{kind:'range',range:'A1'}}) ?? null"
    },
    {
      "op": "wait",
      "ms": 500
    },
    {
      "op": "type",
      "text": "x"
    },
    {
      "op": "wait",
      "ms": 400
    },
    {
      "op": "type",
      "text": "\b"
    },
    {
      "op": "wait",
      "ms": 400
    },
    {
      "op": "query",
      "as": "prep-comp",
      "js": "(() => { if (window.__comp) return true; window.__comp = []; for (const type of ['compositionstart', 'compositionupdate', 'compositionend', 'input', 'focusin']) document.addEventListener(type, (e) => window.__comp.push(type + ':' + (e.data === undefined || e.data === null ? '' : e.data) + ':' + (e.target.tagName || '') + (e.target.className ? '.' + String(e.target.className).split(' ')[0] : '')), true); return true })()"
    },
    {
      "op": "ime",
      "source": "ko-2set",
      "keys": "gksrmf"
    },
    {
      "op": "wait",
      "ms": 500
    },
    {
      "op": "query",
      "as": "diag-sheets-composition",
      "js": "(window.__comp || []).join(' | ')"
    },
    {
      "op": "type",
      "text": "\n"
    },
    {
      "op": "wait",
      "ms": 500
    },
    {
      "op": "query",
      "as": "prep-goto-again",
      "js": "window.__seuofficeControl?.({cmd:'goto',target:{kind:'range',range:'A1'}}) ?? null"
    },
    {
      "op": "wait",
      "ms": 300
    },
    {
      "op": "query",
      "as": "ime-before",
      "js": "window.__seuofficeControl?.({cmd:'selection'}) ?? null"
    },
    {
      "op": "shortcut",
      "name": "save"
    },
    {
      "op": "wait",
      "ms": 2500
    },
    {
      "op": "shortcut",
      "name": "closeTab"
    },
    {
      "op": "wait",
      "ms": 1000
    },
    {
      "op": "open",
      "path": "${WORK}/sheets-ime.xlsx"
    },
    {
      "op": "waitReady",
      "timeoutMs": 60000
    },
    {
      "op": "wait",
      "ms": 1000
    },
    {
      "op": "query",
      "as": "prep-goto-reopen",
      "js": "window.__seuofficeControl?.({cmd:'goto',target:{kind:'range',range:'A1'}}) ?? null"
    },
    {
      "op": "wait",
      "ms": 300
    },
    {
      "op": "query",
      "as": "ime-after",
      "js": "window.__seuofficeControl?.({cmd:'selection'}) ?? null"
    }
  ]
}
