{
  "steps": [
    {
      "op": "open",
      "path": "${WORK}/docs.docx"
    },
    {
      "op": "waitReady",
      "timeoutMs": 60000
    },
    {
      "op": "wait",
      "ms": 800
    },
    {
      "op": "query",
      "as": "diag-docs-state",
      "js": "(() => ({ editor: (document.querySelector('.editor-scroll .ProseMirror')?.textContent ?? null), status: [...document.querySelectorAll('[class*=status], [role=status], [class*=toast], [class*=notice]')].map((e) => e.innerText).filter(Boolean).slice(0, 6), errors: window.__e2eErrors || [], title: document.title }))()"
    },
    {
      "op": "type",
      "text": "SEU-E2E-docs"
    },
    {
      "op": "wait",
      "ms": 300
    },
    {
      "op": "query",
      "as": "docs-before",
      "js": "document.querySelector('.editor-scroll .ProseMirror')?.textContent ?? null"
    },
    {
      "op": "shortcut",
      "name": "save"
    },
    {
      "op": "wait",
      "ms": 2500
    },
    {
      "op": "shortcut",
      "name": "closeTab"
    },
    {
      "op": "wait",
      "ms": 1000
    },
    {
      "op": "open",
      "path": "${WORK}/docs.docx"
    },
    {
      "op": "waitReady",
      "timeoutMs": 60000
    },
    {
      "op": "wait",
      "ms": 800
    },
    {
      "op": "query",
      "as": "docs-after",
      "js": "document.querySelector('.editor-scroll .ProseMirror')?.textContent ?? null"
    },
    {
      "op": "screenshot",
      "name": "docs-after"
    },
    {
      "op": "exportPdf",
      "path": "${WORK}/docs-export.pdf"
    }
  ]
}
