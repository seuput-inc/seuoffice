+  // Browser UI thread only. Callbacks may only revoke an existing short-lived
+  // admission gate and enqueue deferred cleanup; they must not enter a nested
+  // message loop, call application handlers, or destroy this frame tree.
+  [[nodiscard]] base::CallbackListSubscription AddCefPreNavigationRevoker(
+      base::RepeatingCallback<void(RenderFrameHostImpl*, std::vector<base::OnceClosure>*)> callback) {
+    return cef_pre_navigation_revokers_.Add(std::move(callback));
+  }
+  struct CefAdmissionMutationState {
+    size_t depth = 0;
+    std::vector<base::OnceClosure> completions;
+  };
+  static CefAdmissionMutationState& CefMutationState() {
+    static thread_local CefAdmissionMutationState state;
+    return state;
+  }
+  [[nodiscard]] static base::ScopedClosureRunner BeginCefAdmissionMutation() {
+    ++CefMutationState().depth;
+    return base::ScopedClosureRunner(base::BindOnce([] {
+      auto& state = CefMutationState();
+      CHECK_GT(state.depth, 0u);
+      if (--state.depth != 0) return;
+      auto completions = std::move(state.completions);
+      for (auto& completion : completions) {
+        std::move(completion).Run();
+      }
+    }));
+  }
+  static void DeferCefAdmissionCompletion(base::OnceClosure completion) {
+    CHECK_GT(CefMutationState().depth, 0u);
+    CefMutationState().completions.push_back(std::move(completion));
+  }
+  [[nodiscard]] base::ScopedClosureRunner RevokeCefAdmission(
+      RenderFrameHostImpl* host = nullptr) {
+    auto mutation = BeginCefAdmissionMutation();
+    std::vector<base::OnceClosure> completions;
+    cef_pre_navigation_revokers_.Notify(host, &completions);
+    for (auto& completion : completions) {
+      DeferCefAdmissionCompletion(std::move(completion));
+    }
+    return mutation;
+  }
