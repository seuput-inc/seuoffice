+fn trailing_slots(p: &Paragraph, length: usize) -> usize {
+    p.control_text_positions().iter().filter(|&&at| at >= length).count()
+        + p.field_ranges.iter().filter(|r| r.end_char_idx == length).count()
+        + p.orphan_field_ends.iter().filter(|r| r.char_idx == length).count()
+        + p.title_marks.iter().filter(|r| r.char_idx == length).count()
 }
 
