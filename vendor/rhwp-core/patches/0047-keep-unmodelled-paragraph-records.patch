+#[test]
+fn merge_of_paragraphs_binding_one_prefix_differently_keeps_names_and_one_declaration() {
+    let bytes = two_paragraphs().export_hwpx_native().unwrap();
+    let mut xml = section_xml(&bytes);
+    bind_on_paragraph(&mut xml, "first paragraph", "urn:a", "mark", "noteA");
+    bind_on_paragraph(&mut xml, "second paragraph", "urn:b", "flag", "noteB");
+    let mut core = DocumentCore::from_bytes(&with_section_xml(&bytes, &xml)).unwrap();
+
+    core.merge_paragraph_native(0, 1).unwrap();
+    let (xml, reopened) = saved(&core);
+
+    let merged = body_paragraph(&xml, 0);
+    let p_open = &merged[..merged.find('>').unwrap()];
+    assert_eq!(p_open.matches("xmlns:ext=").count(), 1, "{p_open}");
+    assert!(p_open.contains(r#"xmlns:ext="urn:a""#) && p_open.contains(r#"ext:mark="1""#));
+    // the back attribute moves to a prefix bound to its own namespace
+    assert!(p_open.contains(r#"xmlns:ext1="urn:b""#) && p_open.contains(r#"ext1:flag="1""#));
+    assert!(
+        merged.contains(r#"<ext:noteA xmlns:ext="urn:a"/>"#),
+        "{merged}"
+    );
+    assert!(
+        merged.contains(r#"<ext:noteB xmlns:ext="urn:b"/>"#),
+        "{merged}"
+    );
+    assert_eq!(body_paragraph(&saved(&reopened).0, 0), merged);
+}
