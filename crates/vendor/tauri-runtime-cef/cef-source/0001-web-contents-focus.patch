+void CefBrowserContentsDelegate::OnWebContentsLostFocus(
+    content::RenderWidgetHost* render_widget_host) {
+  if (!CEF_API_IS_ADDED(15401)) {
+    return;
+  }
+  if (auto c = client()) {
+    if (auto handler = c->GetFocusHandler()) {
+      handler->OnWebContentsLostFocus(browser());
+    }
+  }
+}
