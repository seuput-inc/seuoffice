+TEST_P(ApprovedHistoryCacheTest, BindsTheActualCacheRequestAndRetainedDocument) {
+  ASSERT_TRUE(IsBackForwardCacheEnabled());
+  NavigationSimulator::NavigateAndCommitFromBrowser(
+      contents(), GURL("https://first.example/page"));
