+void CefBrowserContentsDelegate::ApplyBackgroundThrottling(
+    content::RenderFrameHost* frame) {
+#if CEF_API_ADDED(15401)
+  auto browser = browser_info_->browser();
+  if (!browser || !frame ||
+      browser->settings().background_throttling != STATE_DISABLED) {
+    return;
+  }
+  frame->GetRenderViewHost()->SetSchedulerThrottling(false);
+  auto* view = frame->GetView();
+  if (!view)
+    return;
+  auto* widget = content::RenderWidgetHostImpl::From(view->GetRenderWidgetHost());
+  if (widget) {
+    widget->disable_hidden_ = true;
+    if (widget->IsHidden()) {
+      auto* view_base = static_cast<content::RenderWidgetHostViewBase*>(view);
+      if (view_base->IsRenderWidgetHostViewChildFrame())
+        widget->WasShown({});
+      else
+        view_base->ShowWithVisibility(
+            content::PageVisibilityState::kHiddenButPainting);
+    }
+  }
+#endif
+}
