diff --git a/libcef/browser/native_observed_document.h b/libcef/browser/native_observed_document.h
--- /dev/null
+++ b/libcef/browser/native_observed_document.h
@@ -0,0 +1,110 @@
+// Copyright 2026 The Chromium Embedded Framework Authors.
+// Use of this source code is governed by a BSD-style license.
+#ifndef CEF_LIBCEF_BROWSER_NATIVE_OBSERVED_DOCUMENT_H_
+#define CEF_LIBCEF_BROWSER_NATIVE_OBSERVED_DOCUMENT_H_
+
+#include <limits>
+#include <map>
+#include <utility>
+#include <vector>
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+#include "cef/include/cef_client.h"
+#include "cef/libcef/browser/thread_util.h"
+#include "content/browser/renderer_host/frame_tree_node.h"
+#include "content/browser/renderer_host/render_frame_host_impl.h"
+
+class CefNativeObservedDocumentImpl final : public CefNativeObservedDocument {
+ public:
+  static CefRefPtr<CefNativeObservedDocumentImpl> Create(
+      content::RenderFrameHostImpl* host, const blink::DocumentToken& document,
+      CefRefPtr<CefNativeRendererProcess> process) {
+    CEF_REQUIRE_UIT_RETURN(nullptr);
+    if (!host || host->GetParent() || !process ||
+        !host->MatchesLatestDocumentForCef(document) || !host->frame_tree_node())
+      return nullptr;
+    auto& live = LiveReceipts();
+    static uint64_t next_id = 0;
+    if (live.size() >= 4096 || next_id == std::numeric_limits<uint64_t>::max())
+      return nullptr;
+    auto result = CefRefPtr<CefNativeObservedDocumentImpl>(
+        new CefNativeObservedDocumentImpl(++next_id, host->GetGlobalId(), std::move(process)));
+    live.emplace(next_id, result);
+    auto* node = host->frame_tree_node();
+    result->process_loss_ = node->AddCefPreProcessLossObserver(base::BindRepeating(
+        &CefNativeObservedDocumentImpl::BeforeProcessLoss, base::Unretained(result.get())));
+    result->document_loss_ = node->AddCefPreNavigationRevoker(base::BindRepeating(
+        &CefNativeObservedDocumentImpl::BeforeDocumentLoss, base::Unretained(result.get())));
+    return result;
+  }
+
+  CefRefPtr<CefNativeRendererProcess> GetProcess() override { return process_; }
+
+  bool ObserveLoss(CefRefPtr<CefNativeObservedDocumentCallback> callback) override {
+    if (!callback) return false;
+    int reason;
+    {
+      base::AutoLock lock(lock_);
+      reason = reason_;
+      if (!reason) {
+        if (callbacks_.size() >= 1024) return false;
+        callbacks_.push_back(std::move(callback));
+        return true;
+      }
+    }
+    return CEF_TASK_RUNNER<CEF_UIT>()->PostTask(FROM_HERE, base::BindOnce(
+        [](CefRefPtr<CefNativeObservedDocumentCallback> callback, int reason) {
+          callback->OnLost(reason);
+        }, std::move(callback), reason));
+  }
+
+ private:
+  CefNativeObservedDocumentImpl(uint64_t id, content::GlobalRenderFrameHostId frame,
+                                CefRefPtr<CefNativeRendererProcess> process)
+      : id_(id), frame_(frame), process_(std::move(process)) {}
+  ~CefNativeObservedDocumentImpl() override = default;
+
+  static std::map<uint64_t, CefRefPtr<CefNativeObservedDocumentImpl>>& LiveReceipts() {
+    static base::NoDestructor<std::map<uint64_t, CefRefPtr<CefNativeObservedDocumentImpl>>> live;
+    return *live;
+  }
+
+  void BeforeProcessLoss(content::RenderFrameHostImpl* host,
+                         std::vector<base::OnceClosure>* completions) {
+    if (host && host->GetGlobalId() == frame_) Claim(2, completions);
+  }
+  void BeforeDocumentLoss(content::RenderFrameHostImpl* host,
+                          std::vector<base::OnceClosure>* completions) {
+    if (!host || host->GetGlobalId() == frame_) Claim(1, completions);
+  }
+  void Claim(int reason, std::vector<base::OnceClosure>* completions) {
+    std::vector<CefRefPtr<CefNativeObservedDocumentCallback>> callbacks;
+    {
+      base::AutoLock lock(lock_);
+      if (reason_) return;
+      reason_ = reason;
+      callbacks.swap(callbacks_);
+    }
+    CefRefPtr<CefNativeObservedDocumentImpl> keep_alive(this);
+    completions->push_back(base::BindOnce(
+        [](CefRefPtr<CefNativeObservedDocumentImpl> self,
+           std::vector<CefRefPtr<CefNativeObservedDocumentCallback>> callbacks, int reason) {
+          self->process_loss_ = {};
+          self->document_loss_ = {};
+          LiveReceipts().erase(self->id_);
+          for (auto& callback : callbacks) callback->OnLost(reason);
+        }, std::move(keep_alive), std::move(callbacks), reason));
+  }
+
+  const uint64_t id_;
+  const content::GlobalRenderFrameHostId frame_;
+  CefRefPtr<CefNativeRendererProcess> process_;
+  base::CallbackListSubscription process_loss_;
+  base::CallbackListSubscription document_loss_;
+  base::Lock lock_;
+  int reason_ = 0;
+  std::vector<CefRefPtr<CefNativeObservedDocumentCallback>> callbacks_;
+  IMPLEMENT_REFCOUNTING(CefNativeObservedDocumentImpl);
+};
+#endif  // CEF_LIBCEF_BROWSER_NATIVE_OBSERVED_DOCUMENT_H_
