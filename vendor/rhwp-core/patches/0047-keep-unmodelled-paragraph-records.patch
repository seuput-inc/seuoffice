+/// HWP5 records under a paragraph that the parser does not model: a child with an unknown
+/// tag and any records nested under it. The serializer writes them back unchanged after
+/// the modelled child they followed in the file, so an edit elsewhere keeps them. They
+/// belong to the paragraph: deleting it drops them, splitting it leaves them in the front
+/// part (the one keeping the paragraph's instance id), merging carries the back part's
+/// records into the merged paragraph after the front part's own.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct UnknownRecord {
+    pub after: RecordAnchor,
+    /// Levels below the paragraph header (1 = direct child): the record keeps its place
+    /// when the paragraph is written at another depth.
+    pub depth: u16,
+    pub tag_id: u16,
+    pub data: Vec<u8>,
+}
+
+/// The modelled paragraph child an [`UnknownRecord`] follows.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+pub enum RecordAnchor {
+    /// Right after PARA_HEADER, before any other child.
+    Header,
+    /// After the PARA_TEXT, PARA_CHAR_SHAPE, PARA_LINE_SEG or PARA_RANGE_TAG step, whether
+    /// or not that record is written this time.
+    Record(u16),
+    /// After control `n` and its records. Past the paragraph's last control (an edit
+    /// removed some), at the end of the paragraph.
+    Control(usize),
+}
+
+/// HWPX markup of a paragraph in namespaces the HWPX writer does not declare (another
+/// tool's extension), kept verbatim. The same ownership rule as [`UnknownRecord`] applies;
+/// on a merge the front paragraph's attributes win over the back one's with the same
+/// expanded name. Elements keep their parent kind but not their place among the runs: the
+/// ones under `<hp:run>` are written in one run after the paragraph's text, the ones under
+/// `<hp:p>` after the runs.
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize)]
+pub struct ForeignXml {
+    /// `(prefix, uri)` declarations of the attributes' prefixes, written on `<hp:p>`; one
+    /// binding per prefix.
+    pub namespaces: Vec<(String, String)>,
+    /// Attributes of `<hp:p>` the parser does not read: name and value as in the source.
+    pub attributes: Vec<(String, String)>,
+    /// Elements directly under `<hp:p>`, each declaring the foreign prefixes it uses.
+    pub p_children: Vec<String>,
+    /// Elements under `<hp:run>`, each declaring the foreign prefixes it uses.
+    pub run_children: Vec<String>,
+}
+
+impl ForeignXml {
+    fn binding(&self, prefix: &str) -> Option<&str> {
+        self.namespaces
+            .iter()
+            .find(|(p, _)| p == prefix)
+            .map(|(_, uri)| uri.as_str())
+    }
+
+    /// Namespace and local name of an attribute name.
+    fn expanded<'a>(&'a self, name: &'a str) -> (Option<&'a str>, &'a str) {
+        match name.split_once(':') {
+            Some((prefix, local)) => (self.binding(prefix), local),
+            None => (None, name),
+        }
+    }
+
+    /// Takes in the back paragraph's markup on a merge. A back attribute whose prefix the
+    /// front binds to another namespace is renamed to a prefix bound to its own namespace, so
+    /// `<hp:p>` never declares one prefix twice and no attribute changes its expanded name.
+    pub fn absorb(&mut self, back: &ForeignXml) {
+        for (name, value) in &back.attributes {
+            let name = match name.split_once(':') {
+                None => name.clone(),
+                Some((prefix, local)) => {
+                    let Some(uri) = back.binding(prefix) else {
+                        continue;
+                    };
+                    let prefix = match self.namespaces.iter().find(|(_, u)| u == uri) {
+                        Some((p, _)) => p.clone(),
+                        None => {
+                            let mut fresh = prefix.to_string();
+                            let mut n = 1;
+                            while self.binding(&fresh).is_some() {
+                                fresh = format!("{prefix}{n}");
+                                n += 1;
+                            }
+                            self.namespaces.push((fresh.clone(), uri.to_string()));
+                            fresh
+                        }
+                    };
+                    format!("{prefix}:{local}")
+                }
+            };
+            let taken = self
+                .attributes
+                .iter()
+                .any(|(own, _)| self.expanded(own) == self.expanded(&name));
+            if !taken {
+                self.attributes.push((name, value.clone()));
+            }
+        }
+        self.p_children.extend(back.p_children.iter().cloned());
+        self.run_children.extend(back.run_children.iter().cloned());
+    }
+}
